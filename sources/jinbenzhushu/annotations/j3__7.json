     "译": [
      "西伯在毕整训军队，得到吕尚，任命他为太师。"
     ],
     "注": [
      "治兵：整治军队",
      "吕尚：即姜太公",
      "师：太师"
     ]
    },
    {
     "译": [
      "第三十二年。"
     ],
     "注": []
    },
    {
     "译": [
      "五星聚集在房宿。",
      "有红色的乌鸦聚集在周的社坛。",
      "密人侵犯阮，西伯率军讨伐密。"
     ],
     "注": [
      "五星：金、木、水、火、土五星",
      "房：二十八宿中的房宿",
      "赤乌：红色乌鸦，被视为祥瑞",
      "密：古国名，一说在今甘肃灵台一带"
     ]
    },
    {
     "译": [
      "第三十三年。"
     ],
     "注": []
    },
    {
     "译": [
      "密人向周师投降，周于是迁都到程。",
      "王赐命西伯，使他得以专擅征伐。"
     ],
     "注": [
      "锡命：赐以爵命"
     ]
    },
    {
     "译": [
      "文王受命的第九年，统一天下的大业尚未完成，大概是得到专擅征伐之权后，受命就从这一年算起。"
     ],
     "注": [
      "大统：天下一统的大业"
     ]
    },
    {
     "译": [
      "第三十四年。"
     ],
     "注": []
    },
    {
     "译": [
      "周师夺取耆和邘，于是讨伐崇，崇人投降。",
      "冬十二月，昆夷侵犯周。"
     ],
     "注": [
      "耆：即黎国，在今山西长治一带",
      "崇：古国名，一说在今陕西西安沣河西"
     ]
    },
    {
     "译": [
      "第三十五年。"
     ],
     "注": []
    },
    {
     "译": [
      "周发生大饥荒。",
      "西伯从程迁到丰。"
     ],
     "注": [
      "丰：周都邑，在今陕西西安西南的沣河西岸"
     ]
    },
    {
     "译": [
      "第三十六年。"
     ],
     "注": []
    },
    {
     "译": [
      "春正月，诸侯朝见周，周于是讨伐昆夷。",
      "西伯派太子发营建镐。"
     ],
     "注": [
      "世子发：即后来的周武王",
      "镐：周都邑，在今西安西南的沣河东岸"
     ]
    },
    {
     "译": [
      "第三十七年。"
     ],
     "注": []
    },
    {
     "译": [
      "周人建造辟雍。"
     ],
     "注": [
      "辟雍：周天子设立的学宫，四周环水"
     ]
    },
    {
     "译": [
      "第三十九年。"
     ],
     "注": []
    },
    {
     "译": [
      "大夫辛甲出逃投奔周。"
     ],
     "注": [
      "辛甲：殷大夫，奔周后任太史"
     ]
    },
    {
     "译": [
      "第四十年。"
     ],
     "注": []
    },
    {
     "译": [
      "周人建造灵台。",
      "王派胶鬲向周索求玉。"
     ],
     "注": [
      "灵台：周文王所建的台，用于观天象、游赏",
      "胶鬲：殷臣，一说原以贩鱼盐为生"
     ]
    },
    {
     "译": [
      "第四十一年。"
     ],
     "注": []
    },
    {
     "译": [
      "春三月，西伯昌去世。"
     ],
     "注": [
      "昌：即姬昌，周文王"
     ]
    },
    {
     "译": [
      "第四十二年。"
     ],
     "注": []
    },
    {
     "译": [
      "西伯发从吕尚那里接受了丹书。",
      "有女子变成了男子。"
     ],
     "注": [
      "丹书：以红字书写的文书，传为吕尚授武王的戒书",
      "化为丈夫：性别转变，视为怪异之兆"
     ]
    },
    {
     "译": [
      "第四十三年。"
     ],
     "注": []
    },
    {
     "译": [
      "春天，举行大阅兵。",
      "峣山崩塌。"
     ],
     "注": [
      "大阅：大规模检阅军队",
      "峣山：山名，具体所在不详"
     ]
    },
    {
     "译": [
      "第四十四年。"
     ],
     "注": []
    },
    {
     "译": [
      "西伯发讨伐黎。"
     ],
     "注": []
    },
    {
     "译": [
      "第四十七年。"
     ],
     "注": []
    },
    {
     "译": [
      "内史向挚出逃投奔周。"
     ],
     "注": [
      "内史：掌管文书典册的官",
      "向挚：殷内史，见殷政混乱而奔周"
     ]
    },
    {
     "译": [
      "第四十八年。"
     ],
     "注": []
    },
    {
     "译": [
      "出现了夷羊。"
     ],
     "注": [
      "夷羊：传说中的怪兽，具体形貌不详"
     ]
    },
    {
     "译": [
      "第五十一年。"
     ],
     "注": []
    },
    {
     "译": [
      "冬十一月戊子，周师渡过盟津后回师。",
      "王囚禁箕子，杀死王子比干，微子出逃。"
     ],
     "注": [
      "盟津：即孟津，在今河南孟津一带",
      "箕子：纣王的叔父，被囚后入周",
      "比干：纣王的叔父，被杀",
      "微子：纣王的庶兄，出奔"
     ]
    },
    {
     "译": [
      "第五十二年。"
     ],
     "注": []
    },
    {
     "译": [
      "庚寅日，周开始讨伐殷。",
      "秋天，周师驻扎在鲜原。",
      "冬十二月，周师祭祀上帝。",
      "庸、蜀、羌、髳、微、卢、彭、濮等国跟随周师讨伐殷。"
     ],
     "注": [
      "鲜原：地名，具体所在不详",
      "有事于上帝：举行祭祀上帝的大礼",
      "庸：古国名，在今湖北竹山一带",
      "蜀：古国名，在今四川一带"
     ]
    },
    {
     "译": [
      "从汤灭夏到受，共二十九位王，历时四百九十六年。"
     ],
     "注": [
      "受：即帝辛"
     ]
    }
   ]
  }
 ]
}