 "items": [
  {
   "题解": "本节记平王在位五十一年的事：东迁洛邑后开始以晋国为纪事主线，兼记秦、郑、鲁、宋等国大事及晋国曲沃与翼的分裂。",
   "段落": [
    {
     "译": [
      "自平王东迁以后才开始记载晋国之事，各王即位都不再记载。"
     ],
     "注": [
      "东迁：平王迁都洛邑。"
     ]
    },
    {
     "译": [
      "元年"
     ],
     "注": []
    },
    {
     "译": [
      "辛未年，平王向东迁到洛邑。",
      "赐晋文侯册命。",
      "晋侯会同卫侯、郑伯、秦伯，率领军队随平王进入成周。"
     ],
     "注": [
      "洛邑：今河南洛阳一带。",
      "成周：洛邑东面的城邑，在今河南洛阳东。"
     ]
    },
    {
     "译": [
      "二年"
     ],
     "注": []
    },
    {
     "译": [
      "秦国设立西畤。",
      "鲁孝公去世。",
      "赐给秦、晋邠、岐一带的土地。"
     ],
     "注": [
      "西畤：秦国祭天的祭坛，相传在今甘肃礼县一带。",
      "邠：今陕西彬州一带。",
      "岐：今陕西岐山一带。"
     ]
    },
    {
     "译": [
      "三年"
     ],
     "注": []
    },
    {
     "译": [
      "齐人灭了祝国。",
      "平王赐司徒郑伯册命。"
     ],
     "注": [
      "祝：古国名，一般认为在今山东境内。"
     ]
    },
    {
     "译": [
      "四年"
     ],
     "注": []
    },
    {
     "译": [
      "燕倾侯去世。",
      "郑人灭了虢国。"
     ],
     "注": [
      "郑人灭虢：此虢当指东虢，一般认为在今河南荥阳一带。"
     ]
    },
    {
     "译": [
      "五年"
     ],
     "注": []
    },
    {
     "译": [
      "秦襄公率军伐戎，死在军中。",
      "宋戴公去世。"
     ],
     "注": []
    },
    {
     "译": [
      "六年"
     ],
     "注": []
    },
    {
     "译": [
      "燕哀侯去世。",
      "郑国迁到溱水、洧水一带。"
     ],
     "注": [
      "溱、洧：两条河，在今河南新郑一带。"
     ]
    },
    {
     "译": [
      "七年"
     ],
     "注": []
    },
    {
     "译": [
      "楚国国君仪去世。"
     ],
     "注": [
      "楚子仪：即楚君熊仪，号若敖。"
     ]
    },
    {
     "译": [
      "八年"
     ],
     "注": []
    },
    {
     "译": [
      "郑国杀了大夫关其思。"
     ],
     "注": []
    },
    {
     "译": [
      "十年"
     ],
     "注": []
    },
    {
     "译": [
      "秦迁回汧水、渭水之间。"
     ],
     "注": [
      "汧、渭：汧水与渭水，在今陕西西部。"
     ]
    },
    {
     "译": [
      "十三年"
     ],
     "注": []
    },
    {
     "译": [
      "魏武公去世。"
     ],
     "注": [
      "魏：古国名，在今山西芮城一带。"
     ]
    },
    {
     "译": [
      "十四年"
     ],
     "注": []
    },
    {
     "译": [
      "晋人灭了韩国。"
     ],
     "注": [
      "韩：古国名，具体位置有争议。"
     ]
    },
    {
     "译": [
      "十八年"
     ],
     "注": []
    },
    {
     "译": [
      "秦文公在岐大败戎军，把岐山以东的土地献归周王。"
     ],
     "注": [
      "秦文公：秦国国君。"
     ]
    },
    {
     "译": [
      "二十一年"
     ],
     "注": []
    },
    {
     "译": [
      "晋文侯在携杀了王子余臣。"
     ],
     "注": [
      "王子余臣：即携王，幽王死后被虢公翰所立。",
      "携：地名，具体不详。"
     ]
    },
    {
     "译": [
      "二十三年"
     ],
     "注": []
    },
    {
     "译": [
      "宋武公去世。"
     ],
     "注": []
    },
    {
     "译": [
      "二十四年"
     ],
     "注": []
    },
    {
     "译": [
      "秦国建立陈宝祠。"
     ],
     "注": [
      "陈宝祠：祭祀陈宝神石的祠庙，相传在今陕西宝鸡陈仓一带。"
     ]
    },
    {
     "译": [
      "二十五年"
     ],
     "注": []
    },
    {
     "译": [
      "晋文侯去世。",
      "秦国开始使用灭族之刑。"
     ],
     "注": [
      "族刑：一人犯罪，牵连全族的刑罚。"
     ]
    },
    {
     "译": [
      "二十六年"
     ],
     "注": []
    },
    {
     "译": [
      "晋国把弟弟成师封在曲沃。"
     ],
     "注": [
      "曲沃：今山西闻喜、曲沃一带。",
      "成师：晋文侯之弟，即曲沃桓叔。"
     ]
    },
    {
     "译": [
      "三十二年"
     ],
     "注": []
    },
    {
     "译": [
      "晋国潘父杀了国君昭侯，迎纳成师，没有成功。",
      "晋人立昭侯的儿子孝侯，杀了潘父。"
     ],
     "注": [
      "潘父：晋国大臣，生平不详。",
      "昭侯：晋国国君。"
     ]
    },
    {
     "译": [
      "三十三年"
     ],
     "注": []
    },
    {
     "译": [
      "楚人侵犯申国。"
     ],
     "注": []
    },
    {
     "译": [
      "三十六年"
     ],
     "注": []
    },
    {
     "译": [
      "卫庄公去世。",
      "王室派人戍守申国。"
     ],
     "注": [
      "戍：驻军守卫。"
     ]
    },
    {
     "译": [
      "四十年"
     ],
     "注": []
    },
    {
     "译": [
      "齐庄公去世。",
      "晋国曲沃桓叔成师去世，儿子鱓即位，就是庄伯。"
     ],
     "注": [
      "曲沃桓叔：成师的称号。",
      "庄伯：曲沃庄伯，名鱓。"
     ]
    },
    {
     "译": [
      "四十一年"
     ],
     "注": []
    },
    {
     "译": [
      "春天，下大雪。"
     ],
     "注": []
    },
    {
     "译": [
      "四十二年"
     ],
     "注": []
    },
    {
     "译": [
      "狄人攻打翼，打到晋国郊外。",
      "宋襄公去世。",
      "鲁惠公派宰让请求举行郊祭和宗庙之礼，平王派史角前往鲁国劝止。"
     ],
     "注": [
      "翼：晋国都城，在今山西翼城一带。",
      "郊庙之礼：祭天与祭宗庙的礼仪，本为天子所用。",
      "史角：周王室的史官。"
     ]
    },
    {
     "译": [
      "四十七年"
     ],
     "注": []
    },
    {
     "译": [
      "晋国曲沃庄伯攻入翼，杀了孝侯，晋人把他赶走，立孝侯的儿子郤，就是鄂侯。"
     ],
     "注": [
      "鄂侯：晋国国君，名郤。"
     ]
    },
    {
     "译": [
      "四十八年"
     ],
     "注": []
    },
    {
     "译": [
      "无云却打雷。",
      "鲁惠公去世。"
     ],
     "注": []
    },
    {
     "译": [
      "四十九年"
     ],
     "注": []
    },
    {
     "译": [
      "鲁隐公与邾庄公在姑蔑会盟。"
     ],
     "注": [
      "邾：鲁国附近的小国，在今山东邹城一带。",
      "姑蔑：地名，一般认为在今山东泗水一带。"
     ]
    },
    {
     "译": [
      "五十一年"
     ],
     "注": []
    },
    {
     "译": [
      "春二月乙巳日，发生日食。",
      "三月庚戌日，平王去世。"
     ],
     "注": [
      "日有食之：日食，通常认为与《春秋》所记隐公三年的日食相合（公元前720年）。"
     ]
    }
   ]
  },
  {
   "题解": "本节记桓王在位二十三年的事，主要是晋国曲沃与翼之间长期攻战，哀侯被俘、小子侯被杀、翼被灭。",
   "段落": [
    {
     "译": [
      "元年"
     ],
     "注": []
    },
    {
     "译": [
      "壬戌年十月，庄伯凭借曲沃反叛，攻打翼，公子万救援翼，荀叔轸追击庄伯，追到家谷。",
      "翼侯烧了曲沃的庄稼后返回。",
      "翼侯攻打曲沃，大胜，曲沃武公向翼求和，军队到相地就返回了。"
     ],
     "注": [
      "公子万：晋国公子，翼一方的将领。",
      "荀叔轸：晋国大夫，名轸。",
      "家谷：地名，具体不详。",
      "相：地名，具体不详。"
     ]
    },
    {
     "译": [
      "二年"
     ],
     "注": []
    },
    {
     "译": [
      "桓王派虢公攻打晋国的曲沃。",
      "晋鄂侯去世，曲沃庄伯再次攻晋，立鄂侯的儿子光为君，就是哀侯。",
      "公子万救援翼，荀叔轸追击，追到家谷。"
     ],
     "注": []
    },
    {
     "译": [
      "三年"
     ],
     "注": []
    },
    {
     "译": [
      "甲子年。"
     ],
     "注": []
    },
    {
     "译": [
      "四年"
     ],
     "注": []
    },
    {
     "译": [
