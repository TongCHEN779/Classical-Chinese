     ],
     "注": [
      "虢仲：虢国国君。"
     ]
    },
    {
     "译": [
      "十五年"
     ],
     "注": []
    },
    {
     "译": [
      "十六年"
     ],
     "注": []
    },
    {
     "译": [
      "春天，翼被灭。"
     ],
     "注": []
    },
    {
     "译": [
      "十九年"
     ],
     "注": []
    },
    {
     "译": [
      "郑庄公去世。"
     ],
     "注": []
    },
    {
     "译": [
      "二十三年"
     ],
     "注": []
    },
    {
     "译": [
