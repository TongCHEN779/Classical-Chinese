 "items": [
  {
   "题解": "李实夫在大兴里与诸十全结识并听说她的苦衷，留下银元；李鹤汀与杨媛媛、赵桂林挖花，晚赴卫霞仙家宴，朱蔼人的管家张寿抢去请洪善卿的票头。",
   "段落": [
    {
     "译": [],
     "注": [
      "月白竹布衫：浅蓝色竹布长衫。",
      "玄色绉心缎镶马甲：黑色绉心缎镶边的背心。绉心缎，一种织物。",
      "老娘姨：年长的娘姨，女仆。",
      "堂倌：茶馆烟馆的伙计。",
      "陈个：吴语，姓陈的那个（客人）。",
      "前轩：前面的廊轩。",
      "野鸡：街头拉客的下等妓女。",
      "搭讪：搭话。"
     ]
    },
    {
     "译": [],
     "注": [
      "人家人：吴语，良家妇女，这里指不是堂子里出身而是私下做生意的。",
      "诸十全：这位年轻的“野鸡”，实为良家出身。",
      "中意：满意。",
      "豁脱：丢掉，舍得花。"
     ]
    },
    {
     "译": [],
     "注": [
      "揣度：揣摩。",
      "尊姓：对人姓氏的敬称。",
      "一淘：吴语，一起。",
      "大兴里：四马路上的里弄名，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "长三书寓：高等妓院，此指诸家冒充长三书寓。",
      "话靶戏：吴语，笑话、出丑之事。靶，应作“把”。",
      "挈：带领，拉。"
     ]
    },
    {
     "译": [],
     "注": [
      "烟票：烟馆开的账单、取烟凭据。",
      "石库门：以石料作门框的上海里弄房屋大门。",
      "高爽：高大敞亮。"
     ]
    },
    {
     "译": [],
     "注": [
      "瓜子：茶会上敬客的零食。",
      "烟灯：吸鸦片用的灯。",
      "装烟：替客人装烟泡。",
      "无娒：吴语，妈妈，指诸三姐。",
      "诸三姐：诸十全的母亲。"
     ]
    },
    {
     "译": [],
     "注": [
      "洋灯：煤油灯。",
      "栈房：客栈。",
      "聚丰园：上海的酒楼名，菜馆。",
      "小碗：小份的菜碗。",
      "模块洋钱：摸出一块银元。"
     ]
    },
    {
     "译": [],
     "注": [
      "荤碟：荤菜的小碟。",
      "筛：斟（酒）。"
     ]
    },
    {
     "译": [],
     "注": [
      "窃听：偷听。",
      "干了：喝干。",
      "明朝会：明天见。"
     ]
    },
    {
     "译": [],
     "注": [
