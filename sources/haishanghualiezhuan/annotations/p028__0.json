 "items": [
  {
   "题解": "第二十七回：姚季莼被巡捕房关押后，在卫霞仙处与其斗口；匡二去潘三家遇徐茂荣闯入，次日循迹找到李实夫所包的诸十全家，李鹤汀亦撞破叔父之事，随即赴王莲生之局。",
   "段落": [
    {
     "译": [],
     "注": [
      "帐房：即账房，商号或大户理财记账之处。",
      "墩起一壶绍兴酒：墩，把酒壶放入热水中温热；绍兴酒是浙江绍兴所产黄酒。",
      "盛撰：丰盛的饭菜，“撰”同“馔”。",
      "代禀：代为向主人通报。"
     ]
    },
    {
     "译": [],
     "注": [
      "撩下：随手丢下。",
      "轿班：专为主人抬轿的轿夫。",
      "坐马车：当时上海的时尚游乐，乘马车到静安寺路一带兜风。"
     ]
    },
    {
     "译": [],
     "注": [
      "兀坐：呆坐。",
      "姚季莼：书中人物，其妻姚奶奶曾到卫霞仙处吵闹。",
      "巡捕房：租界内的警察机构。",
      "肩随：并肩同行，略后于尊者；此处泛指并行。",
      "打个茶会：见前，指到倌人房里小坐吃茶。"
     ]
    },
    {
     "译": [],
     "注": [
      "家主婆：吴语，妻子。",
      "邱话：待考，似指难听的话、坏话。",
      "竖起仔个面孔：板起脸。",
      "吴淞：上海北郊地名，在黄浦江入长江处。",
      "奶奶：对富贵人家妻子的称呼。",
      "啥场花：吴语，什么地方、什么场所。",
      "一径：吴语，一向。"
     ]
    },
    {
     "译": [],
     "注": [
      "同过几转台面：同席吃过几次酒。"
     ]
    },
    {
     "译": [],
     "注": [
      "尤如意：公阳里的长三倌人，周少和请客设赌局之处。",
      "赌局：以赌博为主的聚会，常借吃酒为名。",
      "白相：吴语，玩耍、游乐。"
     ]
    },
    {
     "译": [],
     "注": [
      "长安栈：即长安客栈，李鹤汀一行在石路的住处。",
      "兽环：门上兽头衔着的铁环，用以叩门。"
     ]
    },
    {
     "译": [],
     "注": [
      "老底子：吴语，从前、原来。",
      "勿局个：待考，据文意似为“没关系”。",
      "烟盘：放烟具的托盘。"
     ]
    },
    {
     "译": [],
     "注": [
      "黑魆魆：很黑的样子。",
      "高椅：高背椅。",
      "倾盆大吐：形容呕吐很多。"
     ]
    },
    {
     "译": [],
     "注": [
      "撒酒风：发酒疯。",
      "姘仔戏子：与戏子私通。",
      "挨得著：轮得到。",
      "做好做歹：时而劝说时而数落，从中调解。",
      "装一筒：把烟膏装进烟枪烧一筒。"
     ]
    },
    {
     "译": [],
     "注": [
      "踮手踮脚：轻手轻脚。",
      "小姐：此指妓女，是旧时对倌人的称呼。"
     ]
    },
    {
     "译": [],
     "注": [
      "京片：待考，疑为名片或帖子。",
      "栈使：客栈的伙计。",
      "燕尔新欢：指新近结交的相好。",
      "冤家：此指碍事的人。",
      "拓了个便宜货：占到了便宜。",
      "得趣：得到乐趣。"
     ]
    },
    {
     "译": [],
     "注": [
      "打辫：梳辫子，清代男子的发式。",
      "相度：察看，估量。",
      "石库门：见前。",
      "老婆子：年纪大的妇女。"
     ]
    },
    {
     "译": [],
     "注": [
      "诸三姐：诸十全的养母，书中人物。",
      "早瘾：早晨的鸦片烟瘾。",
      "耳光：巴掌。"
     ]
    },
    {
     "译": [],
     "注": [
      "客堂：正厅，会客之所。",
      "便茶：寻常的茶。",
      "空场面：虚架子，排场。",
      "吃醋：吴语，嫉妒。",
      "娘囡仵：母女们。",
      "倘忙：吴语，倘若。"
     ]
    },
    {
     "译": [],
     "注": []
    },
    {
     "译": [],
     "注": [
      "忌口：因病或信佛等而戒食荤腥。",
      "馆菜：从饭馆叫来的菜。",
      "素撰：素菜。"
     ]
    },
    {
     "译": [],
     "注": [
      "花雨楼：烟馆（兼茶楼）名，在上海四马路一带，待考。",
      "开灯：点烟灯吸鸦片。",
      "撑堂：座无虚席。",
      "郭孝婆：书中人物，常为妓院拉皮条，下文说她诱拐良家女子。"
     ]
    },
    {
     "译": [],
     "注": [
      "杀胚：吴语骂人话，坏透了的东西。",
      "夷场：旧时上海称外国租界。",
      "拐逃：诱拐出逃。",
      "二百藤条：用藤条责打二百下。",
      "长监：长期监禁。",
      "稔恶：积恶、恶贯满盈。"
     ]
    },
    {
     "译": [],
     "注": [
      "匣中烟尽：烟匣里的烟膏吸完。"
     ]
    },
    {
     "译": [],
     "注": [
      "五日再宿：每五日过夜一次。",
      "旬日：十天。"
     ]
    },
    {
     "译": [],
     "注": [
      "意旨：心意、主意。",
      "叔侄：李实夫与李鹤汀。"
     ]
    },
    {
     "译": [],
     "注": [
      "盖碗茶：带盖的茶碗所泡的茶。",
      "玻璃高脚盆子：玻璃的高脚盘。",
      "归帐路头：旧时上海妓院于端午、中秋、年底三节结账，称归账。"
     ]
    },
    {
     "译": [],
     "注": [
      "铜钱：旧时的方孔铜币。",
      "纸烟：纸卷的香烟。"
     ]
    },
    {
     "译": [],
     "注": [
      "上灯：见前。"
     ]
    },
    {
     "译": [],
     "注": [
      "便夜饭：普通的晚饭。",
      "起手巾：宴席开始时，由人递热手巾给客人擦脸。"
     ]
    }
   ]
  }
 ]
