      "挤紧眼睛：眯着眼。",
      "单挡：单身一人。",
      "拉皮条：替人介绍嫖妓。",
      "水铫子：烧水用的小水壶。"
     ]
    },
    {
     "译": [],
     "注": [
      "象牙烟盒：存放烟膏的象牙盒。",
      "收枪：收起烟枪，意为不再吸烟。",
      "写票：写取烟的票据，算账。",
      "面水：洗脸水。"
     ]
    },
    {
     "译": [],
     "注": [
      "耸身卓立：挺身站立。",
      "款款：缓缓的样子。",
      "兀的：怎的，感叹词。",
      "魂灵勾住：吸引住了魂魄。"
     ]
    }
   ]
  }
 ]
}