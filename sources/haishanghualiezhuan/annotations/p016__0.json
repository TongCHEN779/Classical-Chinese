{
 "start": 0,
 "items": [
  {
   "题解": "黎篆鸿在蒋月琴家吃局，调笑屠明珠，蒋月琴谈罗子富与黄翠凤；李实夫在花雨楼遇到野鸡诸十全，随之到大兴里。",
   "段落": [
    {
     "译": [],
     "注": [
      "吃酒：赴酒席，在妓院请客宴饮。",
      "老相好：长期相熟的倌人。",
      "东公和里：上海四马路北的里弄名，有妓院。",
      "匡二：李鹤汀的跟班。",
      "通报：向主人传报来客。",
      "大姐：妓院里伺候倌人的年轻女仆。",
      "打起帘子：掀起门帘。",
      "帮闲门客：依附富贵人家、陪着游乐消遣的人。",
      "嫡堂叔父：同祖的叔叔。",
      "厮见：相见。",
      "总办公馆：负责某项官办事务的总办官员的公馆。",
      "三家头：吴语，三个人。",
      "来哚：吴语，在，正在。"
     ]
    },
    {
     "译": [],
     "注": [
      "摆台面：摆设酒席。",
      "起手巾：酒席上递手巾擦手，待考。",
      "局票：叫局的票子。",
      "助兴：凑趣捧场。",
      "入席：入座。"
     ]
    },
    {
     "译": [],
     "注": [
      "相让：互相谦让入座。",
      "几花：吴语，多少。",
      "荒荒唐唐：胡闹，不像话。",
      "老白相：吴语，老玩家、老嫖客。白相，游玩，也指嫖。",
      "无志气：没出息。",
      "勿会白相末白相小：吴语，不会玩的才玩年轻的。"
     ]
    },
    {
     "译": [],
     "注": [
      "笔砚：写局票用的笔墨。",
      "屠明珠：红极一时的老倌人，年纪已大。",
      "光景：看样子，大概。",
      "保箱子：保险箱，存放钱财的箱子。",
      "坍坍俚台：吴语，拆他的台，使他丢脸。",
      "孙素兰：长三堂子的倌人。"
     ]
    },
    {
     "译": [],
     "注": [
      "双台：两张方桌拼摆的酒席。",
      "靠台面：靠近酒席而坐。",
      "娘姨：妓院中的女佣。",
      "密密层层：形容拥挤。"
     ]
    },
    {
     "译": [],
     "注": [
      "借光：客套语，请人给予方便。",
      "绷绷场面：撑撑场面。",
      "杨媛媛：李鹤汀的相好。",
      "琵琶：此指弹琵琶唱曲。"
     ]
    },
    {
     "译": [],
     "注": [
      "姗姗：缓慢从容的样子。",
      "搭讪：没话找话地攀谈。",
      "长篇大套：话头冗长。",
      "凑趣：迎合他人兴致说笑。",
      "转局：倌人在一处出局后转往另一处。",
      "近便：方便。"
     ]
    },
    {
     "译": [],
     "注": [
      "鲍二姐：屠明珠的娘姨。",
      "装水烟：为客人装填水烟丝。",
      "做意：故作姿态，装模作样。",
      "瞎巴结：乱讨好。",
      "老太爷：对年长男子的戏称，指黎篆鸿。",
      "吃起醋来：争风吃醋。",
      "格声笑：吴语，格格地笑。",
      "三块洋钱：每个局票叫局的局钱，前文“两个局六块洋钱”可证。"
     ]
    },
    {
     "译": [],
     "注": [
      "欺瞒：欺骗隐瞒。",
      "罪过：佛家语，意为过失，此处是“折福损德”。",
      "天打：被天雷打，是赌咒的话。",
      "喝声采：叫一声好。",
      "鲜得来：吴语，鲜美极了。",
      "白相：吴语，玩耍，有趣。",
      "当水：上当、被哄；“当”指受骗。",
      "勿著杠：吴语，不值得，不合算。"
     ]
    },
    {
     "译": [],
     "注": [
      "榻床：烟榻。",
      "鸦片烟：旧时流行的毒品，吸食需烟枪、烟灯。",
      "罗老爷：罗子富，王莲生的朋友，与黄翠凤相好。",
      "开消：吴语，结清账目，不再往来，指断了关系。",
      "黄翠凤：长三堂子的红倌人，与罗子富相好。",
      "汤老爷：汤啸庵，朱蔼人的友人。",
      "堂子：高等妓院。",
      "打岔：打断、妨碍。",
      "辰光：吴语，时候。"
     ]
    },
    {
     "译": [],
     "注": [
      "通关：酒席上一人轮流与在座各人划拳，称“打通关”。",
      "豁拳：划拳。"
     ]
    },
    {
     "译": [],
     "注": [
      "袖舞钏鸣：袖子挥动，手镯作响，形容倌人热闹划拳。",
      "五魁：划拳吆喝语，“五魁首”。",
      "八马：划拳吆喝语，“八匹马”，即八。",
      "平拳：划拳时双方所出相同，不分胜负，待考。",
      "钏：手镯。",
      "迥不犹人：与众不同。",
      "干稀饭：用干饭或稀饭，指吃饭收场。"
     ]
    },
    {
     "译": [],
     "注": [
      "席终：宴席结束。",
      "石路：上海石路（今福建中路一带）。",
      "长安客栈：石路上的客栈名。",
      "嘿然：沉默不语的样子。",
      "碰和：打麻雀牌；清末堂子里碰和常带赌博性质。",
      "宽衣：脱衣。"
     ]
    },
    {
     "译": [],
     "注": [
      "烟斗：烟枪上装烟泡的斗。",
      "老倌人：老资格的倌人，此处含贬义。",
      "抚牢：吴语，抱住、缠住。",
      "落得：不妨，乐得。",
      "沓光：吴语，稀疏脱落光了。",
      "镶仔一埭水浪边：形容皱纹如镶边，待考。",
      "神妖鬼怪：妖里妖气，故作媚态。",
      "满：吴语，待考。",
      "野哚：吴语，很，非常。",
      "拍俚马屁：奉承她。"
     ]
    },
    {
     "译": [],
     "注": [
      "倒贴：妓女反贴钱给客人。",
      "月白竹布衫：浅蓝色竹布长衫。",
      "头面：首饰。",
      "包头珠：额前包头上缀的珍珠。",
      "花酒：在妓院请客喝的酒席，常有倌人陪侍。",
      "长三书寓：上海高等妓院，倌人称“长三”，书寓为早期自称；二者合称，待考。",
      "投：吴语，门路，待考。",
      "年势：年成，一年的收入。"
     ]
    },
    {
     "译": [],
     "注": [
      "被窝：被子里。",
      "挡角色：吴语，有分量的角色。",
      "接嘴：接话。",
      "烟瘾：吸鸦片的瘾。"
     ]
    },
    {
     "译": [],
     "注": [
      "廿一日：二十一日。",
      "花雨楼：四马路上的烟馆兼茶楼，三层，可吸鸦片烟，有野鸡出没。",
      "实翁：对李实夫的尊称，“翁”即先生。"
     ]
    },
    {
     "译": [],
     "注": [
      "篆翁：对黎篆鸿的尊称。",
      "吃局：吃酒叫局。",
      "借重光陪：请人光临陪客的客套语。",
      "千乞勿却：千万不要推辞。",
      "舍侄：自己的侄子。",
      "有屈：委屈，客套语。",
      "峻辞：严辞拒绝。",
      "奉邀：恭敬邀请。"
     ]
    },
    {
     "译": [],
     "注": [
      "上市：茶馆烟馆生意最旺的时间。",
      "堂倌：茶馆烟馆的伙计。",
      "开灯：点烟灯，指吸鸦片烟。",
      "会帐：算账付钱。",
      "当中正面榻上：烟馆中间正面的烟榻。"
     ]
    },
    {
     "译": [],
     "注": [
      "野鸡：未入妓院、在街头拉客的下等妓女。",
      "围场：出没场所。",
      "寻开心：寻欢作乐。"
     ]
    },
    {
     "译": [],
     "注": [
      "热手巾：热毛巾，供擦脸。",
      "膏荷苏线棉袄：待考。",
      "茶青色：深绿近黑的颜色。",
      "手帕子：手绢。",
      "搭腔：搭话。",
      "乘间躺下：趁机一同躺下吸烟。"
     ]
    },
    {
     "译": [],
     "注": [
      "屏门：屋内遮挡的门。",
      "贩洋广京货的：卖洋货、广货、京货的小贩。",
      "豁琅：象声词，东西落地破裂声。"
     ]
    },
    {
     "译": [],
     "注": [
      "勾肩搭背：互相搭着肩背，亲热嬉闹。",
      "唏唏哈哈：嬉笑声。",
      "玻镜子：玻璃镜子。",
      "寒暑表：温度计。",
      "小洋钱：小银元，一角。",
      "胡咒乱骂：乱骂。",
      "慰藉：安慰。"
     ]
    },
    {
     "译": [],
     "注": [
