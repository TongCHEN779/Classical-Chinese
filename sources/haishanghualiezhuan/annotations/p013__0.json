{
 "start": 0,
 "items": [
  {
   "题解": "本回写陈小云赴王莲生在沈小红处的双台酒局；小红向洪善卿赔笑；莲生托善卿替张蕙贞换首饰，善卿夜宿周双珠处，次日遇赵朴斋，劝他勿被陆秀宝缠住，一同往聚秀堂。",
   "段落": [
    {
     "译": [],
     "注": [
      "金巧珍：陈小云相好，倌人。",
      "金爱珍：巧珍之姊，开绘春堂。",
      "扬鞭开轮：马车启行。"
     ]
    },
    {
     "译": [],
     "注": [
      "静安寺：上海西郊古寺，附近为游览之地，当时马车常往。",
      "大马路：今南京东路。",
      "三马路：今汉口路。",
      "卸车：叫车夫停车卸下。"
     ]
    },
    {
     "译": [],
     "注": [
      "请帖：请客的帖子。",
      "催请：催促赴约。",
      "善卿：洪善卿，书中人物，经营商铺，与小云相熟。",
      "酒叙：设酒宴聚会。"
     ]
    },
    {
     "译": [],
     "注": [
      "应酬：应付交际。",
      "西荟芳里：上海四马路北的里弄，沈小红所居。",
      "台面带局：酒席上请客人带来的倌人。",
      "局里：指官场或公事机关，此指同事，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "横披客目：横幅的客人名单，写所请宾客。",
      "双台：两桌筵席并排，是大宴请的排场。",
      "难末：吴语“于是、这下”。",
      "绷场面：撑场面，装门面。"
     ]
    },
    {
     "译": [],
     "注": [
      "昆仲：兄弟的敬称。",
      "葛仲英：书中人物。",
      "罗子富：书中人物。",
      "汤啸庵：书中人物。",
      "陶云甫：书中人物。",
      "陶玉甫：陶云甫之弟，书中人物。",
      "别场花：别处应酬，“场花”指交际场所。"
     ]
    },
    {
     "译": [],
     "注": [
      "洪老爷：指洪善卿。",
      "咕唧：低声说话。",
      "得罪：冒犯。",
      "包荒：包容，原义宽容。",
      "周双珠：书中倌人，善卿相好。",
      "邱话：吴语“坏话、闲话”，待考。",
      "叉口剪住：插话打断。"
     ]
    },
    {
     "译": [],
     "注": [
      "赵朴斋：洪善卿之外甥，书中人物。",
      "外甥：姐妹之子。",
      "代请：他人托请客。",
      "连吃一台：连续摆酒一台。"
     ]
    },
    {
     "译": [],
     "注": [
      "叫的局：叫局，客人召倌人到酒席陪侍，倌人往赴称出局。",
      "间架：吴语，处境、场面。"
     ]
    },
    {
     "译": [],
     "注": [
      "摆起庄：划拳时坐庄，与众人猜拳。",
      "闹酒：热闹吃酒，猜拳行令。",
      "小堂名：苏州一带的小戏班，在酒席上唱曲助兴。",
      "交仔黄梅：入黄梅季节，约在农历五六月，此处小说借梅雨说笑。",
      "酸：吃醋之意，借黄梅、青梅雕侃。"
     ]
    },
    {
     "译": [],
     "注": [
      "伸拳：猜拳。",
      "开筵坐花：设宴，倌人伴坐。",
      "飞觞醉月：形容饮酒尽兴。",
      "丝哀竹急：音乐急促。",
      "弁侧钗横：男子冠斜、女子钗横，形容醉态。",
      "油词醋意：指男女间吃醋争风的闲话。"
     ]
    },
    {
     "译": [],
     "注": [
      "酒闹灯灺：酒席将散，灯烛燃尽（灺音xiè，烛烬）。",
      "景星银楼：上海银楼名，待考。",
      "贴换：以旧首饰折价换新的，补差价。",
      "细帐：详细清单。",
      "心坎：心中。",
      "偏做不看见：装作没看见。"
     ]
    },
    {
     "译": [],
     "注": [
      "承情：领情，感谢。"
     ]
    },
    {
     "译": [],
     "注": [
      "东合兴里：上海四马路附近里弄名，张蕙贞所居。",
      "嵌名字戒指：戒面镶刻名字的戒指。",
      "坍仔台：吴语，丢了脸面。",
      "吃仔点眼前亏：暂时受点损失。",
      "外头名气：在外的名声。"
     ]
    },
    {
     "译": [],
     "注": [
      "四马路：今福州路。",
      "公阳里：上海四马路附近里弄名，周双珠所居。",
      "玻璃灯：当时一种玻璃罩灯。",
      "投宿：留宿；客人在倌人处过夜。"
     ]
    },
    {
     "译": [],
     "注": [
      "斩五关：一种用牙牌占卜或消遣的牌戏。",
      "牙牌：骨牌，象牙或骨制。",
      "双玉：周双玉，双珠之妹，新来者。",
      "稀饭：粥。",
      "阿金：周双珠家的娘姨。"
     ]
    },
    {
     "译": [],
     "注": [
      "庋置：收放。",
      "掳拢：拢聚。",
      "无娒：吴语“娘”，此指娘姨阿德保，待考。",
      "客堂：厅堂。",
      "阿大：阿德保之子。"
     ]
    },
    {
     "译": [],
     "注": [
      "阿德保：双珠家娘姨，阿大之母。",
      "乔公馆：乔姓官员寓所，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "双宝：书中人物，倌人，待考。",
      "好点：略好些。",
      "本事：能耐。"
     ]
    },
    {
     "译": [],
     "注": [
      "趔趄：脚步不稳；此谓偷偷溜走。",
      "眼错：不注意的空儿。",
      "阿金方辞善卿：阿金告辞洪善卿。"
     ]
    },
    {
     "译": [],
     "注": [
      "鬼戏：小把戏、花招。",
      "小干仵：吴语，小孩子。",
      "上耐哚当水：吴语，上你们的当。",
      "反杀：反而要出事。",
      "朱公馆：朱蔼人寓所。"
     ]
    },
    {
     "译": [],
     "注": [
      "公案：此指要办的事。",
      "了结：办妥。",
      "汤啸庵：书中人物。",
      "蒋月琴：书中倌人，罗子富相好。",
      "局帐：倌人的账目。",
      "和事老：调解人。"
     ]
    },
    {
     "译": [],
     "注": [
      "掌柜的：银楼的主事人。",
      "秤准分两：称重。",
      "双喜双寿：戒指花样，嵌“囍”“寿”字。",
      "方空：方形框格。",
      "蕙贞张氏：戒指上所刻字样。",
      "定打：定做。",
      "发票：此指开明货价的账单。",
      "手巾包：用手巾包裹的小包。"
     ]
    },
    {
     "译": [],
     "注": [
      "擦过善卿身旁：擦身而过。",
      "朴斋：赵朴斋，初到上海，沉迷妓院。",
      "张小村：书中人物，与朴斋相识。",
      "吴松桥：书中人物。",
      "打茶会：到妓院喝茶，即“打茶围”。",
      "陆秀宝：聚秀堂倌人。",
      "庄荔甫：书中商人。",
      "上仔俚哚当水：吴语，上了他们的圈套。",
      "连浪去吃酒：连续去吃酒。"
     ]
    },
    {
     "译": [],
     "注": [
      "夷场：旧称租界为“夷场”。",
      "堂子：长三书寓、妓院的统称。",
      "对勿住耐哚老堂：吴语，对不起你家长辈。",
      "生意：营生、职业。"
     ]
    },
    {
     "译": [],
     "注": [
      "场花：交际场所，花场。",
      "客栈：旅店。",
      "开消：开支。",
      "聚秀堂：陆秀宝所居堂名，在西棋盘街。",
      "西棋盘街：上海街名，与东棋盘街相对，在今河南中路一带。"
     ]
    }
   ]
  }
 ]
}