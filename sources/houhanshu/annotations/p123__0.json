  {
   "题解": "本节记平原郡的建置、户口及九县，并带出鬲国、祝柯等古地的沿革。",
   "段落": [
    {
     "译": [
      "平原郡，高帝设置。",
      "在雒阳以北一千三百里。",
      "下辖九城，十五万五千五百八十八户，一百万零二千六百五十八口。"
     ],
     "注": [
      "平原郡：高帝（刘邦）所置，属青州刺史部，治平原（今山东平原南）。"
     ]
    },
    {
     "译": [
      "平原县。"
     ],
     "注": []
    },
    {
     "译": [
      "高唐县，湿水发源于此。"
     ],
     "注": [
      "湿水：即漯水，古黄河支流，《水经》作“漯”。"
     ]
    },
    {
     "译": [
      "般县。"
     ],
     "注": []
    },
    {
     "译": [
      "鬲县，为侯国。",
      "夏朝时有鬲国的君主，灭掉了寒浞，拥立少康。"
     ],
     "注": [
      "侯国：以县为列侯封邑者。",
      "鬲君：夏初有鬲氏之君，助少康消灭寒浞复国，见《左传》襄公四年、哀公元年。",
      "少康：夏代中兴之主，相之子。"
     ]
    },
    {
     "译": [
      "祝阿县，春秋时叫祝柯。",
      "有野井亭。"
     ],
     "注": [
      "祝柯：春秋齐地，《左传》襄公十九年诸侯盟于祝柯。"
     ]
    },
    {
     "译": [
      "乐陵县。"
     ],
     "注": []
    },
    {
     "译": [
      "湿阴县。"
     ],
     "注": []
    },
    {
     "译": [
      "安德县，为侯国。"
     ],
     "注": []
    },
    {
     "译": [
      "厌次县，原名富平。",
      "明帝时改名。"
     ],
     "注": [
      "明帝：东汉明帝刘庄（57至75年在位）。"
     ]
    }
   ]
  },
  {
   "题解": "本节记乐安国的来历与改名、户口及九县，兼记薄姑城等古迹。",
   "段落": [
    {
     "译": [
      "乐安国，高帝从西平昌一带划出设置，原名千乘，永元七年（95年）改名。",
      "在雒阳以东一千五百二十里。",
      "下辖九城，七万四千四百户，四十二万四千零七十五口。"
     ],
     "注": [
      "西平昌：原文如此，具体所指待考。",
      "永元：汉和帝年号（89至105年）。",
      "千乘：国名，治千乘县，在今山东高青东北。"
     ]
    },
    {
     "译": [
      "临济县，原名狄县，安帝时更名。"
     ],
     "注": [
      "狄：县名，战国以来为狄邑，旧属千乘。",
      "安帝：东汉安帝刘祜（106至125年在位）。"
     ]
    },
    {
     "译": [
      "千乘县。"
     ],
     "注": []
    },
    {
     "译": [
      "高菀县。"
     ],
     "注": []
    },
    {
     "译": [
      "乐安县。"
     ],
     "注": []
    },
    {
     "译": [
      "博昌县，有薄姑城。",
      "有贝中聚。",
      "有时水。"
     ],
     "注": [
      "薄姑：商周之际东方古国，曾参与武庚之乱，后为齐地。",
      "时水：水名，即淄水支流，今地待考。"
     ]
    },
    {
     "译": [
      "蓼城县，为侯国。"
     ],
     "注": []
    },
    {
     "译": [
      "利县，原属齐国。"
     ],
     "注": []
    },
    {
     "译": [
      "益县，为侯国。",
      "原属北海。"
     ],
     "注": []
    },
    {
     "译": [
      "寿光县，原属北海。",
      "有灌亭。"
     ],
     "注": [
      "灌亭：与古灌国有关，具体所在待考。"
     ]
    }
   ]
