{
 "start": 0,
 "items": [
  {
   "题解": "本节是《郡国志》第三篇的篇题，所述为兖州、徐州两刺史部所辖郡国，接续上篇豫州、冀州。",
   "段落": [
    {
     "译": [
      "志第二十一，郡国三。"
     ],
     "注": [
      "郡国：司马彪《续汉书》八志之一，记东汉各郡国的户口、属县与古迹。"
     ]
    }
   ]
  },
  {
   "题解": "陈留郡属兖州，为东汉京畿东面大郡，志文记其户口及十七县。",
   "段落": [
    {
     "译": [
      "武帝设置。",
      "在雒阳以东五百三十里。",
      "共十七座县城，十七万七千五百二十九户，八十六万九千四百三十三口。"
     ],
     "注": [
      "雒阳：东汉都城。陈留郡治陈留，今河南开封东南。东汉属兖州。",
      "武帝：汉武帝刘彻。"
     ]
    },
    {
     "译": [
      "陈留县，有鸣雁亭。"
     ],
     "注": [
      "陈留：今河南开封东南。"
     ]
    },
    {
     "译": [
      "浚仪县，本是大梁。"
     ],
     "注": [
      "浚仪：今河南开封，战国魏都大梁。"
     ]
    },
    {
     "译": [
      "尉氏县。"
     ],
     "注": [
      "尉氏：今河南尉氏。"
     ]
    },
    {
     "译": [
      "雍丘县，本是[_]国。"
     ],
     "注": [
      "雍丘：今河南杞县，古杞国地。",
      "[_]：底本缺字，国名不详，待考。"
     ]
    },
    {
     "译": [
      "襄邑县，有滑亭。",
      "有承匡城。"
     ],
     "注": [
      "襄邑：今河南睢县。",
      "承匡：春秋宋国地名。"
     ]
    },
    {
     "译": [
      "外黄县，有葵丘聚，齐桓公在此会盟诸侯，城中有曲棘里。",
      "有繁阳城。"
     ],
     "注": [
      "外黄：今河南民权西北。",
      "葵丘：春秋齐桓公会诸侯之地。",
      "齐桓公：春秋五霸之首，姜姓。"
     ]
    },
    {
     "译": [
      "小黄县。"
     ],
     "注": [
      "小黄：今河南开封东北。"
     ]
    },
    {
     "译": [
      "东昏县。"
     ],
     "注": [
      "东昏：今河南兰考东北。"
     ]
    },
    {
     "译": [
      "济阳县。"
     ],
     "注": [
      "济阳：今河南兰考东北，光武帝出生地。"
     ]
    },
    {
     "译": [
      "平丘县，有临济亭，田儋死在这里。",
      "有匡。",
      "有黄池亭。"
     ],
     "注": [
      "平丘：今河南封丘东。",
      "田儋：秦末齐王，在临济被章邯所杀。",
      "黄池：春秋晋吴会盟之地。"
     ]
    },
    {
     "译": [
      "封丘县，有桐牢亭，有人说就是古代的蟲牢。"
     ],
     "注": [
      "封丘：今河南封丘西南。",
      "蟲牢：春秋郑国地名，晋、鲁等国盟会于此。"
     ]
    },
    {
     "译": [
      "酸枣县。"
     ],
     "注": [
      "酸枣：今河南延津西南。"
     ]
    },
    {
     "译": [
      "长垣县，是侯国。",
      "有匡城。",
      "有蒲城。",
      "有祭城。"
     ],
     "注": [
      "长垣：今河南长垣东北。",
      "匡城：孔子被围于匡处。"
     ]
    },
    {
     "译": [
      "己吾县，有大棘乡。",
      "有首乡。"
     ],
     "注": [
      "己吾：今河南宁陵西南。"
     ]
    },
    {
     "译": [
      "考城县，原名菑，章帝改名。",
      "原属梁国。"
     ],
     "注": [
      "考城：今河南民权东北。"
     ]
    },
    {
     "译": [
      "圉县，原属淮阳。",
      "有高阳亭。"
     ],
     "注": [
      "圉：今河南杞县南，蔡邕故里。"
     ]
    },
    {
     "译": [
      "扶沟县，原属淮阳。"
     ],
     "注": [
      "扶沟：今河南扶沟。"
     ]
    }
   ]
  },
  {
   "题解": "东郡属兖州，志文记其户口及十五县，多春秋卫、燕等国故地。",
   "段落": [
    {
     "译": [
      "秦代设置。",
      "距雒阳八百多里。",
      "共十五座县城，十三万六千零八十八户，六十万零三千三百九十三口。"
     ],
     "注": [
      "雒阳：东汉都城。东郡治濮阳，今河南濮阳西南，秦始皇置。"
     ]
    },
    {
     "译": [
      "濮阳县，是古昆吾国，春秋时叫濮。",
      "有咸城，有人说是古咸国。",
      "有清丘。",
      "有鉏城。"
     ],
     "注": [
      "濮阳：今河南濮阳西南。",
      "昆吾：夏代诸侯，己姓。"
     ]
    },
    {
     "译": [
      "燕县，本是南燕国。",
      "有雍乡。",
      "有胙城，是古胙国。",
      "有平阳亭。",
      "有瓦亭。",
      "有桃城。"
     ],
     "注": [
      "燕：今河南延津东北，南燕国，姞姓。",
      "胙国：周公之后所封。",
      "占：原文似“古”字之误，疑当作“古胙国”。"
     ]
    },
    {
     "译": [
      "白马县，有韦乡。"
     ],
     "注": [
      "白马：今河南滑县东。"
     ]
    },
    {
     "译": [
      "顿丘县。"
     ],
     "注": [
      "顿丘：今河南清丰西南。"
     ]
    },
    {
     "译": [
      "东阿县，有清亭。"
     ],
     "注": [
      "东阿：今山东阳谷东北。"
     ]
    },
    {
     "译": [
      "东武阳县，湿水从这里发源。"
     ],
     "注": [
      "东武阳：今山东莘县南。"
     ]
    },
    {
     "译": [
      "范县，有秦亭。"
     ],
     "注": [
      "范：今河南范县东南。"
     ]
    },
    {
     "译": [
      "临邑县，有[B925]庙。"
     ],
     "注": [
      "临邑：今山东东阿东北。",
      "[B925]：底本造字，字形不清。"
     ]
    },
    {
     "译": [
      "博平县。"
     ],
     "注": [
      "博平：今山东茌平西北。"
     ]
    },
    {
     "译": [
      "聊城县，有夷仪聚。",
      "有聂城。"
     ],
     "注": [
      "聊城：今山东聊城西北。"
     ]
    },
    {
     "译": [
      "發干县。"
     ],
     "注": [
      "發干：今山东堂邑东，“發”同“发”。"
     ]
    },
    {
     "译": [
      "乐平县，是侯国。",
      "原名清，章帝改名。"
     ],
     "注": [
      "乐平：今山东聊城东。"
     ]
    },
    {
     "译": [
      "阳平县，是侯国。",
      "有莘亭。",
      "有冈成城。"
     ],
     "注": [
      "阳平：今山东莘县。",
      "莘：古地名，伊尹故里，亦作有莘。"
     ]
    },
    {
     "译": [
      "卫县，是公国。",
      "本是观，是古国，姚姓，光武帝改名。",
      "有河牧城。",
      "有竿城。"
     ],
     "注": [
      "卫：今河南清丰西南，东汉封周后为卫公。",
      "观：古国名，在今河南濮阳一带。"
     ]
    },
    {
     "译": [
      "穀城县，春秋时叫小穀。",
      "有巂下聚。"
     ],
     "注": [
      "穀城：今山东东阿南，春秋齐国小穀。"
     ]
    }
   ]
  },
  {
   "题解": "东平国属兖州，由梁国分立，志文记其户口及七县。",
   "段落": [
    {
     "译": [
      "原是梁国，景帝分出置济东国，宣帝时改名。",
      "在雒阳以东九百七十五里。",
      "共七座县城，七万九千零一十二户，四十四万八千二百七十口。"
     ],
     "注": [
      "景帝：东平国治无盐，今山东东平东。",
      "济东国：汉景帝时分梁国置。"
     ]
    },
    {
     "译": [
      "无鹽县，本是宿国，任姓。",
      "有章城。"
     ],
     "注": [
      "无鹽：今山东东平东。",
      "宿国：风姓古国，即任姓。"
     ]
    },
    {
     "译": [
      "东平陆县，六国时叫平陆。",
      "有阚亭。",
      "有堂阳亭。"
     ],
     "注": [
      "东平陆：今山东汶上北。"
     ]
    },
    {
     "译": [
      "富成县。"
     ],
     "注": [
      "富成：今山东东平南，待考。"
     ]
    },
    {
     "译": [
      "章县。"
     ],
     "注": [
      "章：今山东东平附近，待考。"
     ]
    },
    {
     "译": [
      "寿张县，春秋时叫良，汉代叫寿良，光武帝改叫寿张。",
      "有堂聚，原来这个聚属东郡。"
     ],
     "注": [
      "寿张：今山东东平西南。"
     ]
    },
    {
     "译": [
      "须昌县，原属东郡。",
      "有致密城，是古中都。",
      "有阳穀城。"
     ],
     "注": [
      "须昌：今山东东平西北。",
      "中都：孔子曾任中都宰。"
     ]
    },
    {
     "译": [
      "寧阳县，原属泰山郡。"
     ],
     "注": [
      "寧阳：今山东宁阳。"
     ]
    }
   ]
  },
  {
   "题解": "任城国属兖州，章帝时由东平国分出，辖三县。",
   "段落": [
    {
     "译": [
      "章帝元和元年（84年），从东平国分出任城国。",
      "在雒阳以东一千一百里。",
      "共三座县城，三万六千四百四十二户，十九万四千一百五十六口。"
     ],
     "注": [
      "章帝：任城国治任城，今山东济宁东南。"
     ]
    },
    {
     "译": [
      "任城县，本是任国。",
      "有桃聚。"
     ],
     "注": [
      "任城：今山东济宁东南。",
      "任国：风姓古国。"
     ]
    },
    {
     "译": [
      "亢父县。"
     ],
     "注": [
      "亢父：今山东济宁南，“父”读“甫”。"
     ]
    },
    {
     "译": [
      "樊县。"
     ],
     "注": [
      "樊：今山东兖州西南。"
     ]
    }
   ]
  },
  {
   "题解": "泰山郡属兖州，志文记其户口及十二县，有明堂、泰山庙等封禅相关古迹。",
   "段落": [
    {
     "译": [
      "高帝设置。",
      "在雒阳以东一千四百里。",
      "共十二座县城，八千九百二十九户，四十三万七千三百一十七口。"
     ],
     "注": [
      "高帝：泰山郡治奉高，今山东泰安东。",
      "八千九百二十九：此户数与口数悬殊，疑有误。"
     ]
    },
    {
     "译": [
      "奉高县，有明堂，是武帝所建。"
     ],
     "注": [
      "奉高：今山东泰安东。",
      "明堂：古代天子宣明政教、祭祀之所，武帝封禅泰山时建。"
     ]
    },
    {
     "译": [
