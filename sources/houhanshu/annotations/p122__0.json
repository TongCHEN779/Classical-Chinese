      "有梁丘城。",
      "有甲父亭。"
     ],
     "注": [
      "昌邑：今山东巨野东南。",
      "刺史治：兖州刺史驻地。"
     ]
    },
    {
     "译": [
      "东缗县，春秋时叫缗。"
     ],
     "注": [
      "东缗：今山东金乡东北。"
     ]
    },
    {
     "译": [
      "钜野县，有大野泽。"
     ],
     "注": [
      "钜野：今山东巨野。",
      "大野泽：古泽名，今已淤塞。"
     ]
    },
    {
     "译": [
      "高平县，是侯国。",
      "原名橐，章帝改名。",
      "有茅乡城。"
     ],
     "注": [
      "高平：今山东邹城西南。"
     ]
    },
    {
     "译": [
      "湖陆县，原名湖陵，章帝改名。"
     ],
     "注": [
      "湖陆：今山东鱼台东南。"
     ]
    },
