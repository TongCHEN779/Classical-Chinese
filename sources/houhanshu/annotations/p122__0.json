      "菟裘：春秋鲁地，鲁隐公曾欲营菟裘养老。"
     ]
    },
    {
     "译": [
      "钜平县，是侯国。",
      "有亭禅山。",
      "有阳关亭。"
     ],
     "注": [
      "钜平：今山东泰安南。",
      "亭禅山：地名，待考。"
     ]
    },
    {
     "译": [
      "嬴县，出产铁。"
     ],
     "注": [
      "嬴：今山东莱芜西北。"
     ]
    },
    {
     "译": [
      "山茌县，是侯国。"
     ],
     "注": [
      "山茌：今山东长清南。"
     ]
    },
    {
     "译": [
      "莱芜县，有原山，潘水从这里发源。"
     ],
     "注": [
      "莱芜：今山东莱芜东北。"
     ]
    },
    {
     "译": [
      "盖县，沂水从这里发源。"
     ],
     "注": [
      "盖：今山东沂源东南。"
     ]
    },
    {
     "译": [
      "南武阳县，是侯国。",
      "有颛臾城。"
     ],
     "注": [
      "南武阳：今山东平邑南。",
      "颛臾：古国名，《论语》载季氏将伐颛臾。"
     ]
    },
    {
     "译": [
      "南城县，原属东海。",
      "有东阳城。"
     ],
     "注": [
      "南城：今山东平邑东南。"
     ]
    },
    {
     "译": [
      "费县，是侯国，原属东海。",
      "有[BD25]亭。",
      "有臺亭。"
     ],
     "注": [
      "费：今山东费县西北。",
      "[BD25]：底本造字，字形不清。"
     ]
    },
    {
     "译": [
      "牟县，是古国。"
     ],
     "注": [
      "牟：今山东莱芜东，古牟国。"
     ]
    }
   ]
  },
  {
