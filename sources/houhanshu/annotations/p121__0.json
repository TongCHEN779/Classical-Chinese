{
 "start": 0,
 "items": [
  {
   "题解": "颍川郡为豫州刺史部所辖第一郡，志文记其沿革、距雒阳里数、户口，并逐县列出古迹山水。",
   "段落": [
    {
     "译": [
      "颍川郡，秦代设置。",
      "在雒阳东南五百里。",
      "辖十七座县城，共二十六万三千四百四十户，一百四十三万六千五百一十三口。"
     ],
     "注": [
      "颍川郡：治阳翟，今河南禹州一带，东汉属豫州。",
      "雒阳：东汉都城，今河南洛阳东。",
      "戸：同“户”，异体字。"
     ]
    },
    {
     "译": [
      "阳翟县，是夏禹的都城。",
      "有钧台。",
      "有高氏亭。",
      "有雍氏城。"
     ],
     "注": [
      "阳翟：今河南禹州。",
      "钧台：相传夏启曾在此宴会诸侯，故址在今禹州。",
      "亭：汉代基层治安机构，也指其所在地。"
     ]
    },
    {
     "译": [
      "襄县，有养阴里。"
     ],
     "注": [
      "养阴里：里名，今地待考。"
     ]
    },
    {
     "译": [
      "襄城县，有西不羹。",
      "有氾城。",
      "有汾丘。",
      "有鱼齿山。"
     ],
     "注": [
      "不羹：春秋楚国邑名，有东、西二处，西不羹在今河南襄城东南。",
      "汾丘：地名，今地待考。"
     ]
    },
    {
     "译": [
      "昆阳县，有湛水。"
     ],
     "注": [
      "昆阳：今河南叶县一带，王莽末年光武帝大破王寻、王邑于此。"
     ]
    },
    {
     "译": [
      "定陵县，有东不羹。"
     ],
     "注": [
      "东不羹：楚邑，在今河南舞阳北。"
     ]
    },
    {
     "译": [
      "舞阳县，是邑。"
     ],
     "注": [
      "邑：汉制，县有封君（皇太后、公主）食邑者称邑。"
     ]
    },
    {
     "译": [
      "郾县。"
     ],
     "注": [
      "郾：今河南漯河郾城区一带。"
     ]
    },
    {
     "译": [
      "临颍县。"
     ],
     "注": [
      "临颍：今河南临颍。"
     ]
    },
    {
     "译": [
      "颍阳县。"
     ],
     "注": [
      "颍阳：今河南许昌西南，待考。"
     ]
    },
    {
     "译": [
      "颍阴县，有狐宗乡，有人说就是古代的狐人亭。",
      "有岸亭。"
     ],
     "注": [
      "颍阴：今河南许昌。",
      "狐宗乡：乡名，今地待考。"
     ]
    },
    {
     "译": [
      "许县。"
     ],
     "注": [
      "许：古许国，今河南许昌东。"
     ]
    },
    {
     "译": [
      "新汲县。"
     ],
     "注": [
      "新汲：今河南扶沟西南，待考。"
     ]
    },
    {
     "译": [
      "焉陵县，春秋时叫做𨻳。"
     ],
     "注": [
      "焉陵：县名，今地待考。",
      "𨻳：古地名，字形罕见，今地待考。"
     ]
    },
    {
     "译": [
      "长社县，有长葛城。",
      "有向乡。",
      "有蜀城，有蜀津。"
     ],
     "注": [
      "长社：今河南长葛东。",
      "津：渡口。"
     ]
    },
    {
     "译": [
      "阳城县，有嵩高山，洧水、颍水从这里发源。",
      "出产铁。",
      "有负黍聚。"
     ],
     "注": [
      "嵩高山：即嵩山，五岳之中岳，在今河南登封北。",
      "洧水：淮河支流，源出河南登封。",
      "聚：村落。"
     ]
    },
    {
     "译": [
      "父城县，有应乡。"
     ],
     "注": [
      "父城：今河南宝丰东，待考。"
     ]
    },
    {
     "译": [
      "轮氏县，建初四年（79年）设置。"
     ],
     "注": [
      "轮氏：前志作“纶氏”，见校勘记。",
      "建初：汉章帝年号。"
     ]
    }
   ]
  },
  {
   "题解": "汝南郡为豫州大郡，志文记其所辖三十七城及各县的故国、侯国、古迹，多引春秋诸国旧事。",
   "段落": [
    {
     "译": [
      "汝南郡，高帝设置。",
      "在雒阳东南六百五十里。",
      "辖三十七座县城，共四十万四千四百四十八户，二百一十万零七百八十八口。"
     ],
     "注": [
      "汝南郡：治平舆，今河南平舆北。",
      "高帝：汉高祖刘邦。"
     ]
    },
    {
     "译": [
      "平舆县，有沈亭，是古沈国，姬姓。"
     ],
     "注": [
      "沈：周代诸侯国，姬姓，在今河南平舆北。"
     ]
    },
    {
     "译": [
      "新阳县，是侯国。"
     ],
     "注": [
      "侯国：汉制，列侯的封地称侯国，地位同县。"
     ]
    },
    {
     "译": [
      "西平县，出产铁。",
      "有柏亭，是古柏国。"
     ],
     "注": [
      "西平：今河南西平。",
      "柏国：古国名，在今河南西平西。"
     ]
    },
    {
     "译": [
      "上蔡县，本是蔡国。"
     ],
     "注": [
      "上蔡：今河南上蔡西南，周代蔡国故都。"
     ]
    },
    {
     "译": [
      "南顿县，本是顿国。"
     ],
     "注": [
      "南顿：今河南项城西，古顿国地。"
     ]
    },
    {
     "译": [
      "汝阴县，本是胡国。"
     ],
     "注": [
      "汝阴：今安徽阜阳。",
      "胡国：春秋小国，归姓，后为楚所灭。"
     ]
    },
    {
     "译": [
      "汝阳县。"
     ],
     "注": [
      "汝阳：今河南商水西南。"
     ]
    },
    {
     "译": [
      "新息县，是侯国。"
     ],
     "注": [
      "新息：今河南息县，马援封新息侯。"
     ]
    },
    {
     "译": [
      "北宜春县。"
     ],
     "注": [
      "北宜春：今河南汝南东南。"
     ]
    },
    {
     "译": [
      "㶏强县，是侯国。"
     ],
     "注": [
      "㶏强：“㶏”同“濦”，县名，今河南固始西北。"
     ]
    },
    {
     "译": [
      "灌阳县。"
     ],
     "注": [
      "灌阳：县名，今地待考。"
     ]
    },
    {
     "译": [
      "期思县，有蒋乡，是古蒋国。"
     ],
     "注": [
      "期思：今河南淮滨东南。",
      "蒋国：周公之子伯龄所封，姬姓。"
     ]
    },
    {
     "译": [
      "阳安县，有道亭，是古道国。"
     ],
     "注": [
      "阳安：今河南确山北。"
     ]
    },
    {
     "译": [
      "项县。"
     ],
     "注": [
      "项：今河南沈丘，古项国地。"
     ]
    },
    {
     "译": [
      "西华县。"
     ],
     "注": [
      "西华：今河南西华。"
     ]
    },
    {
     "译": [
      "细阳县。"
     ],
     "注": [
      "细阳：今安徽太和东南。"
     ]
    },
    {
     "译": [
      "安城县，是侯国。",
      "有武城亭。"
     ],
     "注": [
      "安城：今河南正阳东南，铫期封安成侯。"
     ]
    },
    {
     "译": [
      "吴房县，有棠谿亭。"
     ],
     "注": [
      "吴房：今河南遂平。",
      "棠谿：春秋时吴王阖庐弟夫概所封之地。"
     ]
    },
    {
     "译": [
      "鲖阳县，是侯国。"
     ],
     "注": [
      "鲖阳：今安徽临泉东北。"
     ]
    },
    {
     "译": [
      "慎阳县。"
     ],
     "注": [
      "慎阳：今河南正阳北，字或作“滇阳”。"
     ]
    },
    {
     "译": [
      "慎县。"
     ],
     "注": [
      "慎：今安徽颍上北。"
     ]
    },
    {
     "译": [
      "新蔡县，有大吕亭。"
     ],
     "注": [
      "新蔡：今河南新蔡，春秋蔡平侯迁都于此。"
     ]
    },
    {
     "译": [
      "安阳县，是侯国。",
      "有江亭，是古江国，嬴姓。"
     ],
     "注": [
      "安阳：今河南正阳西南。",
      "江亭：古江国，古国名，嬴姓，后为楚所灭。"
     ]
    },
    {
     "译": [
      "富波县，是侯国，永元年间（89—105年）恢复。"
     ],
     "注": [
      "富波：今河南固始东，待考。",
      "永元：汉和帝年号。"
     ]
    },
    {
     "译": [
      "宜禄县，永元年间恢复。"
     ],
     "注": [
      "宜禄：县名，今地待考。"
     ]
    },
    {
     "译": [
      "郎陵县，是侯国。"
     ],
     "注": [
      "郎陵：今河南确山南。"
     ]
    },
    {
     "译": [
      "弋阳县，是侯国。",
      "有黄亭，是古黄国，嬴姓。"
     ],
     "注": [
      "弋阳：今河南潢川西。",
      "黄国：古国名，嬴姓，后为楚所灭。"
     ]
    },
    {
     "译": [
      "召陵县，有陉亭。",
      "有安陵乡。"
     ],
     "注": [
      "召陵：今河南漯河召陵区东，春秋齐桓公会诸侯盟于此。"
     ]
    },
    {
     "译": [
      "征羌县，是侯国。",
      "有安陵亭。"
     ],
     "注": [
      "征羌：今河南郾城东南，因来歙征羌有功得名，待考。"
     ]
    },
    {
     "译": [
      "思善县，是侯国。"
     ],
     "注": [
      "思善：县名，今地待考。"
     ]
    },
    {
     "译": [
      "宋县，是公国，周代名叫[C745]丘，汉代改称新[C745]，章帝建初四年（79年）把宋公迁到这里。",
      "有繁阳亭。"
     ],
     "注": [
      "公国：汉代封二王之后，如宋公，地位高于侯国。",
      "[C745]：底本此字为造字符号，字形不清。",
      "宋公：指殷商后裔所封的宋公。"
     ]
    },
    {
     "译": [
      "褒信县，是侯国。",
      "有赖亭，是古赖国。"
     ],
     "注": [
      "褒信：今河南息县东北。",
      "赖亭：古赖国，春秋小国，后为楚所灭。"
     ]
    },
    {
     "译": [
      "原鹿县，是侯国。"
     ],
     "注": [
      "原鹿：今河南商水西南，待考。"
     ]
    },
    {
     "译": [
      "定颍县，是侯国。"
     ],
     "注": [
      "定颍：今河南舞阳东，待考。"
     ]
    },
    {
     "译": [
      "固始县，是侯国。",
      "这里原是寝地，光武中兴时改了名。",
      "有寝丘。"
     ],
     "注": [
      "固始：今河南固始东。",
      "光武中兴：光武帝刘秀重建汉室。",
      "寝丘：春秋楚孙叔敖所请封之地。"
     ]
    },
    {
     "译": [
      "山桑县，是侯国，原属沛郡。",
      "有下城父聚。",
      "有垂惠聚。"
     ],
     "注": [
      "山桑：今安徽蒙城北。",
      "沛：沛郡，东汉改为沛国。"
     ]
    },
    {
     "译": [
      "城父县，原属沛郡，春秋时叫夷。",
      "有章华台。"
     ],
     "注": [
      "城父：今安徽亳州东南。",
      "章华台：春秋楚灵王所筑，此地另有同名台。"
     ]
    }
   ]
  },
  {
   "题解": "梁国属豫州，志文记其沿革、里数、户口及各县的宋国旧地、古迹。",
   "段落": [
    {
     "译": [
      "梁国，秦代为砀郡，高帝改置。",
      "其中三个县，元和元年（84年）划入。",
      "在雒阳东南八百五十里。",
      "共九座县城，八万三千三百户，四十三万一千二百八十三口。"
     ],
     "注": [
      "梁国：治睢阳，今河南商丘南。",
      "砀郡：秦郡名，治砀县。",
      "元和：汉章帝年号。"
     ]
    },
    {
     "译": [
      "下邑县。"
     ],
     "注": [
      "下邑：今安徽砀山。"
     ]
    },
    {
     "译": [
      "睢阳县，本是宋国阏伯的旧墟。",
      "有卢门亭。",
      "有鱼门。",
      "有阳梁聚。"
     ],
     "注": [
      "睢阳：今河南商丘南，宋国都城。",
      "阏伯：传说中商人的祖先契的后人，居商丘，主祀大火星。",
      "卢门：宋都城门名。"
     ]
    },
    {
     "译": [
      "虞县，有空桐地，有桐地，有桐亭。",
      "有纶城，是少康的封邑。"
     ],
     "注": [
      "虞：今河南虞城北。",
      "少康：夏代中兴之君，曾居纶邑。"
     ]
    },
    {
     "译": [
      "砀山，出产文石。"
     ],
     "注": [
      "文石：有纹理的石头，纹石。"
     ]
    },
    {
     "译": [
      "蒙县，有蒙泽。"
     ],
     "注": [
      "蒙：今河南商丘东北，宋国蒙邑。"
     ]
    },
    {
     "译": [
      "穀熟县，有新城。",
      "有邳亭。"
     ],
     "注": [
      "穀熟：今河南商丘东南，“熟”或作“孰”。"
     ]
    },
    {
     "译": [
      "焉县，原属陈留郡。"
     ],
     "注": [
      "焉：县名，今地待考，与陈留郡有关。"
     ]
    },
    {
     "译": [
      "宁陵县，原属陈留郡。",
      "有葛乡，是古葛伯国。"
     ],
     "注": [
      "宁陵：今河南宁陵。",
      "葛伯：商汤时的邻国之君，因不祭祀被汤征伐。"
     ]
    },
    {
     "译": [
      "薄县，原属山阳郡，是汤的都城。"
     ],
     "注": [
      "薄：同“亳”，商汤都城，今河南商丘一带。"
     ]
    }
   ]
  },
  {
   "题解": "沛国属豫州，为高祖故乡，志文记其所辖二十一县，多有刘邦起事与秦末战争遗迹。",
   "段落": [
    {
     "译": [
      "沛国，秦代为泗水郡，高帝改置。",
      "在雒阳东南一千二百里。",
      "共二十一座县城，二十万零四百九十五户，二十五万一千三百九十三口。"
     ],
     "注": [
      "沛国：治相，今安徽濉溪西北。",
      "泗水郡：秦郡名，治相县。"
     ]
    },
    {
     "译": [
      "相县。"
     ],
     "注": [
      "相：今安徽濉溪西北。"
     ]
    },
    {
     "译": [
      "萧县，本是古国。"
     ],
     "注": [
      "萧：今安徽萧县，春秋宋之附庸。"
     ]
    },
    {
     "译": [
      "沛县，有泗水亭。"
