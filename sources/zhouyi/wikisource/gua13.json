{
 "title": "周易/同人",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%90%8C%E4%BA%BA",
 "revision": "10645635",
 "fetched_at": "2026-11-02T12:49:08.398054+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "同人"
  },
  {
   "type": "p",
   "text": "离下干上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "同人于野，亨。利涉大川，利君子贞。"
  },
  {
   "type": "ol",
   "text": "初九：同人于门，无咎。"
  },
  {
   "type": "ol",
   "text": "六二：同人于宗，吝。"
  },
  {
   "type": "ol",
   "text": "九三：伏戎于莽，升其高陵，三岁不兴。"
  },
  {
   "type": "ol",
   "text": "九四：乘其庸，弗克攻，吉。"
  },
  {
   "type": "ol",
   "text": "九五：同人，先号啕而后笑。大师克相遇。"
  },
  {
   "type": "ol",
   "text": "上九：同人于郊，无悔。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "同人，柔得位得中，而应乎干，曰同人。同人曰，同人于野，亨。利涉大川，乾行也。文明以健，中正而应，君子正也。唯君子为能通天下之志。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "天与火，同人；君子以类族辨物。"
  },
  {
   "type": "ol",
   "text": "出门同人，又谁咎也。"
  },
  {
   "type": "ol",
   "text": "同人于宗，吝道也。"
  },
  {
   "type": "ol",
   "text": "伏戎于莽，敌刚也。三岁不兴，安行也。"
  },
  {
   "type": "ol",
   "text": "乘其庸，义弗克也，其吉，则困而反则也。"
  },
  {
   "type": "ol",
   "text": "同人之先，以中直也。大师相遇，言相克也。"
  },
  {
   "type": "ol",
   "text": "同人于郊，志未得也。"
  }
 ],
 "text_sha256": "1d7abcb517395f107695f5c48b44e454bd7e0dabc2b67c662f68e03f22f6ca17"
}
