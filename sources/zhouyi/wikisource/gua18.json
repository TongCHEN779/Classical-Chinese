{
 "title": "周易/蠱",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E8%A0%B1",
 "revision": "2106145",
 "fetched_at": "2026-11-02T12:50:59.089735+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "蛊"
  },
  {
   "type": "p",
   "text": "巽下艮上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "蛊：元亨。利涉大川。先甲三日，后甲三日。"
  },
  {
   "type": "ol",
   "text": "初六：干父之蛊，有子考，无咎，厉终吉。"
  },
  {
   "type": "ol",
   "text": "九二：干母之蛊，不可贞。"
  },
  {
   "type": "ol",
   "text": "九三：干父之蛊，小有悔，无大咎。"
  },
  {
   "type": "ol",
   "text": "六四：裕父之蛊，往见吝。"
  },
  {
   "type": "ol",
   "text": "六五：干父之蛊，用誉。"
  },
  {
   "type": "ol",
   "text": "上九：不事王侯，高尚其事。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "蛊，刚上而柔下，巽而止，蛊。蛊，元亨，而天下治也。利涉大川，往有事也。先甲三日，后甲三日，终则有始，天行也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "山下有风，蛊；君子以振民育德。"
  },
  {
   "type": "ol",
   "text": "干父之蛊，意承考也。"
  },
  {
   "type": "ol",
   "text": "干母之蛊，得中道也。"
  },
  {
   "type": "ol",
   "text": "干父之蛊，终无咎也。"
  },
  {
   "type": "ol",
   "text": "裕父之蛊，往未得也。"
  },
  {
   "type": "ol",
   "text": "干父用誉，承以德也。"
  },
  {
   "type": "ol",
   "text": "不事王侯，志可则也。"
  }
 ],
 "text_sha256": "0514cae8efeaf4ad6269702f0308ed7e06d232bc4d955da689b9e05319d0b49c"
}
