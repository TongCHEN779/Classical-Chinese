{
 "title": "周易/履",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%B1%A5",
 "revision": "10647513",
 "fetched_at": "2026-11-02T12:49:04.260335+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "履"
  },
  {
   "type": "p",
   "text": "兑下干上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "履虎尾，不咥人，亨。"
  },
  {
   "type": "ol",
   "text": "初九：素履，往无咎。"
  },
  {
   "type": "ol",
   "text": "九二：履道坦坦，幽人贞吉。"
  },
  {
   "type": "ol",
   "text": "六三：眇能视，跛能履，履虎尾，咥人，凶。武人为于大君。"
  },
  {
   "type": "ol",
   "text": "九四：履虎尾，愬愬终吉。"
  },
  {
   "type": "ol",
   "text": "九五：夬履，贞厉。"
  },
  {
   "type": "ol",
   "text": "上九：视履考详，其旋元吉。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "履，柔履刚也。说而应乎干，是以履虎尾，不咥人，亨，利贞。刚中正，履帝位而不疚，光明也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "上天下泽，履；君子以辨上下，定民志。"
  },
  {
   "type": "ol",
   "text": "素履之往，独行愿也。"
  },
  {
   "type": "ol",
   "text": "幽人贞吉，中不自乱也。"
  },
  {
   "type": "ol",
   "text": "眇能视，不足以有明也。跛能履，不足以与行也。咥人之凶，位不当也。武人为于大君，志刚也。"
  },
  {
   "type": "ol",
   "text": "愬愬终吉，志行也。"
  },
  {
   "type": "ol",
   "text": "夬履贞厉，位正当也。"
  },
  {
   "type": "ol",
   "text": "元吉在上，大有庆也。"
  }
 ],
 "text_sha256": "08761d552249e7c479c8f2c3ba14922a0bbd97bdd16aecf0bce3c59921fdc59f"
}
