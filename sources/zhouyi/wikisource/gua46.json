{
 "title": "周易/升",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%8D%87",
 "revision": "10646879",
 "fetched_at": "2026-11-02T12:54:18.252255+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "升"
  },
  {
   "type": "p",
   "text": "巽下坤上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "升：元亨，用见大人，勿恤，南征吉。"
  },
  {
   "type": "ol",
   "text": "初六：允升，大吉。"
  },
  {
   "type": "ol",
   "text": "九二：孚乃利用禴，无咎。"
  },
  {
   "type": "ol",
   "text": "九三：升虚邑。"
  },
  {
   "type": "ol",
   "text": "六四：王用享于岐山，吉无咎。"
  },
  {
   "type": "ol",
   "text": "六五：贞吉，升阶。"
  },
  {
   "type": "ol",
   "text": "上六：冥升，利于不息之贞。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "柔以时升，巽而顺，刚中而应，是以大亨。用见大人，勿恤；有庆也。南征吉，志行也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "地中生木，升；君子以顺德，积小以高大。"
  },
  {
   "type": "ol",
   "text": "允升大吉，上合志也。"
  },
  {
   "type": "ol",
   "text": "九二之孚，有喜也。"
  },
  {
   "type": "ol",
   "text": "升虚邑，无所疑也。"
  },
  {
   "type": "ol",
   "text": "王用亨于岐山，顺事也。"
  },
  {
   "type": "ol",
   "text": "贞吉升阶，大得志也。"
  },
  {
   "type": "ol",
   "text": "冥升在上，消不富也。"
  }
 ],
 "text_sha256": "b2958b2d77c403d6650521625619bd217f1f4124fffdfab263357e9b3efa9dce"
}
