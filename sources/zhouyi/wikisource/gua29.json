{
 "title": "周易/坎",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%9D%8E",
 "revision": "10646381",
 "fetched_at": "2026-11-02T12:51:12.125536+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "坎"
  },
  {
   "type": "p",
   "text": "坎下坎上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "习坎：有孚，维心亨。行有尚。"
  },
  {
   "type": "ol",
   "text": "初六：习坎，入于坎窞，凶。"
  },
  {
   "type": "ol",
   "text": "九二：坎有险，求小得。"
  },
  {
   "type": "ol",
   "text": "六三：来之坎坎，险且枕，入于坎窞，勿用。"
  },
  {
   "type": "ol",
   "text": "六四：尊酒簋，贰用缶。内约自牖，终无咎。"
  },
  {
   "type": "ol",
   "text": "九五：坎不盈，禔既平，无咎。"
  },
  {
   "type": "ol",
   "text": "上六：系用徽𬙊，寘于丛棘，三岁不得，凶。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "习坎，重险也。水流而不盈，行险而不失其信。维心亨，乃以刚中也。行有尚，往有功也。天险不可升也，地险山川丘陵也，王公设险以守其国，坎之时用大矣哉！"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "水洊至，习坎；君子以常德行，习教事。"
  },
  {
   "type": "ol",
   "text": "习坎入坎，失道凶也。"
  },
  {
   "type": "ol",
   "text": "求小得，未出中也。"
  },
  {
   "type": "ol",
   "text": "来之坎坎，终无功也。"
  },
  {
   "type": "ol",
   "text": "樽酒簋贰，刚柔济也。"
  },
  {
   "type": "ol",
   "text": "坎不盈，中未大也。"
  },
  {
   "type": "ol",
   "text": "上六失道，凶三岁也。"
  }
 ],
 "text_sha256": "250d24b62d0a7d52586fcf3ec9ff84b0b12599e6b0b1d5c7abf38e343959ae8f"
}
