{
 "title": "周易/遯",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E9%81%AF",
 "revision": "10645108",
 "fetched_at": "2026-11-02T12:53:01.706264+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "遁"
  },
  {
   "type": "p",
   "text": "艮下干上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "遁：亨。小利贞。"
  },
  {
   "type": "ol",
   "text": "初六：遁尾，厉，勿用有攸往。"
  },
  {
   "type": "ol",
   "text": "六二：执之用黄牛之革，莫之胜说。"
  },
  {
   "type": "ol",
   "text": "九三：系遁，有疾厉，畜臣妾吉。"
  },
  {
   "type": "ol",
   "text": "九四：好遁君子吉，小人否。"
  },
  {
   "type": "ol",
   "text": "九五：嘉遁，贞吉。"
  },
  {
   "type": "ol",
   "text": "上九：肥遁，无不利。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "遁亨，遁而亨也。刚当位而应，与时行也。小利贞，浸而长也。遁之时义大矣哉！"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "天下有山，遁；君子以远小人，不恶而严。"
  },
  {
   "type": "ol",
   "text": "遁尾之厉，不往何灾也。"
  },
  {
   "type": "ol",
   "text": "执用黄牛，固志也。"
  },
  {
   "type": "ol",
   "text": "系遁之厉，有疾惫也。畜臣妾吉，不可大事也。"
  },
  {
   "type": "ol",
   "text": "君子好遁，小人否也。"
  },
  {
   "type": "ol",
   "text": "嘉遁贞吉，以正志也。"
  },
  {
   "type": "ol",
   "text": "肥遁，无不利；无所疑也。"
  }
 ],
 "text_sha256": "d2cf2a17db122fe05f66a773070bd868ad0fdc3e324084efd06e81501d41d2f7"
}
