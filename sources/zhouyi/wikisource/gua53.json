{
 "title": "周易/漸",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E6%BC%B8",
 "revision": "2560535",
 "fetched_at": "2026-11-02T12:55:11.251591+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "渐"
  },
  {
   "type": "p",
   "text": "艮下巽上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "渐：女归吉，利贞。"
  },
  {
   "type": "ol",
   "text": "初六：鸿渐于干，小子厉，有言，无咎。"
  },
  {
   "type": "ol",
   "text": "六二：鸿渐于磐，饮食衎衎，吉。"
  },
  {
   "type": "ol",
   "text": "九三：鸿渐于陆，夫征不复，妇孕不育，凶；利御寇。"
  },
  {
   "type": "ol",
   "text": "六四：鸿渐于木，或得其桷，无咎。"
  },
  {
   "type": "ol",
   "text": "九五：鸿渐于陵，妇三岁不孕，终莫之胜，吉。"
  },
  {
   "type": "ol",
   "text": "上九：鸿渐于陆，其羽可用为仪，吉。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "渐之进也，女归吉也。进得位，往有功也。进以正，可以正邦也。其位刚，得中也。止而巽，动不穷也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "山上有木，渐；君子以居贤德，善俗。"
  },
  {
   "type": "ol",
   "text": "小子之厉，义无咎也。"
  },
  {
   "type": "ol",
   "text": "饮食衎衎，不素饱也。"
  },
  {
   "type": "ol",
   "text": "夫征不复，离群丑也。妇孕不育，失其道也。利用御寇，顺相保也。"
  },
  {
   "type": "ol",
   "text": "或得其桷，顺以巽也。"
  },
  {
   "type": "ol",
   "text": "终莫之胜，吉；得所愿也。"
  },
  {
   "type": "ol",
   "text": "其羽可用为仪，吉；不可乱也。"
  }
 ],
 "text_sha256": "c81916f362d2d9fba545c44e871ebc6ca44a1868051134f8a97568dad25d69cb"
}
