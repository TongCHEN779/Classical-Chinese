{
 "title": "周易/師",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%B8%AB",
 "revision": "2405011",
 "fetched_at": "2026-11-02T12:49:00.738445+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "师"
  },
  {
   "type": "p",
   "text": "坎下坤上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "师：贞丈人吉，无咎。"
  },
  {
   "type": "ol",
   "text": "初六：师出以律，否臧，凶。"
  },
  {
   "type": "ol",
   "text": "九二：在师中吉，无咎；王三锡命。"
  },
  {
   "type": "ol",
   "text": "六三：师或舆尸，凶。"
  },
  {
   "type": "ol",
   "text": "六四：师左次，无咎。"
  },
  {
   "type": "ol",
   "text": "六五：田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。"
  },
  {
   "type": "ol",
   "text": "上六：大君有命，开国承家，小人勿用。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "师，众也。贞，正也。能以众正，可以王矣。刚中而应，行险而顺，以此毒天下，而民从之，吉又何咎矣。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "地中有水，师；君子以容民畜众。"
  },
  {
   "type": "ol",
   "text": "师出以律；失律，凶也。"
  },
  {
   "type": "ol",
   "text": "在师中吉，承天宠也。王三锡命，怀万邦也。"
  },
  {
   "type": "ol",
   "text": "师或舆尸，大无功也。"
  },
  {
   "type": "ol",
   "text": "左次无咎，未失常也。"
  },
  {
   "type": "ol",
   "text": "长子帅师，以中行也。弟子舆尸，使不当也。"
  },
  {
   "type": "ol",
   "text": "大君有命，以正功也。小人勿用，必乱邦也。"
  }
 ],
 "text_sha256": "780e733a6fec93131a80c449b41b65c77a4560dea1928e9353974a3bca09c906"
}
