{
 "title": "周易/未濟",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E6%9C%AA%E6%BF%9F",
 "revision": "10647450",
 "fetched_at": "2026-11-02T12:56:09.162344+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "未济"
  },
  {
   "type": "p",
   "text": "坎下离上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "未济：亨。小狐汔济，濡其尾，无攸利。"
  },
  {
   "type": "ol",
   "text": "初六：濡其尾，吝。"
  },
  {
   "type": "ol",
   "text": "九二：曳其轮，贞吉。"
  },
  {
   "type": "ol",
   "text": "六三：未济，征凶，利涉大川。"
  },
  {
   "type": "ol",
   "text": "九四：贞吉，悔亡，震用伐鬼方，三年有赏于大国。"
  },
  {
   "type": "ol",
   "text": "六五：贞吉，无悔，君子之光，有孚，吉。"
  },
  {
   "type": "ol",
   "text": "上九：有孚于饮酒，无咎，濡其首，有孚失是。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "未济，亨；柔得中也。小狐汔济，未出中也。濡其尾，无攸利；不续终也。虽不当位，刚柔应也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "火在水上，未济；君子以慎辨物居方。"
  },
  {
   "type": "ol",
   "text": "濡其尾，亦不知极也。"
  },
  {
   "type": "ol",
   "text": "九二贞吉，中以行正也。"
  },
  {
   "type": "ol",
   "text": "未济征凶，位不当也。"
  },
  {
   "type": "ol",
   "text": "贞吉悔亡，志行也。"
  },
  {
   "type": "ol",
   "text": "君子之光，其晖吉也。"
  },
  {
   "type": "ol",
   "text": "饮酒濡首，亦不知节也。"
  }
 ],
 "text_sha256": "b9f726b739a1634d4baf5e3f090a1027d8bb97cd5805231d5e6e19e29549ea0c"
}
