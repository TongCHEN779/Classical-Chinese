 "fetched_at": "2026-11-02T12:55:16.193304+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "巽"
  },
  {
   "type": "p",
   "text": "巽下巽上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "巽：小亨。利有攸往。利见大人。"
  },
  {
   "type": "ol",
   "text": "初六：进退，利武人之贞。"
  },
  {
   "type": "ol",
   "text": "九二：巽在床下，用史巫纷若，吉无咎。"
  },
  {
   "type": "ol",
   "text": "九三：频巽，吝。"
  },
  {
   "type": "ol",
   "text": "六四：悔亡，田获三品。"
  },
  {
   "type": "ol",
   "text": "九五：贞吉悔亡，无不利。无初有终，先庚三日，后庚三日，吉。"
  },
  {
   "type": "ol",
   "text": "上九：巽在床下，丧其资斧，贞凶。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "重巽以申命，刚巽乎中正而志行。柔皆顺乎刚，是以小亨，利有攸往，利见大人。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "随风，巽；君子以申命行事。"
  },
  {
   "type": "ol",
   "text": "进退，志疑也。利武人之贞，志治也。"
  },
  {
   "type": "ol",
   "text": "纷若之吉，得中也。"
  },
  {
   "type": "ol",
   "text": "频巽之吝，志穷也。"
  },
  {
   "type": "ol",
   "text": "田获三品，有功也。"
  },
  {
   "type": "ol",
   "text": "九五之吉，位正中也。"
  },
  {
   "type": "ol",
   "text": "巽在床下，上穷也。丧其资斧，正乎凶也。"
  }
 ],
 "text_sha256": "6c4eaa7449a7fa9cadf358b05b00857cd985133234bbc8fc34e6c1a6723e378a"
}
