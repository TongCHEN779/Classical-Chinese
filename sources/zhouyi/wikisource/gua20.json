{
 "title": "周易/觀",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E8%A7%80",
 "revision": "10645159",
 "fetched_at": "2026-11-02T12:51:01.237253+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "观"
  },
  {
   "type": "p",
   "text": "坤下巽上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "观：盥而不荐，有孚颙若。"
  },
  {
   "type": "ol",
   "text": "初六：童观，小人无咎，君子吝。"
  },
  {
   "type": "ol",
   "text": "六二：窥观，利女贞。"
  },
  {
   "type": "ol",
   "text": "六三：观我生，进退。"
  },
  {
   "type": "ol",
   "text": "六四：观国之光，利用宾于王。"
  },
  {
   "type": "ol",
   "text": "九五：观我生，君子无咎。"
  },
  {
   "type": "ol",
   "text": "上九：观其生，君子无咎。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "大观在上，顺而巽，中正以观天下。观，盥而不荐，有孚颙若，下观而化也。观天之神道，而四时不忒，圣人以神道设教，而天下服矣。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "风行地上，观；先王以省方，观民设教。"
  },
  {
   "type": "ol",
   "text": "初六童观，小人道也。"
  },
  {
   "type": "ol",
   "text": "窥观女贞，亦可丑也。"
  },
  {
   "type": "ol",
   "text": "观我生，进退；未失道也。"
  },
  {
   "type": "ol",
   "text": "观国之光，尚宾也。"
  },
  {
   "type": "ol",
   "text": "观我生，观民也。"
  },
  {
   "type": "ol",
   "text": "观其生，志未平也。"
  }
 ],
 "text_sha256": "c420387261b14dca6384b76819c1d7bae3d007075a3407cdca5426d8976635f7"
}
