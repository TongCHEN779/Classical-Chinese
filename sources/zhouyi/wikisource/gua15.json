{
 "title": "周易/謙",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E8%AC%99",
 "revision": "2106142",
 "fetched_at": "2026-11-02T12:49:10.295633+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "谦"
  },
  {
   "type": "p",
   "text": "艮下坤上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "谦：亨，君子有终。"
  },
  {
   "type": "ol",
   "text": "初六：谦谦君子，用涉大川，吉。"
  },
  {
   "type": "ol",
   "text": "六二：鸣谦，贞吉。"
  },
  {
   "type": "ol",
   "text": "九三：劳谦君子，有终吉。"
  },
  {
   "type": "ol",
   "text": "六四：无不利，㧑谦。"
  },
  {
   "type": "ol",
   "text": "六五：不富，以其邻，利用侵伐，无不利。"
  },
  {
   "type": "ol",
   "text": "上六：鸣谦，利用行师，征邑国。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "谦，亨，天道下济而光明，地道卑而上行。天道亏盈而益谦，地道变盈而流谦，鬼神害盈而福谦，人道恶盈而好谦。谦尊而光，卑而不可逾，君子之终也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "地中有山，谦；君子以裒多益寡，称物平施。"
  },
  {
   "type": "ol",
   "text": "谦谦君子，卑以自牧也。"
  },
  {
   "type": "ol",
   "text": "鸣谦贞吉，中心得也。"
  },
  {
   "type": "ol",
   "text": "劳谦君子，万民服也。"
  },
  {
   "type": "ol",
   "text": "无不利㧑谦；不违则也。"
  },
  {
   "type": "ol",
   "text": "利用侵伐，征不服也。"
  },
  {
   "type": "ol",
   "text": "鸣谦，志未得也。可用行师，征邑国也。"
  }
 ],
 "text_sha256": "9ac9e19988c52529f0e497f3febbcc47fa56165f22f1a8dceb5caae067a5abb4"
}
