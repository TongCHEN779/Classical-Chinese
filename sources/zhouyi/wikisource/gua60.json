{
 "title": "周易/節",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E7%AF%80",
 "revision": "2405027",
 "fetched_at": "2026-11-02T12:55:19.645313+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "节"
  },
  {
   "type": "p",
   "text": "兑下坎上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "节：亨。苦节不可贞。"
  },
  {
   "type": "ol",
   "text": "初九：不出户庭，无咎。"
  },
  {
   "type": "ol",
   "text": "九二：不出门庭，凶。"
  },
  {
   "type": "ol",
   "text": "六三：不节若，则嗟若，无咎。"
  },
  {
   "type": "ol",
   "text": "六四：安节，亨。"
  },
  {
   "type": "ol",
   "text": "九五：甘节，吉；往有尚。"
  },
  {
   "type": "ol",
   "text": "上六：苦节，贞凶，悔亡。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "节，亨，刚柔分，而刚得中。苦节不可贞，其道穷也。说以行险，当位以节，中正以通。天地节而四时成，节以制度，不伤财，不害民。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "泽上有水，节；君子以制数度，议德行。"
  },
  {
   "type": "ol",
   "text": "不出户庭，知通塞也。"
  },
  {
   "type": "ol",
   "text": "不出门庭，失时极也。"
  },
  {
   "type": "ol",
   "text": "不节之嗟，又谁咎也。"
  },
  {
   "type": "ol",
   "text": "安节之亨，承上道也。"
  },
  {
   "type": "ol",
   "text": "甘节之吉，居位中也。"
  },
  {
   "type": "ol",
   "text": "苦节贞凶，其道穷也。"
  }
 ],
 "text_sha256": "4d259976176b9b1f1bcf00d22175e6804bee3fd182f1cccf4aac74ec4d1d1dd8"
}
