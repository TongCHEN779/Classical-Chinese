{
 "title": "周易/革",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E9%9D%A9",
 "revision": "10643173",
 "fetched_at": "2026-11-02T12:54:21.918026+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "革"
  },
  {
   "type": "p",
   "text": "离下兑上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "革：已日乃孚，元亨。利贞。悔亡。"
  },
  {
   "type": "ol",
   "text": "初九：巩用黄牛之革。"
  },
  {
   "type": "ol",
   "text": "六二：已日乃革之，征吉，无咎。"
  },
  {
   "type": "ol",
   "text": "九三：征凶，贞厉，革言三就，有孚。"
  },
  {
   "type": "ol",
   "text": "九四：悔亡，有孚改命，吉。"
  },
  {
   "type": "ol",
   "text": "九五：大人虎变，未占有孚。"
  },
  {
   "type": "ol",
   "text": "上六：君子豹变，小人革面，征凶，居贞吉。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "革，水火相息，二女同居，其志不相得，曰革。已日乃孚；革而信也。文明以说，大亨以正，革而当，其悔乃亡。天地革而四时成，汤武革命，顺乎天而应乎人，革之时义大矣哉！"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "泽中有火，革；君子以治历明时。"
  },
  {
   "type": "ol",
   "text": "巩用黄牛，不可以有为也。"
  },
  {
   "type": "ol",
   "text": "已日革之，行有嘉也。"
  },
  {
   "type": "ol",
   "text": "革言三就，又何之矣。"
  },
  {
   "type": "ol",
   "text": "改命之吉，信志也。"
  },
  {
   "type": "ol",
   "text": "大人虎变，其文炳也。"
  },
  {
   "type": "ol",
   "text": "君子豹变，其文蔚也。小人革面，顺以从君也。"
  }
 ],
 "text_sha256": "e646a0c6c10e16e82abd4be22fb47b9e308ba7d78d58705c825b5fc050f297c2"
}
