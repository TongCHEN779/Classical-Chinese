{
 "title": "周易/剝",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%89%9D",
 "revision": "10645800",
 "fetched_at": "2026-11-02T12:51:04.833930+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "剥"
  },
  {
   "type": "p",
   "text": "坤下艮上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "剥：不利。有攸往。"
  },
  {
   "type": "ol",
   "text": "初六：剥床以足，蔑贞凶。"
  },
  {
   "type": "ol",
   "text": "六二：剥床以辨，蔑贞凶。"
  },
  {
   "type": "ol",
   "text": "六三：剥之，无咎。"
  },
  {
   "type": "ol",
   "text": "六四：剥床以肤，凶。"
  },
  {
   "type": "ol",
   "text": "六五：贯鱼，以宫人宠，无不利。"
  },
  {
   "type": "ol",
   "text": "上九：硕果不食，君子德车，小人剥庐。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "剥，剥也，柔变刚也。不利有攸往，小人长也。顺而止之，观象也。君子尚消息盈虚，天行也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "山附地上，剥；上以厚下，安宅。"
  },
  {
   "type": "ol",
   "text": "剥床以足，以灭下也。"
  },
  {
   "type": "ol",
   "text": "剥床以辨，未有与也。"
  },
  {
   "type": "ol",
   "text": "剥之无咎，失上下也。"
  },
  {
   "type": "ol",
   "text": "剥床以肤，切近灾也。"
  },
  {
   "type": "ol",
   "text": "以宫人宠，终无尤也。"
  },
  {
   "type": "ol",
   "text": "君子得舆，民所载也。小人剥庐，终不可用也。"
  }
 ],
 "text_sha256": "e9b98c2a121531f80f7691370e6dd11d3f9e368bfa9253582eafc987e7117188"
}
