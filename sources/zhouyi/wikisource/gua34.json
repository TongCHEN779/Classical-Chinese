{
 "title": "周易/大壯",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%A4%A7%E5%A3%AF",
 "revision": "10646529",
 "fetched_at": "2026-11-02T12:53:02.805247+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "大壮"
  },
  {
   "type": "p",
   "text": "干下震上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "大壮：利贞。"
  },
  {
   "type": "ol",
   "text": "初九：壮于趾，征凶，有孚。"
  },
  {
   "type": "ol",
   "text": "九二：贞吉。"
  },
  {
   "type": "ol",
   "text": "九三：小人用壮，君子用罔，贞厉。羝羊触藩，羸其角。"
  },
  {
   "type": "ol",
   "text": "九四：贞吉悔亡，藩决不羸，壮于大轝之腹。"
  },
  {
   "type": "ol",
   "text": "六五：丧羊于易，无悔。"
  },
  {
   "type": "ol",
   "text": "上六：羝羊触藩，不能退，不能遂，无攸利，艰则吉。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "大壮，大者壮也。刚以动，故壮。大壮利贞；大者正也。正大而天地之情可见矣！"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "雷在天上，大壮；君子以非礼弗履。"
  },
  {
   "type": "ol",
   "text": "壮于趾，其孚穷也。"
  },
  {
   "type": "ol",
   "text": "九二贞吉，以中也。"
  },
  {
   "type": "ol",
   "text": "小人用壮，君子罔也。"
  },
  {
   "type": "ol",
   "text": "藩决不羸，尚往也。"
  },
  {
   "type": "ol",
   "text": "丧羊于易，位不当也。"
  },
  {
   "type": "ol",
   "text": "不能退，不能遂，不详也。艰则吉，咎不长也。"
  }
 ],
 "text_sha256": "58dc5599cd4cedd8c488477d3185afdb4235b59205b2614c347ca9b7d90c30f6"
}
