{
 "title": "周易/家人",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%AE%B6%E4%BA%BA",
 "revision": "2405005",
 "fetched_at": "2026-11-02T12:53:06.995033+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "家人"
  },
  {
   "type": "p",
   "text": "离下巽上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "家人：利女贞。"
  },
  {
   "type": "ol",
   "text": "初九：闲有家，悔亡。"
  },
  {
   "type": "ol",
   "text": "六二：无攸遂，在中馈，贞吉。"
  },
  {
   "type": "ol",
   "text": "九三：家人嗃嗃，悔厉吉；妇子嘻嘻，终吝。"
  },
  {
   "type": "ol",
   "text": "六四：富家，大吉。"
  },
  {
   "type": "ol",
   "text": "九五：王假有家，勿恤。吉。"
  },
  {
   "type": "ol",
   "text": "上九：有孚威如，终吉。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "家人，女正位乎内，男正位乎外，男女正，天地之大义也。家人有严君焉，父母之谓也。父父，子子，兄兄，弟弟，夫夫，妇妇，而家道正；正家而天下定矣。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "风自火出，家人；君子以言有物，而行有恒。"
  },
  {
   "type": "ol",
   "text": "闲有家，志未变也。"
  },
  {
   "type": "ol",
   "text": "六二之吉，顺以巽也。"
  },
  {
   "type": "ol",
   "text": "家人嗃嗃，未失也；妇子嘻嘻，失家节也。"
  },
  {
   "type": "ol",
   "text": "富家大吉，顺在位也。"
  },
  {
   "type": "ol",
   "text": "王假有家，交相爱也。"
  },
  {
   "type": "ol",
   "text": "威如之吉，反身之谓也。"
  }
 ],
 "text_sha256": "1fa24d56fb7b21dbf837b73ef65b24b6687f66b7c1e24b96bad920bf7f46525d"
}
