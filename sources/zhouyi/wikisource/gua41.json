{
 "title": "周易/損",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E6%90%8D",
 "revision": "10646704",
 "fetched_at": "2026-11-02T12:53:11.228189+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "损"
  },
  {
   "type": "p",
   "text": "兑下艮上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "损：有孚，元吉。无咎，可贞，利有攸往。曷之用？二簋可用享。"
  },
  {
   "type": "ol",
   "text": "初九：祀事遄往，无咎，酌损之。"
  },
  {
   "type": "ol",
   "text": "九二：利贞，征凶，弗损益之。"
  },
  {
   "type": "ol",
   "text": "六三：三人行，则损一人；一人行，则得其友。"
  },
  {
   "type": "ol",
   "text": "六四：损其疾，使遄有喜，无咎。"
  },
  {
   "type": "ol",
   "text": "六五：或益之，十朋之龟弗克违，元吉。"
  },
  {
   "type": "ol",
   "text": "上九：弗损益之，无咎，贞吉，利有攸往，得臣无家。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "损，损下益上，其道上行。损而有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享；二簋应有时。损刚益柔有时，损益盈虚，与时偕行。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "山下有泽，损；君子以惩忿窒欲。"
  },
  {
   "type": "ol",
   "text": "已事遄往，尚合志也。"
  },
  {
   "type": "ol",
   "text": "九二利贞，中以为志也。"
  },
  {
   "type": "ol",
   "text": "一人行，三则疑也。"
  },
  {
   "type": "ol",
   "text": "损其疾，亦可喜也。"
  },
  {
   "type": "ol",
   "text": "六五元吉，自上佑也。"
  },
  {
   "type": "ol",
   "text": "弗损益之，大得志也。"
  }
 ],
 "text_sha256": "72e0d4ee0db401194707d9be620fc14e46c27df580794b0962cb16795c885070"
}
