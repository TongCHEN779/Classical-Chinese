{
 "title": "周易/豫",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E8%B1%AB",
 "revision": "10645735",
 "fetched_at": "2026-11-02T12:49:11.537369+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "豫"
  },
  {
   "type": "p",
   "text": "坤下震上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "豫：利建侯行师。"
  },
  {
   "type": "ol",
   "text": "初六：鸣豫，凶。"
  },
  {
   "type": "ol",
   "text": "六二：介于石，不终日，贞吉。"
  },
  {
   "type": "ol",
   "text": "六三：盱豫，悔。迟有悔。"
  },
  {
   "type": "ol",
   "text": "九四：由豫，大有得。勿疑。朋盍戠。"
  },
  {
   "type": "ol",
   "text": "六五：贞疾，恒不死。"
  },
  {
   "type": "ol",
   "text": "上六：冥豫，成有渝，无咎。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "豫，刚应而志行，顺以动，豫。豫，顺以动，故天地如之，而况建侯行师乎？天地以顺动，故日月不过，而四时不忒；圣人以顺动，则刑罚清而民服。豫之时义大矣哉！"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "雷出地奋，豫。先王以作乐崇德，殷荐之上帝，以配祖考。"
  },
  {
   "type": "ol",
   "text": "初六鸣豫，志穷凶也。"
  },
  {
   "type": "ol",
   "text": "不终日，贞吉；以中正也。"
  },
  {
   "type": "ol",
   "text": "盱豫有悔，位不当也。"
  },
  {
   "type": "ol",
   "text": "由豫，大有得；志大行也。"
  },
  {
   "type": "ol",
   "text": "六五贞疾，乘刚也。恒不死，中未亡也。"
  },
  {
   "type": "ol",
   "text": "冥豫在上，何可长也。"
  }
 ],
 "text_sha256": "bb15eaac3a1400ddd234f8e6d5708c5f7be6083694726d943b616c5fd438e96c"
}
