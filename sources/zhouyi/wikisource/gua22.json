{
 "title": "周易/賁",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E8%B3%81",
 "revision": "2405035",
 "fetched_at": "2026-11-02T12:51:03.735776+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "贲"
  },
  {
   "type": "p",
   "text": "离下艮上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "贲：亨。小利有攸往。"
  },
  {
   "type": "ol",
   "text": "初九：贲其趾，舍车而徒。"
  },
  {
   "type": "ol",
   "text": "六二：贲其须。"
  },
  {
   "type": "ol",
   "text": "九三：贲如濡如，永贞吉。"
  },
  {
   "type": "ol",
   "text": "六四：贲如皤如，白马翰如，匪寇婚媾。"
  },
  {
   "type": "ol",
   "text": "六五：贲于丘园，束帛戋戋，吝，终吉。"
  },
  {
   "type": "ol",
   "text": "上九：白贲，无咎。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "贲，亨；柔来而文刚，故亨。分刚上而文柔，故小利有攸往。刚柔交错，天文也；文明以止，人文也。观乎天文，以察时变；观乎人文，以化成天下。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "山下有火，贲；君子以明庶政，无敢折狱。"
  },
  {
   "type": "ol",
   "text": "舍车而徒，义弗乘也。"
  },
  {
   "type": "ol",
   "text": "贲其须，与上兴也。"
  },
  {
   "type": "ol",
   "text": "永贞之吉，终莫之陵也。"
  },
  {
   "type": "ol",
   "text": "六四，当位疑也。匪寇婚媾，终无尤也。"
  },
  {
   "type": "ol",
   "text": "六五之吉，有喜也。"
  },
  {
   "type": "ol",
   "text": "白贲无咎，上得志也。"
  }
 ],
 "text_sha256": "e80cebe7ac546859f7fde31403e83a718d02d7be026bd276752b5deb3b83eecf"
}
