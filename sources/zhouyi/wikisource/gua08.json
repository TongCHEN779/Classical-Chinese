{
 "title": "周易/比",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E6%AF%94",
 "revision": "10645543",
 "fetched_at": "2026-11-02T12:49:01.972330+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "比"
  },
  {
   "type": "p",
   "text": "坤下坎上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "比：吉。原筮元永贞，无咎。不宁方来，后夫凶。"
  },
  {
   "type": "ol",
   "text": "初六：有孚，比之，无咎。有孚盈缶，终来有它，吉。"
  },
  {
   "type": "ol",
   "text": "六二：比之自内，贞吉。"
  },
  {
   "type": "ol",
   "text": "六三：比之匪人。"
  },
  {
   "type": "ol",
   "text": "六四：外比之，贞吉。"
  },
  {
   "type": "ol",
   "text": "九五：显比。王用三驱，失前禽，邑人不诫，吉。"
  },
  {
   "type": "ol",
   "text": "上六：比之无首，凶。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "比，吉也。比，辅也，下顺从也。原筮，元永贞，无咎，以刚中也。不宁方来，上下应也。后夫凶，其道穷也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "地上有水，比；先王以建万国，亲诸侯。"
  },
  {
   "type": "ol",
   "text": "比之初六，有它吉也。"
  },
  {
   "type": "ol",
   "text": "比之自内，不自失也。"
  },
  {
   "type": "ol",
   "text": "比之匪人，不亦伤乎！"
  },
  {
   "type": "ol",
   "text": "外比于贤，以从上也。"
  },
  {
   "type": "ol",
   "text": "显比之吉，位正中也。舍逆取顺，失前禽也。邑人不诫，上使中也。"
  },
  {
   "type": "ol",
   "text": "比之无首，无所终也。"
  }
 ],
 "text_sha256": "99760f1fefa756f2a11c84d97678483143544322bbc171f69808a978bf4cbbab"
}
