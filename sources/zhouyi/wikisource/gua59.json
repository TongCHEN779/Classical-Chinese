{
 "title": "周易/渙",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E6%B8%99",
 "revision": "10647580",
 "fetched_at": "2026-11-02T12:55:18.543023+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "涣"
  },
  {
   "type": "p",
   "text": "坎下巽上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "涣：亨，王假有庙，利涉大川，利贞。"
  },
  {
   "type": "ol",
   "text": "初六：用拯马壮，吉，悔亡。"
  },
  {
   "type": "ol",
   "text": "九二：涣奔其机，悔亡。"
  },
  {
   "type": "ol",
   "text": "六三：涣其躬，无悔。"
  },
  {
   "type": "ol",
   "text": "六四：涣其群，元吉。涣有丘，匪夷所思。"
  },
  {
   "type": "ol",
   "text": "九五：涣汗其大号，涣王居，无咎。"
  },
  {
   "type": "ol",
   "text": "上九：涣其血，去逖出，无咎。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "涣，亨。刚来而不穷，柔得位乎外而上同。王假有庙，王乃在中也。利涉大川，乘木有功也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "风行水上，涣；先王以享于帝立庙。"
  },
  {
   "type": "ol",
   "text": "初六之吉，顺也。"
  },
  {
   "type": "ol",
   "text": "涣奔其机，得愿也。"
  },
  {
   "type": "ol",
   "text": "涣其躬，志在外也。"
  },
  {
   "type": "ol",
   "text": "涣其群，元吉；光大也。"
  },
  {
   "type": "ol",
   "text": "王居无咎，正位也。"
  },
  {
   "type": "ol",
   "text": "涣其血，远害也。"
  }
 ],
 "text_sha256": "49435cfada48e294b916be25b528e43f65f69a8961b1b234de2083e72f873506"
}
