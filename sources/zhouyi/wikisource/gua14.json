{
 "title": "周易/大有",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%A4%A7%E6%9C%89",
 "revision": "10645712",
 "fetched_at": "2026-11-02T12:49:09.204631+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "大有"
  },
  {
   "type": "p",
   "text": "干下离上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "大有：元亨。"
  },
  {
   "type": "ol",
   "text": "初九：无交害，匪咎，艰则无咎。"
  },
  {
   "type": "ol",
   "text": "九二：大轝以载，有攸往，无咎。"
  },
  {
   "type": "ol",
   "text": "九三：公用亨于天子，小人弗克。"
  },
  {
   "type": "ol",
   "text": "九四：匪其尫，无咎。"
  },
  {
   "type": "ol",
   "text": "六五：厥孚交如，威如；吉。"
  },
  {
   "type": "ol",
   "text": "上九：自天佑之，吉无不利。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "大有，柔得尊位，大中而上下应之，曰大有。其德刚健而文明，应乎天而时行，是以元亨。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "火在天上，大有；君子以遏恶扬善，顺天休命。"
  },
  {
   "type": "ol",
   "text": "大有初九，无交害也。"
  },
  {
   "type": "ol",
   "text": "大轝以载，积中不败也。"
  },
  {
   "type": "ol",
   "text": "公用亨于天子，小人害也。"
  },
  {
   "type": "ol",
   "text": "匪其彭，无咎；明辨晰也。"
  },
  {
   "type": "ol",
   "text": "厥孚交如，信以发志也。威如之吉，易而无备也。"
  },
  {
   "type": "ol",
   "text": "大有上吉，自天佑也。"
  }
 ],
 "text_sha256": "878ae673a00bebf37e2b74ecf3d502de78cff9811f76eb78a59b9c3f418c8030"
}
