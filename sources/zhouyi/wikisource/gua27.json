{
 "title": "周易/頤",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E9%A0%A4",
 "revision": "10643091",
 "fetched_at": "2026-11-02T12:51:09.739446+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "颐"
  },
  {
   "type": "p",
   "text": "震下艮上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "颐：贞吉。观颐，自求口实。"
  },
  {
   "type": "ol",
   "text": "初九：舍尔灵龟，观我朵颐，凶。"
  },
  {
   "type": "ol",
   "text": "六二：颠颐，拂经，于丘颐，征凶。"
  },
  {
   "type": "ol",
   "text": "六三：拂颐，贞凶，十年勿用，无攸利。"
  },
  {
   "type": "ol",
   "text": "六四：颠颐吉，虎视眈眈，其欲逐逐，无咎。"
  },
  {
   "type": "ol",
   "text": "六五：拂经，居贞吉，不可涉大川。"
  },
  {
   "type": "ol",
   "text": "上九：由颐，厉吉，利涉大川。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "颐贞吉，养正则吉也。观颐，观其所养也；自求口实，观其自养也。天地养万物，圣人养贤，以及万民；颐之时大矣哉！"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "山下有雷，颐；君子以慎言语，节饮食。"
  },
  {
   "type": "ol",
   "text": "观我朵颐，亦不足贵也。"
  },
  {
   "type": "ol",
   "text": "六二征凶，行失类也。"
  },
  {
   "type": "ol",
   "text": "十年勿用，道大悖也。"
  },
  {
   "type": "ol",
   "text": "颠颐之吉，上施光也。"
  },
  {
   "type": "ol",
   "text": "居贞之吉，顺以从上也。"
  },
  {
   "type": "ol",
   "text": "由颐厉吉，大有庆也。"
  }
 ],
 "text_sha256": "854c523a622988f60bf42e3253474451ae606b4549b1e714b0ea8d0a1ab2aedb"
}
