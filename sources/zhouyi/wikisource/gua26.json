 "title": "周易/大畜",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E5%A4%A7%E7%95%9C",
 "revision": "10646304",
 "fetched_at": "2026-11-02T12:51:08.572494+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "大畜"
  },
  {
   "type": "p",
   "text": "干下艮上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "大畜：利贞，不家食吉，利涉大川。"
  },
  {
   "type": "ol",
   "text": "初九：有厉利已。"
  },
  {
   "type": "ol",
   "text": "九二：舆说輹。"
  },
  {
   "type": "ol",
   "text": "九三：良马逐，利艰贞，吉。日闲舆卫，利有攸往。"
  },
  {
   "type": "ol",
   "text": "六四：童牛之告，元吉。"
  },
  {
   "type": "ol",
   "text": "六五：豮豕之牙，吉。"
  },
  {
   "type": "ol",
   "text": "上九：何天之衢，亨。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "大畜，刚健笃实辉光，日新其德，刚上而尚贤。能止健，大正也。不家食吉，养贤也。利涉大川，应乎天也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "天在山中，大畜；君子以多识前言往行，以畜其德。"
  },
  {
   "type": "ol",
   "text": "有厉利已，不犯灾也。"
  },
  {
   "type": "ol",
   "text": "舆说輹，中无尤也。"
  },
  {
   "type": "ol",
   "text": "利有攸往，上合志也。"
  },
  {
   "type": "ol",
   "text": "六四元吉，有喜也。"
  },
  {
   "type": "ol",
   "text": "六五之吉，有庆也。"
  },
  {
   "type": "ol",
   "text": "何天之衢，道大行也。"
  }
 ],
 "text_sha256": "a0e07d273c0b9c099e84290edfef794725cd6fc7eb16bf1d49277cc628c92f54"
}
