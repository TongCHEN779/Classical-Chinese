{
 "title": "周易/晉",
 "url": "https://zh.wikisource.org/zh-hans/%E5%91%A8%E6%98%93/%E6%99%89",
 "revision": "10646579",
 "fetched_at": "2026-11-02T12:53:04.101501+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "晋"
  },
  {
   "type": "p",
   "text": "坤下离上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "晋：康侯用锡马蕃庶，昼日三接。"
  },
  {
   "type": "ol",
   "text": "初六：晋如，摧如，贞吉。罔孚，裕无咎。"
  },
  {
   "type": "ol",
   "text": "六二：晋如，愁如，贞吉。受兹介福，于其王母。"
  },
  {
   "type": "ol",
   "text": "六三：众允，悔亡。"
  },
  {
   "type": "ol",
   "text": "九四：晋如鼫鼠，贞厉。"
  },
  {
   "type": "ol",
   "text": "六五：悔亡，矢得勿恤，往吉无不利。"
  },
  {
   "type": "ol",
   "text": "上九：晋其角，维用伐邑，厉吉无咎，贞吝。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "晋，进也。明出地上，顺而丽乎大明，柔进而上行。是以康侯用锡马蕃庶，昼日三接也。"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "明出地上，晋；君子以自昭明德。"
  },
  {
   "type": "ol",
   "text": "晋如，摧如；独行正也。裕无咎；未受命也。"
  },
  {
   "type": "ol",
   "text": "受兹介福，以中正也。"
  },
  {
   "type": "ol",
   "text": "众允之志，上行也。"
  },
  {
   "type": "ol",
   "text": "鼫鼠贞厉，位不当也。"
  },
  {
   "type": "ol",
   "text": "失得勿恤，往有庆也。"
  },
  {
   "type": "ol",
   "text": "维用伐邑，道未光也。"
  }
 ],
 "text_sha256": "e1611aa137baf62b7464823a216094a26fdf4501357fbebef737709164b263cf"
}
