 "fetched_at": "2026-11-02T12:55:17.282041+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "兑"
  },
  {
   "type": "p",
   "text": "兑下兑上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "兑：亨。利贞。"
  },
  {
   "type": "ol",
   "text": "初九：和兑，吉。"
  },
  {
   "type": "ol",
   "text": "九二：孚兑，吉，悔亡。"
  },
  {
   "type": "ol",
   "text": "六三：来兑，凶。"
  },
  {
   "type": "ol",
   "text": "九四：商兑，未宁，介疾有喜。"
  },
  {
   "type": "ol",
   "text": "九五：孚于剥，有厉。"
  },
  {
   "type": "ol",
   "text": "上六：引兑。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "兑，说也。刚中而柔外，说以利贞，是以顺乎天，而应乎人。说以先民，民忘其劳；说以犯难，民忘其死；说之大，民劝矣哉！"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "丽泽，兑；君子以朋友讲习。"
  },
  {
   "type": "ol",
   "text": "和兑之吉，行未疑也。"
  },
  {
   "type": "ol",
   "text": "孚兑之吉，信志也。"
  },
  {
   "type": "ol",
   "text": "来兑之凶，位不当也。"
  },
  {
   "type": "ol",
   "text": "九四之喜，有庆也。"
  },
  {
   "type": "ol",
   "text": "孚于剥，位正当也。"
  },
  {
   "type": "ol",
   "text": "上六引兑，未光也。"
  }
 ],
 "text_sha256": "a839d97169750d292e2929e74d329a6482ce9881e20a5e2a7e73ee90760c70a6"
}
