 "revision": "10646826",
 "fetched_at": "2026-11-02T12:54:16.001680+00:00",
 "blocks": [
  {
   "type": "head",
   "text": "姤"
  },
  {
   "type": "p",
   "text": "巽下干上"
  },
  {
   "type": "head",
   "text": "易经："
  },
  {
   "type": "ul",
   "text": "姤：女壮，勿用取女。"
  },
  {
   "type": "ol",
   "text": "初六：系于金柅，贞吉，有攸往，见凶，羸豕，孚，蹢躅。"
  },
  {
   "type": "ol",
   "text": "九二：包有鱼，无咎，不利宾。"
  },
  {
   "type": "ol",
   "text": "九三：臀无肤，其行次且，厉，无大咎。"
  },
  {
   "type": "ol",
   "text": "九四：包无鱼，起凶。"
  },
  {
   "type": "ol",
   "text": "九五：以杞包瓜，含章，有陨自天。"
  },
  {
   "type": "ol",
   "text": "上九：姤其角，吝，无咎。"
  },
  {
   "type": "head",
   "text": "彖曰："
  },
  {
   "type": "ul",
   "text": "姤，遇也，柔遇刚也。勿用取女，不可与长也。天地相遇，品物咸章也。刚遇中正，天下大行也。姤之时义大矣哉！"
  },
  {
   "type": "head",
   "text": "象曰："
  },
  {
   "type": "ul",
   "text": "天下有风，姤；后以施命诰四方。"
  },
  {
   "type": "ol",
   "text": "系于金柅，柔道牵也。"
  },
  {
   "type": "ol",
   "text": "包有鱼，义不及宾也。"
  },
  {
   "type": "ol",
   "text": "其行次且，行未牵也。"
  },
  {
   "type": "ol",
   "text": "无鱼之凶，远民也。"
  },
  {
   "type": "ol",
   "text": "九五含章，中正也。有陨自天，志不舍命也。"
  },
  {
   "type": "ol",
   "text": "姤其角，上穷吝也。"
  }
 ],
 "text_sha256": "0968dffc8ad6c5914175e18d75c8908788187772bbb7e1e64e723f02f1426e6a"
}
