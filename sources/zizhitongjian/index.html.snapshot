<div class="mw-heading mw-heading2"><h2 id="漢紀"><span id=".E6.BC.A2.E7.B4.80"></span>漢紀</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=%E8%B3%87%E6%B2%BB%E9%80%9A%E9%91%91&amp;action=edit&amp;section=3" title="编辑章节：漢紀"><span>编辑</span></a><span class="mw-editsection-bracket">]</span></span></div>
