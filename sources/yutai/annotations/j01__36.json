{
 "start": 36,
 "items": [
  {
   "题解": "汉末无名氏所作长篇叙事诗，即《孔雀东南飞》，原有小序说明本事。写庐江府小吏焦仲卿与妻刘兰芝被母亲拆散，兰芝投水、仲卿自缢，死后合葬、化为鸳鸯，情节动人，被誉为乐府双璧之一。",
   "段落": [
    {
     "译": [
      "汉末建安年间，庐江府小吏焦仲卿的妻子刘氏，被仲卿的母亲遣回娘家，她立誓不再改嫁。",
      "她的娘家逼迫她改嫁，她便投水而死。",
      "仲卿听说后，也在庭院的树上自缢。",
      "当时的人为此哀伤，写成这首诗。"
     ],
     "注": [
      "建安：东汉献帝年号（196—220）。",
      "庐江府：庐江郡的官府，治所在今安徽境内。",
      "小吏：低级官吏。"
     ]
    },
    {
     "译": [
      "孔雀向东南飞去，飞出五里就要徘徊一回。"
     ],
     "注": [
      "起兴：以孔雀徘徊喻依依不舍的离别。"
     ]
    },
    {
     "译": [
      "十三岁就会织白绢，十四岁学会裁剪衣裳。"
     ],
     "注": [
      "素：白色生绢。"
     ]
    },
    {
     "译": [
      "十五岁弹奏箜篌，十六岁诵读诗书。"
     ],
     "注": [
      "箜篌：古代弦乐器。"
     ]
    },
    {
     "译": [
      "十七岁做了你的妻子，心中常常悲苦。"
     ],
     "注": []
    },
    {
     "译": [
      "你既然做了府里的小吏，操守坚定，情意不变。"
     ],
     "注": [
      "守节：坚守职守。"
     ]
    },
    {
     "译": [
      "我独自守着空房，相见的日子常常稀少。"
     ],
     "注": []
    },
    {
     "译": [
      "鸡一叫就上机织布，夜夜不得歇息。"
     ],
     "注": []
    },
    {
     "译": [
      "三天织断五匹，婆婆却还嫌我太慢。"
     ],
     "注": [
      "大人：旧时对尊长的称呼，此指婆婆。"
     ]
    },
    {
     "译": [
      "不是我织得慢，是你家的媳妇难当。"
     ],
     "注": []
    },
    {
     "译": [
      "我实在承受不了这样的驱使，留下来也没有什么用处。"
     ],
     "注": []
    },
    {
     "译": [
      "你可以禀告公婆，趁早把我遣送回家。"
     ],
     "注": [
      "公姥：公公与婆婆。"
     ]
    },
    {
     "译": [
      "府吏听说了这件事，到堂上禀告母亲。"
     ],
     "注": [
      "阿母：母亲。",
      "启：禀告。"
     ]
    },
    {
     "译": [
      "儿子本来就福薄命贱，幸而得到这样一个妻子。"
     ],
     "注": [
      "薄禄相：命薄、官位低微的面相。"
     ]
    },
    {
     "译": [
      "我们结发同枕席，死后到黄泉也要做伴。"
     ],
     "注": []
    },
    {
     "译": [
      "一起生活才两三年，刚刚开始，还算不得长久。"
     ],
     "注": []
    },
    {
     "译": [
      "她的品行没有偏差，怎么竟得不到你的欢心。"
     ],
     "注": []
    },
    {
     "译": [
      "母亲对府吏说，你为什么如此拘泥于小情小意。"
     ],
     "注": [
      "区区：拘泥、见识狭小。"
     ]
    },
    {
     "译": [
      "这个媳妇不讲礼节，一举一动都自作主张。"
     ],
     "注": []
    },
    {
     "译": [
      "我心里早就积了怨气，你怎能再由着她。"
     ],
     "注": []
    },
    {
     "译": [
      "东邻有个贤惠的女子，名叫秦罗敷。"
     ],
     "注": [
      "秦罗敷：汉乐府《陌上桑》中的美女名，此借称。"
     ]
    },
    {
     "译": [
      "她可爱得无与伦比，母亲替你去求娶她。"
     ],
     "注": []
    },
    {
     "译": [
      "你就赶快把她遣走，遣了她，千万别留。"
     ],
     "注": []
    },
    {
     "译": [
      "府吏直身长跪回答，恭敬地禀告母亲。"
     ],
     "注": [
      "长跪：直身而跪，表示恭敬。"
     ]
    },
    {
     "译": [
      "如今若遣走这个妻子，我到老也不会再娶。"
     ],
     "注": []
    },
    {
     "译": [
      "母亲听了这话，捶着床大发雷霆。"
     ],
     "注": []
    },
    {
     "译": [
      "小子你无所畏惧，竟敢帮着媳妇说话。"
     ],
     "注": []
    },
    {
     "译": [
      "我已经对她断了恩义，绝不会答应你。"
     ],
     "注": []
    },
    {
     "译": [
      "府吏默默无声，拜了两拜退回房中。"
     ],
     "注": []
    },
    {
     "译": [
      "开口对新妇说话，却哽咽得说不出。"
     ],
     "注": []
    },
    {
     "译": [
      "我并不是自己要赶你走，是母亲逼迫。"
     ],
     "注": []
    },
    {
     "译": [
      "你只管暂时先回娘家，我现在姑且去府里报到。"
     ],
     "注": []
    },
    {
     "译": [
      "不久就会回来，回来一定接你。"
     ],
     "注": []
    },
    {
     "译": [
      "就拿这话宽宽你的心，千万别违背我的话。"
     ],
     "注": []
    },
    {
     "译": [
      "新妇对府吏说，不要再这样纷乱烦扰了。"
     ],
     "注": []
    },
    {
     "译": [
      "当年初阳之月，我从谢家来到你们贵门。"
     ],
     "注": [
      "初阳岁：指冬末春初的岁首，一说为十一月。",
      "谢家：妻自称其家，谢姓。"
     ]
    },
    {
     "译": [
      "侍奉公婆依礼而行，一举一动哪敢擅自作主。"
     ],
     "注": []
    },
    {
     "译": [
      "日夜勤劳不息，孤苦伶仃，满身辛苦。"
     ],
     "注": []
    },
    {
     "译": [
      "自以为没有罪过，能尽心供养报答大恩。"
     ],
     "注": []
    },
    {
     "译": [
      "如今仍被驱赶遣送，还说什么再回来。"
     ],
     "注": []
    },
    {
     "译": [
      "我有一件绣腰襦，繁花盛美，自生光彩。"
     ],
     "注": [
      "襦：短衣。",
      "葳蕤：华美繁盛貌。"
     ]
    },
    {
     "译": [
      "还有红罗双层斗帐，四角垂着香囊。"
     ],
     "注": [
      "斗帐：形如覆斗的小帐。"
     ]
    },
    {
     "译": [
      "箱子和帘具有六七十件，系着绿碧色的青丝绳。"
     ],
     "注": []
    },
    {
     "译": [
      "件件各有不同，样样都放在其中。"
     ],
     "注": []
    },
    {
     "译": [
      "人既卑贱，物也鄙陋，不配迎接后来的人。"
     ],
     "注": []
    },
    {
     "译": [
      "留着作赠送之物，今后再没有相会的机缘了。"
     ],
     "注": []
    },
    {
     "译": [
      "请你时时安慰自己，久久不要把我忘了。"
     ],
     "注": []
    },
    {
     "译": [
      "鸡鸣时天色将亮，新妇起身严整梳妆。"
     ],
     "注": []
    },
    {
     "译": [
      "穿上我的绣夹裙，每件都要四五次换试。"
     ],
     "注": []
    },
    {
     "译": [
      "脚下穿着丝鞋，头上玳瑁发簪闪光。"
     ],
     "注": [
      "玳瑁：龟类甲壳，作饰物。"
     ]
    },
    {
     "译": [
      "腰间如流动的白绢，耳上戴着明月珠珰。"
     ],
     "注": [
      "珰：耳饰。"
     ]
    },
    {
     "译": [
      "手指细如削好的葱根，嘴唇红得像含着朱丹。"
     ],
     "注": [
      "削葱根：形容手指洁白纤细。"
     ]
    },
    {
     "译": [
      "纤纤迈着细步，精致美妙，世上无双。"
     ],
     "注": []
    },
    {
     "译": [
      "登堂拜别母亲，母亲听任她离去，毫不挽留。"
     ],
     "注": []
    },
    {
     "译": [
      "从前我做女儿时，从小生长在乡野之中。"
     ],
     "注": []
    },
    {
     "译": [
      "本来就没有受过教养，又愧对你们这贵门人家的儿子。"
     ],
     "注": []
    },
    {
     "译": [
      "受了母亲许多钱帛，却不能胜任母亲的驱使。"
     ],
     "注": []
    },
    {
     "译": [
      "如今回家去，心里挂念母亲在家里操劳。"
     ],
     "注": []
    },
    {
     "译": [
      "退下来与小姑告别，泪水如串珠般落下。"
     ],
     "注": []
    },
    {
     "译": [
      "新妇刚来的时候，小姑才刚扶着床学站。"
     ],
     "注": []
    },
    {
     "译": [
      "今天我被驱遣，小姑已长得和我一样高。"
     ],
     "注": []
    },
    {
     "译": [
      "用心奉养公婆，好好互相扶持。"
     ],
     "注": []
    },
    {
     "译": [
      "到了初七和二十九，嬉戏时不要忘了我。"
     ],
     "注": [
      "初七及下九：古俗初七为七夕，下九指每月十九，妇女嬉游之日。"
     ]
    },
    {
     "译": [
      "出门登上车离去，眼泪落了百多行。"
     ],
     "注": []
    },
    {
     "译": [
      "府吏骑马走在前面，新妇坐车跟在后面。"
     ],
     "注": []
    },
    {
     "译": [
      "车声隐隐，沉重而响亮，一同到了大道口。"
     ],
     "注": [
      "隐隐、甸甸：车行声，形容车声沉重。"
     ]
    },
    {
     "译": [
      "他下马进入车中，低头和她附耳私语。"
     ],
     "注": []
    },
    {
     "译": [
      "我发誓不会与你隔绝，你暂且回家去。"
     ],
     "注": []
    },
    {
     "译": [
      "我现在先去赴府，不久就会回来。"
     ],
     "注": []
    },
    {
     "译": [
      "我对天发誓，绝不辜负你。"
     ],
     "注": []
    },
    {
     "译": [
      "新妇对府吏说，感谢你一片诚挚的心意。"
     ],
     "注": []
    },
    {
     "译": [
      "你既然这样记着我，我盼望你不久就来。"
     ],
     "注": []
    },
    {
     "译": [
      "你要做磐石，我要做蒲苇。"
     ],
     "注": [
      "磐石、蒲苇：磐石坚固不移，蒲苇柔韧，比喻誓言坚定。"
     ]
    },
    {
     "译": [
      "蒲苇柔韧如丝，磐石永不转移。"
     ],
     "注": []
    },
    {
     "译": [
      "我有亲生的父亲和兄长，性情暴烈如雷。"
     ],
     "注": []
    },
    {
     "译": [
      "恐怕他们不肯依我的心意，反而要逆着我，煎熬我的怀抱。"
     ],
     "注": []
    },
    {
     "译": [
      "举手长久地依依惜别，两人情意同样缠绵。"
     ],
     "注": []
    },
    {
     "译": [
      "进了门，上到家堂，进退之间没有颜面。"
     ],
     "注": []
    },
    {
     "译": [
      "母亲大为拍手惊叹，没想到女儿竟自己回来了。"
     ],
     "注": [
      "拊掌：拍手，表惊讶。"
     ]
    },
    {
     "译": [
      "十三岁教你织布，十四岁你就会裁衣。"
     ],
     "注": []
    },
    {
     "译": [
      "十五岁弹箜篌，十六岁懂礼仪。"
     ],
     "注": []
    },
    {
     "译": [
      "十七岁送你出嫁，以为你不会有过错违礼。"
     ],
     "注": []
    },
    {
     "译": [
      "你如今有什么罪过，不被迎接就自己回来了。"
     ],
     "注": []
    },
    {
     "译": [
      "兰芝对母亲惭愧地说，女儿实在没有罪过。"
     ],
     "注": []
    },
    {
     "译": [
      "母亲听了十分悲痛伤心。"
     ],
     "注": []
    },
    {
     "译": [
      "回家十多天，县令派媒人来了。"
     ],
     "注": []
    },
    {
     "译": [
      "说有第三位公子，容貌俊美，世上无双。"
     ],
     "注": [
      "第三郎：县令的三公子。"
     ]
    },
    {
     "译": [
      "年纪才十八九岁，便说他多有才华。"
     ],
     "注": []
    },
    {
     "译": [
      "母亲对女儿说，你可以去应下这门亲事。"
     ],
     "注": []
    },
    {
     "译": [
      "女儿含着泪回答，兰芝刚回家的时候。"
     ],
     "注": []
    },
    {
     "译": [
      "府吏再三叮咛，立誓不分离。"
     ],
     "注": []
    },
    {
     "译": [
      "今天若违背情义，恐怕这事不妥。"
     ],
     "注": []
    },
    {
     "译": [
      "不妨断了来信，慢慢再对他说。"
     ],
     "注": []
    },
    {
     "译": [
      "母亲对媒人说。"
     ],
     "注": []
    },
    {
     "译": [
      "贫贱人家有这个女儿，才出嫁便被遣回家门。"
     ],
     "注": []
    },
    {
     "译": [
      "她配不上做吏人的妻子，怎么能配得上公子。"
     ],
     "注": []
    },
    {
     "译": [
      "希望您多多打听，不要立刻答应。"
     ],
     "注": []
    },
    {
     "译": [
      "媒人去了几天，不久又派县丞来请。"
     ],
     "注": [
      "丞：县丞，县令的佐官。"
     ]
    },
    {
     "译": [
      "说有位兰家的女子，门第出过官宦。"
     ],
     "注": []
    },
    {
     "译": [
      "说有位第五公子，风流俊逸，还没有婚配。"
     ],
     "注": []
    },
    {
     "译": [
      "派县丞做媒人，主簿传达言语。"
     ],
     "注": [
      "主簿：官名，掌文书簿籍。"
     ]
    },
    {
     "译": [
      "直说是太守家，有这样一位公子。"
     ],
     "注": []
    },
    {
     "译": [
      "既然想结为姻亲，所以特来贵府。"
     ],
     "注": []
    },
    {
     "译": [
      "母亲谢绝了媒人。"
     ],
     "注": []
    },
    {
     "译": [
      "女儿先有誓言，老妇怎敢多说。"
     ],
     "注": []
    },
    {
     "译": [
      "哥哥听说了此事，怅然心烦。"
     ],
     "注": []
    },
    {
     "译": [
      "他对妹妹说，你谋划得怎么这样不思量。"
     ],
     "注": []
    },
    {
     "译": [
      "先嫁给府吏，后嫁给公子。"
     ],
     "注": []
    },
    {
     "译": [
      "好坏如同天地之别，足以使你荣耀。"
     ],
     "注": []
    },
    {
     "译": [
      "不嫁这位好郎君，你打算怎么办？"
     ],
     "注": []
    },
    {
     "译": [
      "兰芝仰头回答，道理确实如哥哥所说。"
     ],
     "注": []
    },
    {
     "译": [
      "我出嫁到谢家，中途又回到哥哥门下。"
     ],
     "注": []
    },
    {
     "译": [
      "处置全凭哥哥的心意，哪能自己作主。"
     ],
     "注": []
    },
    {
     "译": [
      "虽然与府吏有约，我与他终究永无缘分。"
     ],
     "注": []
    },
    {
     "译": [
      "马上就答应下来，便可以办婚事。"
     ],
     "注": []
    },
    {
     "译": [
      "媒人下床离去，连声说好，是是。"
     ],
     "注": [
      "诺诺复尔尔：连声答应的样子。"
     ]
    },
    {
     "译": [
      "回去禀告府君。"
     ],
     "注": [
      "府君：对太守的尊称。"
     ]
    },
    {
     "译": [
      "下官奉命出使，谈得十分投缘。"
     ],
     "注": []
    },
    {
     "译": [
      "府君听了，心中大为欢喜。"
     ],
     "注": []
    },
    {
     "译": [
      "翻看历书，又打开书册。"
     ],
     "注": []
    },
    {
     "译": [
      "这个月内最吉利，六合正相呼应。"
     ],
     "注": [
      "六合：古人择日以月建与日辰相合为吉。"
     ]
    },
    {
     "译": [
      "好日子是三十日，今天已是二十七。"
     ],
     "注": []
    },
    {
     "译": [
      "你可以去办婚事了。"
     ],
     "注": []
