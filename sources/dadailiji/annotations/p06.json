{
  "题解": "《夏小正》按月记下星象、动植物的时令变化以及农耕、采集、祭祀等活动。篇中以黄昏或拂晓所见的星位帮助辨认时节，也保存了古人关于鸟兽变化的物候观念。个别名物和残疑字句依本篇清理稿保留，随文说明。",
  "段落": {
    "0": {
      "译": [
        "正月。",
        "蛰伏的动物开始活动。",
        "大雁朝北飞。",
        "野鸡振翅鸣叫。",
        "鱼游到冰层下面，像背着冰一样。",
        "农人绑紧、修整他们的耒。",
        "年初祭祀农具，从此开始用它翻土。",
        "园圃里已看得见韭菜。",
        "这时会刮起强风。",
        "寒季里的日光使冻土消融。",
        "田鼠出洞。",
        "农人一同整治田地。",
        "水獭把捕来的鱼摆开，像在祭祀。",
        "古人说，这时鹰变成鸠。",
        "农人趁融雪带来的湿润开始劳作。",
        "开始在公田服役耕作。",
        "采摘芸草。",
        "名为鞠的星开始出现。",
        "天刚黑时，参星位居中天。",
        "北斗的斗柄垂向下方。",
        "柳树发嫩芽。",
        "梅、杏和山桃开花。",
        "名为缇缟的草本也到了生长的时节。",
        "鸡开始孵卵。"
      ],
      "注": [
        "北乡：面向北方，乡通“向”。",
        "耒：古代翻土农具；纬指捆束整治。",
        "鞠：此处作星名理解，所指未定。",
        "参：参宿，参读 shēn。",
        "县：通“悬”。",
        "杝桃：一类野桃。",
        "缇缟：物名，原句无动词，译文只补出时令之意。"
      ]
    },
    "1": {
      "译": [
        "二月。",
        "到田里去耙耨种黍的地，并依次作业。",
        "开始料理小羊，帮助母羊哺育。",
        "安抚众多女子。",
        "丁亥日，入学操习《万》舞。",
        "用鲔鱼祭祀。"
      ],
      "注": [
        "耰：打碎土块、平整田地，也指覆种。",
        "禅：这里暂按依次交替理解。",
        "初俊羔助厥母粥：字义有疑，姑依羔与母羊的关系译作哺育。",
        "《万》：古代礼仪中的舞。",
        "鲔：古鱼名。"
      ]
    },
    "2": {
      "译": [
        "菜开黄花。",
        "菜蔬茂盛，田里也长出了胡菜。",
        "小虫开始活动，蚁卵也出现了。",
        "燕子飞来落下。",
        "这时开始见到睇。",
        "剖取鳝鱼。",
        "黄鹂开始鸣叫。",
        "芸草开花，这时有可见的嫩芽，开始采收。"
      ],
      "注": [
        "荣：开花。",
        "田胡：田间菜草，确切品种未定。",
        "䖝：同“虫”。",
        "蚳：蚂蚁的卵或幼体。",
        "睇：本句所指不明，暂保留原字。",
        "仓庚：黄鹂。"
      ]
    },
    "3": {
      "译": [
        "三月。",
        "参星隐没不见。",
        "采桑叶。",
        "杨树的枝叶舒展开来。",
        "羊开始发情。",
        "螜虫开始鸣叫。",
        "分发冰块。",
        "采集名为识的草。",
        "家中妇女和孩子开始养蚕。",
        "着手料理宫室里奉养所需的事务。",
        "祈求麦子结实。",
        "接着出现小旱。",
        "古人说，这时田鼠变成名为𩣉的动物。",
        "梧桐的花苞开绽。",
        "鸠开始鸣叫。"
      ],
      "注": [
        "摄桑：采桑。",
        "螜：古虫名，常指蝼蛄。",
        "颁冰：把所藏之冰分发出去。",
        "识：所采植物名，具体所指未定。",
        "𩣉：依本稿保留；与八月“𩣉为鼠”呼应。",
        "芭：这里作花苞理解。"
      ]
    },
    "4": {
      "译": [
        "四月。",
        "昴星出现。",
        "天刚黑时，南门星正对观测方位。",
        "扎虫鸣叫。",
        "园中已能看见结出的杏子。",
        "蜮开始鸣叫。",
        "王萯抽穗开花。",
        "采集荼草。",
        "杂草长得茂密，遮蔽地面。",
        "接着出现大旱。",
        "牵着小马登高，对它加以训练。"
      ],
      "注": [
        "昴：昴宿，昴读 mǎo。",
        "南门：星官名。",
        "扎、蜮：此处均作时令中有鸣声的动物名，具体所指未定。",
        "王萯：古植物名。",
        "荼：古草名。",
        "攻驹：调教小马。"
      ]
    },
    "5": {
      "译": [
        "五月。",
        "参星重新可见。",
        "名为浮游的小虫大量出现。",
        "鴂鸟开始鸣叫。",
        "这时有一项称为“养白”的时事。",
        "瓜到了生长的时节。",
        "良蜩鸣叫。",
        "匽兴起，五天聚合，到月中便伏而不见。",
        "开始灌溉蓝和蓼。",
        "古人说，这时鸠变成鹰。",
        "唐蜩鸣叫。",
        "天刚黑时，大火星位居中天。",
        "煮梅子。",
        "采藏兰草。",
        "把豆子煮成糜粥。",
        "分拨马匹。",
        "将马安置在有一定规制的处所。"
      ],
      "注": [
        "浮游：此处作虫名。",
        "养白：语义未定。",
        "匽：此句所指难定；翕为聚合，望指月中满月之时。",
        "良蜩、唐蜩：两种蝉的古称。",
        "大火：古星名，通常指心宿二。",
        "将间诸则：承上“颁马”理解，具体制度未详。"
      ]
    },
    "6": {
      "译": [
        "六月。",
        "天刚黑时，北斗的斗柄正指上方。",
        "煮桃子。",
        "鹰开始捕击猎物。"
      ],
      "注": [
        "挚：通“鸷”，此处指猛禽捕击。"
      ]
    },
    "7": {
      "译": [
        "七月。",
        "荻苇抽穗。",
        "捚子开始铺展开来。",
        "洼地积水中长出苹草。",
        "名为𤕤的生物在这时死去。",
        "苹草开花。",
        "银河横临门户的方位。",
        "寒蝉鸣叫。",
        "天刚黑时，织女星正朝东。",
        "这时有连绵的雨。",
        "灌溉荼草。",
        "斗柄垂向下方时，天就快亮了。"
      ],
      "注": [
        "莠：此处作草类抽穗解。",
        "雚苇：荻、芦苇一类植物。",
        "捚子、𤕤：所指未定，保留原字。",
        "湟潦：洼地中的积水。",
        "苹：水边或水中生长的草本。",
        "汉：银河。"
      ]
    },
    "8": {
      "译": [
        "八月。",
        "剖开瓜来处理。",
        "有一项称为“玄校”的时事。",
        "打下枣子。",
        "粟粒成熟脱落。",
        "丹鸟取食白鸟。",
        "辰星隐没不见。",
        "鹿开始相随成群。",
        "古人说，这时𩣉变成田鼠。",
        "参星位居中天时，天就快亮了。"
      ],
      "注": [
        "剥：依对象分别理解为剖瓜和打枣。",
        "玄校：所指未定。",
        "丹鸟、白鸟：此处是古代物候名，未必按字面指鸟类。",
        "辰：在本篇八、九月的语境中可理解为与大火相关的星名。"
      ]
    },
    "9": {
      "译": [
        "九月。",
        "大火星隐没。",
        "鸿雁迁飞。",
        "主持家务的人把火种移出。",
        "燕子离去，古人认为它们开始蛰藏。",
        "熊、罢、貊、貉、鼬、鼪等兽长得肥大，仿佛将要蛰伏。",
        "菊花开放。",
        "王开始穿皮衣。",
        "辰星靠近太阳。",
        "古人说，雀飞入海中变成蛤。"
      ],
      "注": [
        "内火：与下文“辰系于日”相参，此处理解为大火星不再可见。",
        "遰：迁离。",
        "玄鸟：燕子。",
        "罢：这里用作兽名，可按“罴”理解。",
        "裘：皮毛制成的衣服。"
      ]
    },
    "10": {
      "译": [
        "十月。",
        "豺把捕来的兽摆开，像在祭祀。",
        "天刚黑时，南门星可见。",
        "黑乌鸦沐浴。",
        "这时有一项称为“养夜”的时事。",
        "古人说，黑色的野鸡进入淮水，变成大蛤。",
        "织女星正朝北；末了的“具”字意思未明。"
      ],
      "注": [
        "养夜：所指未定。",
        "蜄：古称大蛤一类。",
        "具：清理稿作此字，句义未定。"
      ]
    },
    "11": {
      "译": [
        "十一月。",
        "王举行冬猎。",
        "陈列肋骨和兽皮。",
        "主管农事的人不参加随行。",
        "麋鹿的角脱落。"
      ],
      "注": [
        "狩：传统四时田猎中，冬猎称“狩”。",
        "革：兽皮。",
        "啬人：与农事有关的人员。",
        "陨：掉落。"
      ]
    },
    "12": {
      "译": [
        "十二月。",
        "名为弋的鸟鸣叫。",
        "黑蚁奔走。",
        "把葱蒜一类的菜收存起来。",
        "掌山泽的人进入设置鱼梁的地方。",
        "麋鹿的角脱落。"
      ],
      "注": [
        "弋：此处作鸣鸟名，具体所指未定。",
        "玄驹：黑蚁。",
        "贲：这里按奔走理解。",
        "𡖉️䔉：字形难定，䔉可作蒜类理解。",
        "虞人：管理山林川泽的人。",
        "梁：拦水捕鱼的设施。"
      ]
    }
  }
}
