{
 "start": 19,
 "items": [
  {
   "题解": "严世蕃以美婢为唾盂、肉双陆，籍没时抄出淫筹秽巾，写权贵之荒淫。",
   "段落": [
    {
     "译": [],
     "注": [
      "严世蕃：严嵩之子，官工部侍郎，嘉靖间专权，后被处死，事见《明史·奸臣传》。",
      "香唾盂：以婢口为唾盂，淫靡。",
      "王天华：待考，原作“尚书”。",
      "锦罽：织锦毛毯。",
      "点位：棋盘上的位置。",
      "双陆图：双陆为古代博戏，此以锦织成双陆图。",
      "肉双陆：以美人代棋子。",
      "缁素：黑白。",
      "籍没：抄没家产。",
      "台使：御史台使者，此指巡按御史。",
      "汗巾：擦汗的巾。",
      "淫筹：以废巾计数。"
     ]
    }
   ]
  },
  {
   "题解": "石崇择美姬数十人，用沉香屑试其体态，评其轻重，见《拾遗记》。",
   "段落": [
    {
     "译": [],
     "注": [
      "石太尉：石崇，西晋富豪，曾任卫尉、太仆等职，称“太尉”者待考。",
      "倒龙之珮：龙形玉佩。",
      "凤冠之钗：凤形金钗。",
      "结袖：结连衣袖。",
      "楹：厅堂前柱。",
      "沉水之香：沉香，入水则沉。",
      "象床：象牙装饰的床。",
      "细骨轻躯：形容体轻。"
     ]
    }
   ]
  },
  {
   "题解": "元载宠姬薛瑶英体轻，贾至、杨炎赋诗以赞，见《杜阳杂编》。",
   "段落": [
    {
     "译": [],
     "注": [
      "元载：唐代宗朝宰相，贪污，被赐死。",
      "薛瑶英：元载宠姬，擅歌舞，体轻。",
      "金丝帐：以金丝织成的帷帐。",
      "却尘褥：不染灰尘的褥子，传说为西域所献。",
      "龙绡：薄绡。",
      "贾至：唐诗人，曾任中书舍人。",
      "杨公雅（南）：此处似指杨炎，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "珠衣：缀珠之衣。",
      "桃脸：桃花般的脸。",
      "虚筑避风台：避风台相传为汉成帝为赵飞燕所筑，此诗作“汉武帝”，疑误。"
     ]
    },
    {
     "译": [],
     "注": [
      "炎亦作长歌：杨炎，元载同党。"
     ]
    },
    {
     "译": [],
     "注": [
      "澹娥：淡雅美人。",
      "凤箫鸾翅：以乐器、凤鸾形容飞升。",
      "楚腰：细腰，语出“楚王好细腰”。"
     ]
    }
   ]
  },
  {
   "题解": "宋祁修《唐书》的风雅与夜宴不眠，及其兄宋庠之讥，附《蜀广记》茶词故事。",
   "段落": [
    {
     "译": [],
     "注": [
      "宋祁：宋祁（998—1061），修《新唐书》。",
      "帅蜀：任成都知府，宋时蜀帅。",
      "书局：修书的机构。",
      "椽烛：大如椽的蜡烛。",
      "媵婢：陪嫁之婢，此指侍婢。",
      "澄心堂纸：南唐澄心堂所制名纸，宋代珍品。",
      "宗子：宗室子弟。",
      "杂剧：宋代戏剧，院本。",
      "更漏：古代计时器。",
      "不晓天：不知天晓。",
      "大宋：宋庠，宋祁之兄。",
      "上元夜：元宵节夜晚。",
      "吃齑煮饭：吃咸菜、煮饭，喻贫寒读书时。"
     ]
    },
    {
     "译": [],
     "注": [
      "《蜀广记》：当为明曹学佺《蜀中广记》。",
      "大慈寺：成都名寺。",
      "清献公：赵抃，北宋名臣，谥清献，曾知成都。",
      "临邛周之纯：周之纯，待考。",
      "茶词：送茶时所唱之词。"
     ]
    }
   ]
  },
  {
   "题解": "陈慥早年携侍女远游，后为河东狮吼所制；评语谓其放侍女习道是从豪华中悟来。",
   "段落": [
    {
     "译": [],
     "注": [
      "陈慥：字季常，苏轼好友，号龙丘居士。",
      "龙丘子：陈慥自号。",
      "洛：洛阳。",
      "制于内：被妻管束。",
      "河东狮吼：苏轼《寄吴德仁兼简陈季常》“忽闻河东狮子吼”，喻惧内。",
      "垒块：胸中不平之气。",
      "轮台之悔：汉武帝晚年下罪己诏，称“轮台诏”。",
      "祷祠：祭祷求仙。"
     ]
    }
   ]
  },
  {
   "题解": "刘綎出巡，姬妾戎装前导，豪气夺人。",
   "段落": [
    {
     "译": [],
     "注": [
      "刘烶：当为刘綎，字省吾，万历名将，善用镔铁大刀，号“刘大刀”。",
      "神宗：明神宗万历帝。",
      "燕、赵：此指美女之乡。",
      "弹械：待考。",
      "力士：壮汉。"
     ]
    }
   ]
  },
  {
   "题解": "王太常富豪，宠姬数十，各居一院，夜夜竿灯示宠。",
   "段落": [
    {
     "译": [],
     "注": [
      "太常卿：掌礼乐祭祀。",
      "苏郡王相国：苏州王姓宰相，似指王锡爵，待考。",
      "三只眼：绰号，因额有疤痕。",
      "廉介：清廉耿介。",
      "鳞次：像鱼鳞般依次排列。",
      "上寿：祝寿，此指敬酒。",
      "白玉卮：白玉酒杯。",
      "庀榼：备办酒具。",
      "房老：管房之老妇。",
      "啧啧：称赞声。"
     ]
    }
   ]
  },
  {
   "题解": "寇准宴请歌妓，妾蒨桃献诗讽赏赐过厚；又载杨汝士红绫赏妓，评郭元振赏薄。",
   "段落": [
    {
     "译": [],
     "注": [
      "寇莱公：寇准，封莱国公。",
      "蒨桃：寇准之妾，擅诗。"
     ]
    },
    {
     "译": [],
     "注": [
      "织女：喻织工。"
     ]
    },
    {
     "译": [],
     "注": [
      "嘿然：沉默。"
     ]
    },
    {
     "译": [],
     "注": [
      "杨汝士：唐文宗时尚书，镇东川。",
      "知温：杨知温，汝士子。",
      "营妓：军营所属乐伎。"
     ]
    },
    {
     "译": [],
     "注": [
      "谢夫人：杨汝士之妻谢氏。",
      "两头娘子：待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "《钗小志》：见前。",
      "郭元振：唐名将，武则天时人。",
      "糖、鸡卵：润嗓之物。"
     ]
    }
   ]
  },
  {
   "题解": "柳睦州为纳陈娇如，张锦帐三十重，娇如因而归之；评语赞其志节。",
   "段落": [
    {
     "译": [],
     "注": [
      "柳睦州：柳姓睦州刺史，待考。",
      "调集：调选，赴吏部候选。",
      "娼：妓女。",
      "陈娇如：名妓。",
      "锦帐：以锦做的帷帐。"
     ]
    },
    {
     "译": [],
     "注": [
      "痼疾：积久难愈之病。",
      "寿王妃：杨玉环原为寿王李瑁之妃，后入宫为贵妃。",
      "青楼：妓院。"
     ]
    }
   ]
  },
  {
   "题解": "史凤待客分等差，以枕、灯、被、羹命名，各有题咏，附卖油郎故事。",
   "段落": [
    {
     "译": [],
     "注": [
      "史凤：宣城妓，余待考。",
      "宣城：今安徽宣城。",
      "迷香洞：史凤待上客之所，名称香艳。",
      "神鸡枕、锁莲灯：妓馆之物名。",
      "鲛红被：红色薄被。",
      "传香枕：香枕。",
      "八分羹：羹名。"
     ]
    },
    {
     "译": [],
     "注": [
      "飞琼：许飞琼，传说仙女，西王母侍女。",
      "羽霓：霓裳羽衣，仙人服。",
      "芙蓉帐：荷花图案之帐。",
      "不数桃花流水溪：刘晨阮肇天台遇仙事，桃花流水，仙境。"
     ]
    },
    {
     "译": [],
     "注": [
      "神鸡枕：见前。"
     ]
    },
    {
     "译": [],
     "注": [
      "雾縠：薄如雾之纱。",
      "斗神鸡：绣制斗鸡之图。"
     ]
    },
    {
     "译": [],
     "注": [
      "锁莲灯：见前。"
     ]
    },
    {
     "译": [],
     "注": [
      "罍：酒器。",
      "翠钿：翠玉首饰。",
      "楚台：楚襄王阳台。",
      "金莲：妓女之纤足，南唐窅娘裹足。"
     ]
    },
    {
     "译": [],
     "注": [
      "鲛红被：见前。"
     ]
    },
    {
     "译": [],
     "注": [
      "肱被：长被。",
      "血猩纨：红色绢布。",
      "鹓鸾：鹓鶵与鸾凤，高贵之鸟，此喻鸳鸯偶。"
     ]
    },
    {
     "译": [],
     "注": [
      "传香枕：见前。"
     ]
    },
    {
     "译": [],
     "注": [
      "韩寿：晋人，贾充女偷其父所赐西域香赠之，见《世说新语》。",
      "婵娟：美人。",
      "铤刃：刀刃。",
      "栴檀：旃檀香。"
     ]
    },
    {
     "译": [],
     "注": [
      "八分羹：见前。"
     ]
    },
    {
     "译": [],
     "注": [
      "党家：指宋将党进，其家姬以饮羊羔酒著称，见宋人笔记。"
     ]
    },
    {
     "译": [],
     "注": [
      "闭门羹：对不欢迎者闭门不见。"
     ]
    },
    {
     "译": [],
     "注": [
      "一豆：一小碗。",
      "仓琅：青色，也作门环。",
      "相如侣：用相如挑文君事。",
      "凤凰：《凤求凰》。"
     ]
    },
    {
     "译": [],
     "注": [
      "冯垂：人名，待考。",
      "《九迷诗》：诗题，待考。",
      "照春屏：屏风名。",
      "《常新录》：待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "卖油郎：指《醒世恒言》中的《卖油郎独占花魁》，秦重事。",
      "镕成：熔化成。",
      "逾福：过分之福。"
     ]
    }
   ]
  },
  {
   "题解": "纨绔凌延年初到金陵，周遍名姬，花费不多而得名，为杨美儿治丧。",
   "段落": [
    {
     "译": [],
     "注": [
      "凌延年：待考，据文为尚书洋山公之子。",
      "世袭锦衣：世袭锦衣卫官职。",
      "白下：南京别称。",
      "六院：明代南京教坊之妓院。",
      "初会：与妓女初次相见之礼。",
      "二币：礼物两份。",
      "大老官：财主，有钱的老爷。",
      "杨美儿：南京名妓，与凌延年相好。",
      "折帛：礼物，布帛。",
      "七七：人死后四十九日。"
     ]
    }
   ]
  },
  {
   "题解": "张献翼少富才高，以妓自娱，晚年仍好客，上元灯会任人游赏。",
   "段落": [
    {
     "译": [],
     "注": [
      "张敉：张献翼，字幼于，初名敉，长洲人，明代文士，好奇行。",
      "不售：科举不第。",
      "文起堂：张献翼居所。",
      "上元试灯：元宵前试放灯。",
      "曲江金明池：曲江为唐长安游览地，金明池为宋汴京游览地。"
     ]
    }
   ]
  },
  {
   "题解": "阮籍醉卧当垆少妇旁并哭他人之女，评语以礼和王子猷看竹解其放达。",
   "段落": [
    {
     "译": [],
     "注": [
      "当垆沽酒：见前，卖酒。",
      "兵家女：军人家的女子。",
      "籍：阮籍，竹林七贤之一，官步兵校尉。"
     ]
    },
    {
     "译": [],
     "注": [
      "《礼》：《礼记》，此语待考。",
      "步兵：阮籍曾任步兵校尉。",
      "子猷看竹：王徽之（字子猷），曾径入吴中士大夫家看竹，直言“何可一日无此君”，见《世说新语》。"
     ]
    }
   ]
  },
  {
   "题解": "谢鲲挑邻女被梭折齿，仍傲然长啸，见《晋书》。",
   "段落": [
    {
     "译": [],
     "注": [
      "谢鲲：东晋名士，官豫章太守。",
      "梭：织布用的梭子。",
      "傲然长啸：谢鲲被打落两齿，仍长啸，事见《晋书·谢鲲传》。"
     ]
    }
   ]
  },
  {
   "题解": "杜牧席上索紫云，朗吟而惊四座，评语称其有晋人风流。",
   "段落": [
    {
     "译": [],
     "注": [
      "杜牧：唐诗人，曾任监察御史，分司东都洛阳。",
      "分务：分司，在东都办公。",
      "李司徒愿：李愿，曾为宣武、河中等镇帅。",
      "持宪：担任御史，执法监察。",
      "紫云：李愿之歌妓，名紫云。",
      "三卮：三杯。",
      "凝睇：注视。"
     ]
    },
    {
     "译": [],
     "注": [
      "分司御史：杜牧自指。",
      "红粉：女子。"
     ]
    },
    {
     "译": [],
     "注": [
      "洒然：潇洒自然。"
     ]
    }
   ]
  },
  {
   "题解": "李白戏请宁王，隔障听歌女宠姐。",
   "段落": [
    {
     "译": [],
     "注": [
      "宁王：唐玄宗兄李宪，封宁王。",
      "宠姐：宁王宫乐妓，名宠姐。",
      "李学士白：李白，曾为翰林供奉。",
      "七宝花障：以七宝装饰的屏障。",
      "觌面：见面。"
     ]
    }
   ]
  },
  {
   "题解": "谢希孟与妓往来，作鸳鸯楼记而有悟，词别妓；评语赞其顿悟不用棒喝。",
   "段落": [
    {
     "译": [],
     "注": [
      "谢希孟：南宋陆九渊门人，余待考。",
      "陆象山：陆九渊，字子静，号象山，南宋心学家。",
      "鸳鸯楼：待考。",
      "逊、抗、机、云：陆逊、陆抗、陆机、陆云，吴地陆氏，与陆象山同姓，因此用之。",
      "天地英灵之气：天地灵气。",
      "嘿然：沉默。",
      "江浒：江边。",
      "领巾：围巾。"
     ]
    },
    {
     "译": [],
     "注": [
      "双桨浪花平：词起句。"
     ]
    },
    {
     "译": [],
     "注": [
      "付与他人可：词句，意谓不妨转托他人。"
     ]
    },
    {
     "译": [],
     "注": [
      "棒喝：禅宗的教学方式，一棒一喝，此谓无需教诲。",
      "瓜熟蒂落：喻时机成熟。"
     ]
    }
   ]
  },
  {
   "题解": "俞华麓为一妓而当众长揖，后被考功议其风度。",
   "段落": [
    {
     "译": [],
     "注": [
      "俞华麓大夫：俞某，待考。",
      "生公石：苏州虎丘山之石，晋竺道生说法处。",
      "宥：宽恕。",
      "观瞻：外观，体面。",
      "曩日：往日。"
     ]
    },
    {
     "译": [],
     "注": [
      "考功法：京察，吏部考功司考核官员，不称职者罢黜。",
      "晋人风度：魏晋名士之风。",
      "汉官威仪：汉官的庄严仪容。"
     ]
    }
   ]
  },
  {
   "题解": "韩汝玉为妓晏起，县吏候声喏，自劾，后范仲淹遣舟送之。",
   "段落": [
    {
     "译": [],
     "注": [
      "韩汝玉：待考。",
      "钱塘：今杭州。",
      "声喏：唱喏，行礼。",
      "范文正公：范仲淹，谥文正，曾知杭州。",
      "自劾：自我弹劾。",
      "解缆：解开缆绳。"
     ]
    }
   ]
  },
  {
   "题解": "康海好声色，以柬戏刘大谟，为妓生子，携妓同游。",
   "段落": [
    {
     "译": [],
     "注": [
