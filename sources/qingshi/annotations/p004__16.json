{
 "start": 16,
 "items": [
  {
   "题解": "宋祁以词遇宫中车中人，仁宗得知，成人之美；后附袁盎、葛周、张说、种世衡等以侍姬赐人而得报之事。",
   "段落": [
    {
     "译": [],
     "注": [
      "宋子京祁：宋祁（998—1061），字子京，北宋文学家，与欧阳修合修《新唐书》。",
      "公序郊：宋庠（996—1066），初名郊，字公序，宋祁之兄，官至宰相。",
      "大宋、小宋：兄弟并称，兄为大宋，弟为小宋。",
      "御街：京城中通往宫城的大街。",
      "内家车子：宫中妃嫔所乘之车。",
      "《鹧鸪天》：词牌，双调五十五字。"
     ]
    },
    {
     "译": [],
     "注": [
      "宝毂雕轮：华美的车轮。",
      "彩凤双飞翼：出自李商隐《无题》“昨夜星辰昨夜风”，犀角有白纹通首尾，喻心意相通。"
     ]
    },
    {
     "译": [],
     "注": [
      "金作屋，玉为笼：喻深宫禁锢。",
      "刘郎已恨蓬山远：出李商隐《无题》“来是空言去绝踪”，刘郎指汉武帝，亦指东汉刘晨入天台山遇仙事，蓬山喻宫禁。"
     ]
    },
    {
     "译": [],
     "注": [
      "万重：与上句“更隔蓬山几”相接。"
     ]
    },
    {
     "译": [],
     "注": [
      "仁宗：宋仁宗赵祯。",
      "内人：宫女。",
      "翰林学士：宋祁时任翰林学士。",
      "内臣：宦官。",
      "蓬山不远：化用李商隐诗意，戏言成全之。"
     ]
    },
    {
     "译": [],
     "注": [
      "钱简栖山人：简栖，明代钱希言号，待考。",
      "黄鹂久住浑相恋：见前《戎昱》诗，指戎昱事。",
      "侯门一入深如海：崔郊诗，见前。",
      "李义山：李商隐，字义山，晚唐诗人。",
      "改坏《旧唐书》：宋祁修《新唐书》，改写《旧唐书》，文风艰涩，常受讥评。",
      "玄、僖：唐玄宗、唐僖宗，见前。",
      "特达之知：特别的知遇。"
     ]
    },
    {
     "译": [],
     "注": [
      "袁盎：见下文，西汉大臣，号袁丝，吴相，后为太常。",
      "葛周：五代后梁将领，见《北梦琐言》。"
     ]
    },
    {
     "译": [],
     "注": [
      "从史：随从小吏。",
      "吴相：吴王刘濞之相。",
      "太常：九卿之一，掌宗庙礼仪。",
      "吴王：刘濞，七国之乱首领。",
      "醇醪：醇厚的酒。",
      "校尉司马：军中校尉所属司马，掌军务。事见《史记·袁盎晁错列传》。"
     ]
    },
    {
     "译": [],
     "注": [
      "葛侍中周：葛从周，后梁将，官至侍中，封陈留王，后封“葛周”，似为简称。",
      "镇衮：镇守兖州。衮，同“兖”。",
      "厅头：衙署门吏之长。",
      "国色：绝色。",
      "目之不已：注目不止。",
      "处分：吩咐。",
      "缗：钱串，一千文为一缗。",
      "列职：职位，官职。",
      "河北谚：“山东一条葛，无事莫撩拨”，谓葛从周勇猛。"
     ]
    },
    {
     "译": [],
     "注": [
      "楚庄绝缨之会：楚庄王宴群臣，烛灭，有人牵王后衣，王后绝其缨，庄王令群臣皆绝缨而不追究。见《说苑·复恩》。",
      "跼蹐：局促不安。",
      "种世衡：北宋名将，有谋略，驻守青涧城。",
      "苏慕恩：羌族酋长，事见《宋史·种世衡传》。",
      "下一乘：差一等。"
     ]
    },
    {
     "译": [],
     "注": [
      "张说：唐玄宗朝宰相，封燕国公。",
      "姚崇之构：姚崇与张说不和，构陷。",
      "夜明帘：能夜发光的帘，珍宝。",
      "九公主：玄宗之妹，玉真公主，排行待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "胡酋：蕃族首领。",
      "佐酒：陪酒。"
     ]
    }
   ]
  },
  {
   "题解": "詹天游席上赋词，驸马杨震即以爱姬粉儿赠之。",
   "段落": [
    {
     "译": [],
     "注": [
      "故宋附马杨震：疑即度宗驸马杨镇，附马即驸马。",
      "詹天游：詹玉，字天游，宋末元初词人。",
      "佐觞：劝酒。"
     ]
    },
    {
     "译": [],
     "注": [
      "一梭儿玉一窝云：形容女子肤如玉，发如云。",
      "口儿樱：樱桃小口。"
     ]
    },
    {
     "译": [],
     "注": [
      "西子：西施。",
      "昭君：王昭君。",
      "销魂：魂魄离体，形容极度悲或喜。"
     ]
    },
    {
     "译": [],
     "注": [
      "真个销魂：以此调侃，请其真销魂。"
     ]
    }
   ]
  },
  {
   "题解": "李绅与张又新旧怨释，宴上命旧妓歌词，赠张以妓。评语驳旧注之泥。",
   "段落": [
    {
     "译": [],
     "注": [
      "李相绅：李绅，字公垂，唐中后期宰相，官淮南节度使。",
      "张郎中又新：张又新，官刑部郎中，因与李绅有隙。",
      "荆溪：江苏宜兴一带之水。",
      "长笺：长信。",
      "端溪：端州（今广东肇庆）产砚，其说待考。",
      "广陵：今江苏扬州。",
      "从事：节度使属官。",
      "悒然：忧郁。",
      "喝：此指唱。"
     ]
    },
    {
     "译": [],
     "注": [
      "云雨：男女欢会。",
      "玳瑁筵：华美的宴席。"
     ]
    },
    {
     "译": [],
     "注": [
      "夕就之：夜里陪侍。"
     ]
    },
    {
     "译": [],
     "注": [
      "泥：拘泥。"
     ]
    }
   ]
  },
  {
   "题解": "刘禹锡席上赋诗，李绅以妓赠之，即“司空见惯”典故。",
   "段落": [
    {
     "译": [],
     "注": [
      "刘尚书禹锡：刘禹锡，字梦得，曾任和州刺史、主客郎中，官至礼部尚书。",
      "主客郎中：礼部主客司长官。",
      "集贤学士：集贤殿学士。",
      "罢镇：解除镇守之职。"
     ]
    },
    {
     "译": [],
     "注": [
      "䰀鬌：疑为发髻样式，待考。",
      "杜韦娘：唐教坊曲名。",
      "司空见惯：本此事，指见惯平常之事。",
      "江南刺史：刘禹锡自指。"
     ]
    },
    {
     "译": [],
     "注": []
    }
   ]
  },
  {
   "题解": "举子与旧识乐妓茂英重逢，因诗而得节度使成全。",
   "段落": [
    {
     "译": [],
     "注": [
      "洛中举子：洛阳的考生。",
      "乐妓：乐伎。",
      "江外：江南。"
     ]
    },
    {
     "译": [],
     "注": [
      "柳楼：妓楼。",
      "未省：不曾。",
      "上头：女子成年梳髻。",
      "南国：南方。"
     ]
    },
    {
     "译": [],
     "注": [
      "节使：节度使。",
      "酒纠：席间督酒令之人。",
      "赆行：赠财送行。"
     ]
    },
    {
     "译": [],
     "注": [
      "下筹：酒令中取筹。",
      "占相令：酒令名，待考。",
      "决却尚书：此处指举子，称为尚书，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "舞曲：舞蹈曲子。"
     ]
    }
   ]
  },
  {
   "题解": "一士人寄词给开府席上之妓，开府夫人喜其词清丽，遂以妓赠之。",
   "段落": [
    {
     "译": [],
     "注": [
      "开府：开府仪同三司，位至高官。"
     ]
    },
    {
     "译": [],
     "注": [
      "腰儿细：腰细。",
      "粉裙：浅色裙。"
     ]
    },
    {
     "译": [],
     "注": [
      "铅华：铅粉，妆饰。",
      "眉峰双翠：翠眉。"
     ]
    },
    {
     "译": [],
     "注": [
      "阃中：内室，指夫人。"
     ]
    }
   ]
  },
  {
   "题解": "姜夔作《暗香》《疏影》，范成大以小红赠之，夜过垂虹赋诗。",
   "段落": [
    {
     "译": [],
     "注": [
      "小红：范成大家歌妓。",
      "顺阳公：指范成大，范氏郡望顺阳，晚号石湖居士，封吴郡开国公。",
      "青衣：婢女。",
      "请老：请求致仕。",
      "姜尧章夔：姜夔，字尧章，号白石道人，南宋词人，精音律。",
      "授简：授以笺，请其作词。",
      "《暗香》：姜夔咏梅词，与《疏影》并为姜夔名作，见《白石道人歌曲》。",
      "《疏影》：同为咏梅词，与《暗香》相对。",
      "肄习：练习。",
      "吴兴：今浙江湖州。",
      "垂虹：垂虹桥，在吴江。"
     ]
    },
    {
     "译": [],
     "注": [
      "松陵：吴江古称。"
     ]
    },
    {
     "译": [],
     "注": [
      "自度曲：自己谱写的曲子。",
      "洞箫：竖吹之箫。"
     ]
    }
   ]
  },
  {
   "题解": "元稹使蜀欲见薛涛，严司空遣薛往，后寄诗赠之。",
   "段落": [
    {
     "译": [],
     "注": [
      "元稹：唐诗人，字微之，元和中使东蜀。",
      "薛涛：唐成都乐妓，擅诗，号“校书”。",
      "监察使：监察御史出使，称监察使。",
      "推鞫：审问。",
      "严司空：指严砺，剑南东川节度使，待考。",
      "翰林：元稹后入翰林学士。"
     ]
    },
    {
     "译": [],
     "注": [
      "锦江：成都锦江，薛涛居浣花溪。",
      "文君：卓文君。",
      "鹦鹉舌：言语巧如鹦鹉。",
      "凤凰毛：喻才华。",
      "梦刀：晋王濬梦悬三刀于卧屋梁上，又添一刀，为益州刺史，此指仕蜀。",
      "菖蒲花：传说菖蒲花难得见，主贵，指薛涛。",
      "五云：五色祥云。"
     ]
    }
   ]
  },
  {
   "题解": "韩翊与柳氏离合，沙吒利劫柳，虞侯许俊夺回，皇帝下诏归韩。",
   "段落": [
    {
     "译": [],
     "注": [
      "韩翊：即韩翃，唐大历十才子之一，《柳氏传》载其事。",
      "天宝：唐玄宗年号（742—756）。",
      "荜门圭窦：用荆条编门，墙开圭形小洞，形容贫寒。",
      "李将：不记姓名之将军。",
      "豁落：豪爽。",
      "葭艾：芦苇与艾草，此指所居简陋。",
      "假借：给予方便，扶助。",
      "淄青节度侯希逸：侯希逸，平卢淄青节度使。",
      "良金：好金。",
      "练囊：白绢小袋。"
     ]
    },
    {
     "译": [],
     "注": [
      "章台柳：章台，汉长安街名，多妓馆，后以章台柳喻妓女。",
      "攀折：喻被人占有。"
     ]
    },
    {
     "译": [],
     "注": [
      "复书：回信。"
     ]
    },
    {
     "译": [],
     "注": [
      "杨柳枝：古曲名，又为咏柳之词。",
      "芳菲节：春季。"
     ]
    },
    {
     "译": [],
     "注": [
      "落发为尼：削发为尼。",
      "沙吒利：蕃将，立功于代宗朝。",
      "专房：专宠。",
      "犊车：牛车。",
      "青州：淄青节度使治所，在青州。",
      "合子：小盒。",
      "香膏：妇女用的香油。"
     ]
    },
    {
     "译": [],
     "注": [
      "临淄大校：淄青军大将，临淄，今山东淄博。",
      "虞侯：军中武官，掌巡察。",
      "被酒：喝多了。",
      "札：书信。",
      "扼腕：握腕，激愤。",
      "代宗：唐代宗李豫。",
      "御批：皇帝批语。"
     ]
    },
    {
     "译": [],
     "注": [
      "君平：韩翃字君平。",
      "何啻：何止。",
      "爽剀：直爽果断。",
      "三侠士：李将、许俊、侯希逸。"
     ]
    }
   ]
  }
 ]
}