  {
   "题解": "元代艺人刘婆惜被逐后路过赣州，谒见监郡全子仁，在宴上续《清江引》曲，得其赏识，纳为侧室。此条开情缘、媒合类中的才艺成缘故事。",
   "段落": [
    {
     "译": [],
     "注": [
      "刘婆惜：元代艺人，见夏庭芝《青楼集》，李四之妻，擅歌舞。",
      "乐人：以歌舞为业的艺人。",
      "江右：江西。",
      "杨春秀：与刘婆惜同时的艺人，见《青楼集》。",
      "文墨：诗文。",
      "滑稽：诙谐机智。",
      "时贵：当时的显贵。",
      "推官：府的属官，掌司法。",
      "三舍：对富家子弟的称呼。",
      "间阻：从中阻挠。",
      "宵遁：夜里逃走。",
      "决杖：判处杖刑。",
      "广海：广东、广西沿海一带。",
      "全音庵拨里：疑为元人全普庵撒里，字子仁，蒙古或色目人，名异译，生平待考。",
      "监郡：路府的达鲁花赤，监督一路的长官。",
      "扬历台省：历任御史台、中书省等官署。",
      "花酒之癖：好饮酒与花的嗜好。",
      "簪：插戴。",
      "刑余之妇：受过刑罚的女人。",
      "阍者：看门人。",
      "清誉：清正的声誉。",
      "行酒：依次敬酒。",
      "口占：不起草稿，随口吟成。",
      "《清江引》：元曲曲牌，属双调。",
      "青青子儿枝上结：指枝上的青梅，兼喻年轻人。",
      "敛衽：整理衣襟，表示恭敬。"
     ]
    },
    {
     "译": [],
     "注": [
      "引惹：招惹。",
      "就里：其中。",
      "酸溜溜：既指青梅之酸，又指情意之酸。"
     ]
    },
    {
     "译": [],
     "注": [
      "弃舍：舍弃。"
     ]
    },
    {
     "译": [],
     "注": [
      "顾宠：宠爱。",
      "侧室：妾。",
      "兵兴：战乱兴起，指元末兵乱。",
      "死节：为守节而死。"
     ]
    }
   ]
  },
  {
   "题解": "宁波少年僧作《回回偈》戏柳氏女，被方国珍抓获，国珍以竹筒沉江为戏，僧作偈求饶，终令还俗成婚。属情媒类的奇闻，评语称其错做了和尚。",
   "段落": [
    {
     "译": [],
     "注": [
      "至正间：元顺帝至正年间（1341—1368）。",
      "明州：今浙江宁波。",
      "延庆寺：宁波著名天台宗寺院。",
      "关王：关羽，元明时被封为王，祠庙称关王庙。",
      "绣幡：绣制的旗幡，用于还愿。",
      "咒语：此处指偈颂，作者戏称。",
      "偈：佛教唱颂的韵语。"
     ]
    },
    {
     "译": [],
     "注": [
      "柳：姓柳，诗中皆写柳，双关。",
      "嫩绿未成阴：形容柳树未长成，喻少女。",
      "黄鹂：黄莺，此处喻僧人。",
      "留取待春深：希望等到她成熟。"
     ]
    },
    {
     "译": [],
     "注": [
      "方国珍：台州黄岩人，元末起事，割据浙东，后降元，官至江浙行省左丞相。",
      "讼之：告到官府。",
      "竺：僧人常姓竺。",
      "月华：月光，下文偈颂以月为题。",
      "匠氏：工匠。",
      "东流：向东流入大海。"
     ]
    },
    {
     "译": [],
     "注": [
      "付与法师藏法体：把法师的身体藏入竹筒。",
      "伴蛟龙：沉江与蛟龙作伴。",
      "色是空：《般若波罗蜜多心经》“色不异空，空不异色”，此处讥僧人的情色之念。"
     ]
    },
    {
     "译": [],
     "注": [
      "伏气：服输，屏气。",
      "分：本分，命分。"
     ]
    },
    {
     "译": [],
     "注": [
      "如镜亦如钩：月圆如镜，月缺如钩。",
      "红粉面：女子容貌。",
      "画帘头：画帘的顶端。"
     ]
    },
    {
     "译": [],
     "注": [
      "以名为答：指僧人所作偈以月华之名回应。"
     ]
    },
    {
     "译": [],
     "注": [
      "错做了和尚：评语，言僧人本不宜出家。"
     ]
    }
   ]
  },
  {
   "题解": "辽东马仲叔死后现形，为生前好友王志都做媒，使一河南女子送至其寝室成婚。属“情媒类”的鬼媒故事；评语赞其情胜于父母。",
   "段落": [
    {
     "译": [],
     "注": [
      "辽东：郡名，今辽宁东部。",
      "见形：现形。",
      "相念：相互惦念。",
      "期：约定日期。"
     ]
    },
    {
     "译": [],
     "注": [
      "清河太守：清河郡太守，清河郡在今河北。",
      "河南：这里指洛阳一带。",
      "天授：上天所授。",
      "南郡太守：南郡太守，南郡治今湖北荆州。"
     ]
    },
    {
     "译": [],
     "注": [
      "犹念友之无妇：评语，称马仲叔死后仍记挂朋友。",
      "胜于父母：评语，称其情意胜过父母。"
     ]
    }
   ]
  },
  {
   "题解": "闾山神庙中，士人梁公肃胆大，背负一女出庙，成了他的妻子。后梁官至参知政事。属“情媒类”，以神助成婚。",
   "段落": [
    {
     "译": [],
     "注": [
      "广宁：广宁府，辽金时治今辽宁北镇。",
      "闾山公庙：医巫闾山山神庙，今北镇庙。",
      "像设：塑像。",
      "狞恶：凶恶。",
      "毛竖：汗毛直竖。",
      "讯掠声：拷打声。"
     ]
    },
    {
     "译": [],
     "注": [
      "参知政事：宰相的副职。",
      "梁公肃：梁肃，金世宗时人，官至参知政事，事见《金史》。",
      "牵马岭：地名，待考。",
      "举子：参加科举的读书人。",
      "阴晦：天色昏暗。",
      "廊庑：走廊。",
      "从臾：怂恿，即“怂恿”。",
      "奋袖：卷起袖子。",
      "气息奄奄：气息微弱。",
      "肩舆：轿子。",
      "受室：娶妻。",
      "挈：带领。"
     ]
    },
    {
     "译": [],
     "注": [
      "擢第：科举及第。",
      "通显：官位显达。",
      "举数子：生了几个儿子。",
      "天赐夫人：时人对梁肃妻的称呼。",
      "大定二十年：1180年，大定为金世宗年号。",
      "节度彰德：任彰德军节度使，治相州，今河南安阳。",
      "耆旧：年高有声望的人。",
      "孙行：孙辈。"
     ]
    }
   ]
  },
  {
   "题解": "唐于祐在御沟中拾红叶诗，后娶出宫的韩夫人；后附顾况、卢偓、李茵等同类故事，辨别流红诗的多种传说。属“情媒类”，以红叶为媒。",
   "段落": [
    {
     "译": [],
     "注": [
      "唐僖宗：唐懿宗之子李儇，873至888年在位。",
      "御沟：流经宫苑的沟渠。",
      "红叶：古人题诗于红叶，传情的故事。"
     ]
    },
    {
     "译": [],
     "注": [
      "殷勤：恳切。",
      "谢：告诉，致谢。"
     ]
    },
    {
     "译": [],
     "注": []
    },
    {
     "译": [],
     "注": [
      "韩泳：唐人，具体待考。",
      "门馆：门客食宿处，此指做门客。",
      "放宫女三千人：僖宗时出宫女的事，待考。",
      "笥：竹箱。",
      "相质：互相对证。",
      "谢媒：酬谢媒人。"
     ]
    },
    {
     "译": [],
     "注": [
