 "items": [
  {
   "题解": "南宋女诗人朱淑真嫁与俗夫，作诗多怨，后人辑为《断肠集》；本条录其咏圆子诗与元夕词，评者因而疑其不贞。属“情憾类”，写才女婚姻不偶的遗憾。",
   "段落": [
    {
     "译": [],
     "注": [
      "朱淑真：宋代女词人，钱塘人，号幽栖居士，生平不详。",
      "钱塘：今浙江杭州。",
      "警慧：聪敏。",
      "市井民家：城市中的平民之家。",
      "抑抑：郁郁。",
      "《圆子》：咏汤圆的诗。"
     ]
    },
    {
     "译": [],
     "注": [
      "鸡头肉：芡实。",
      "蟹眼汤：水初沸时的小泡如蟹眼，称蟹眼汤。",
      "汤饼试何郎：三国魏何晏，肤白，魏文帝疑其敷粉，夏日赐热汤饼，大汗后面色更白，见《世说新语·容止》。"
     ]
    },
    {
     "译": [],
     "注": [
      "非偶：配偶不相称。",
      "宛陵魏端礼：魏仲恭，字端礼，宛陵（今安徽宣城）人，辑《断肠集》。",
      "《断肠集》：朱淑真诗词集。"
     ]
    },
    {
     "译": [],
     "注": [
      "《元夕·生查子》：此词一说为欧阳修作，一说为朱淑真作，归属有争议。"
     ]
    },
    {
     "译": [],
     "注": [
      "花市：元宵节的灯市。"
     ]
    },
    {
     "译": [],
     "注": [
      "春衫袖：春天所穿的衣衫袖口。"
     ]
    },
    {
     "译": [],
     "注": []
    },
    {
     "译": [],
     "注": [
      "火树银花：形容元宵灯火繁盛。",
      "极天歌吹：歌声乐声响彻天际。"
     ]
    },
    {
     "译": [],
     "注": [
      "缱绻：情意缠绵。",
      "月朦胧：月色不明。"
     ]
    },
    {
     "译": [],
     "注": [
      "不贞：评语，对朱淑真的怀疑，其说出自后人附会，不足据。"
     ]
    }
   ]
  },
  {
   "题解": "唐进士宇文翃的女儿本有国色，父亲谄附权势，把她嫁给年老的窦璠，评语叹其红颜薄命。属“情憾类”，写婚姻不遇之憾。",
   "段落": [
    {
     "译": [],
     "注": [
      "宇文翃：唐进士，生平待考。",
      "国色：国中最美的女子。",
      "窦璠：疑为唐人，事不详。",
      "耳顺：六十岁，《论语·为政》“六十而耳顺”。",
      "继室：续娶的妻子。",
      "谏议：谏议大夫，唐代掌谏诤的官员。",
      "气焰：权势。"
     ]
    },
    {
     "译": [],
     "注": [
      "红颜薄命：美貌女子命运不好。",
      "谄父：媚上的父亲。"
     ]
    }
   ]
  },
  {
   "题解": "明代女诗人朱静庵嫁与周姓教谕，自伤非偶，作《双鹤赋》以鹤自喻；又附陆文峦《闺怨》诗，同写婚姻不遇的幽怨。属“情憾类”。",
   "段落": [
    {
     "译": [],
     "注": [
      "海宁：今浙江海宁。",
      "尚宝卿：尚宝司长官，掌宝玺符牌。",
      "朱祚：明人，海宁人，官至尚宝卿，生平待考。",
      "教谕：县学教官。",
      "周济：朱静庵之夫，待考。",
      "情见乎词：感情表现于文辞。",
      "《双鹤赋》：朱静庵所作，以鹤自喻。"
     ]
    },
    {
