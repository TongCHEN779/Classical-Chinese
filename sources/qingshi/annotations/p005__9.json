{
 "start": 9,
 "items": [
  {
   "题解": "隋炀帝筑西苑、迷楼，作任意车，宠袁宝儿，乘龙舟游汴，淫逸无度。",
   "段落": [
    {
     "译": [],
     "注": [
      "大业元年：605年，隋炀帝年号。",
      "西苑：洛阳宫苑，隋炀帝所建。",
      "十六院：苑内诸院，每院二十人。",
      "宦者：宦官。",
      "肴羞：肴馔。",
      "《清夜游曲》：炀帝所作曲，事见《隋遗录》。",
      "五湖：苑中五个湖，名为东曰翠光等。",
      "北海：苑中之海，海中有蓬莱、方丈、瀛洲三山。",
      "龙凤舸：龙形凤形的大船。",
      "《湖上曲》、《望江南》：炀帝所作词曲，《望江南》八阕。",
      "阕：词曲一首为一阕。"
     ]
    },
    {
     "译": [],
     "注": [
      "曲房小室：深幽小室。",
      "高昌：宦官，名高昌，荐项升者。",
      "项升：筑迷楼之工匠。",
      "迷楼：隋炀帝所建，人入则迷，见《迷楼记》。",
      "帑库：国库。",
      "何稠：隋代工艺家，官太府卿，见《隋书》。",
      "御童女车：专供房事的车，描写淫荡，不写细节。",
      "幰：车帷。",
      "鲛绡：薄绢。",
      "上官时：隋炀帝时人，待考。",
      "乌铜屏：黑色铜镜屏风。",
      "大业十二年：616年。",
      "江都：今江苏扬州，炀帝三游江都。",
      "东都：洛阳。",
      "指血柒鞅：用指血染马缰，求留驾。",
      "飞白：书法体，笔画中露白如丝。",
      "守宫女：留守宫女。"
     ]
    },
    {
     "译": [],
     "注": [
      "征辽：炀帝三征高句丽。"
     ]
    },
    {
     "译": [],
     "注": [
      "车驾：皇帝出行。"
     ]
    },
    {
     "译": [],
     "注": [
      "袁宝儿：隋宫女，司花女。",
      "合蒂花：并蒂花。",
      "迎辇花：炀帝所赐花名。",
      "司花女：掌花之女。",
      "虞世南：隋唐间书法家，官秘书郎。",
      "《征辽指挥德音敕》：炀帝征辽之诏书。",
      "飞燕：汉赵飞燕，传能掌上舞。",
      "儒生饰于文字：儒生夸饰之辞。"
     ]
    },
    {
     "译": [],
     "注": [
      "鸦黄：额黄，古代女子妆饰。",
      "亸袖：袖垂。",
      "憨生：憨态。"
     ]
    },
    {
     "译": [],
     "注": [
      "上大悦：炀帝大喜。"
     ]
    },
    {
     "译": [],
     "注": [
      "汴：汴河，隋炀帝开通济渠。",
      "龙舟：皇帝所乘大船。",
      "萧妃：炀帝皇后萧氏。",
      "蒲泽国：传说之国。",
      "殿脚女：牵船的宫女，事见《开河记》。"
     ]
    }
   ]
  },
  {
   "题解": "唐玄宗与杨贵妃冬幸华清宫，汤池奢华。",
   "段落": [
    {
     "译": [],
     "注": [
      "明皇：唐玄宗李隆基。",
      "华清宫：在骊山，唐玄宗建，温泉宫。",
      "端正楼：华清宫中楼。",
      "莲花汤池：杨贵妃沐浴之所，为莲花汤。",
      "文瑶：美玉。",
      "凫雁：水鸟。",
      "钑镂：雕刻，此处“施（泛）钑镂”，指泛小舟。",
      "金沟：宫中排水沟。",
      "奉御汤：御用之汤池。",
      "长汤十六所：另有十六处汤池。"
     ]
    }
   ]
  },
  {
   "题解": "前蜀后主王衍荒淫，宣华苑长夜之饮，游浣花遇风暴溺者数千。",
   "段落": [
    {
     "译": [],
     "注": [
      "王衍：前蜀末帝，王建幼子，字化原。",
      "梁贞明五年：919年，后梁末帝年号。",
      "王错：前蜀大臣。",
      "六军诸卫：禁军各卫。",
      "灌口神：蜀人祀二郎神，此谓王衍戎装如神。",
      "汉州：今四川广汉。",
      "阆中：今四川阆中。",
      "宣华苑：前蜀宫苑。",
      "舄履交错：男女杂坐，鞋履交错。",
      "嘉王宗寿：王宗寿，王建养子，封嘉王。",
      "潘在迎、顾在珣、韩昭：前蜀佞臣。",
      "李玉箫：前蜀宫人。",
      "宫词：以宫廷生活为题的诗。"
     ]
    },
    {
     "译": [],
     "注": [
      "五云：五色祥云。",
      "月华：月光。"
     ]
    },
    {
     "译": [],
     "注": [
      "上巳：三月初三。",
      "昭神亭：宣华苑中亭。",
      "《霓裳羽衣》：唐著名乐舞曲。",
      "《后庭花》：陈后主所制曲。",
      "《思越人曲》：词牌名。",
      "浣花：浣花溪，今成都浣花溪公园一带。",
      "百花潭：成都浣花溪畔。",
      "万里桥：成都城南桥。",
      "白鱼：此指龙蛇之变。"
     ]
    }
   ]
  },
  {
   "题解": "元宫制五云车，以五色锦盖，夜游不用灯烛。",
   "段落": [
    {
     "译": [],
     "注": [
      "五云车：元宫所制五厢车，应五方五色。",
      "火树：红色珊瑚树，或指红色装饰。",
      "乌棱：乌木。",
      "翠羽盖：翠鸟羽毛所作车盖。",
      "磨锷：磨亮刀刃。",
      "白鸠缉毳盖：白鸠羽、毳毛所作之盖。",
      "豹绒连珠枪：豹毛饰的连珠枪。",
      "红猴毛毡盖：红色猴毛毡盖。",
      "朱雀：南方之神。",
      "兔团毫盖：兔毛制盖。",
      "玄武：北方之神。",
      "画干：绘饰之盾。",
      "勾陈：中央之神，星官名。",
      "晦夜：月终之夜。"
     ]
    }
   ]
  },
  {
   "题解": "元武宗泛舟太液池，设“凤队”“鹤团”水战之戏，骆妃歌舞。",
   "段落": [
    {
     "译": [],
     "注": [
      "元武宗：元武宗海山，1307—1311年在位。",
      "太液池：元宫苑池。",
      "画鹢：画有鹢鸟的船。",
      "泥金：金粉。",
      "氅裘：鹤氅。",
      "沥粉：一种堆线工艺。",
      "蜻翅之脯：美味。",
      "秋风之鲙：用张翰莼鲈之思典，鲙为细切鱼肉。",
      "玄霜：仙药，此指美酒。",
      "《八展》舞：舞名。",
      "《贺新凉》：词牌，即《贺新郎》。",
      "西王母宴穆天子于瑶池：《穆天子传》所载。",
      "上元夫人：仙人，见《汉武内传》。",
      "步玄之声：上元夫人所唱步玄之曲。",
      "骆妃：武宗妃子。",
      "《月照临》：舞曲名。"
     ]
    },
    {
     "译": [],
     "注": [
      "五华：五彩光华。",
      "丽正：光明正大。",
      "中域：中原。"
     ]
    },
    {
     "译": [],
     "注": [
      "八宝盘：嵌八宝之盘。",
      "玳瑁盏：玳瑁酒杯。",
      "《龙归洞》：军乐名。"
     ]
    }
   ]
  },
  {
   "题解": "元顺帝荒于宴游，作昆仑巾、紫霓城，宠凝香儿，舟游西湖。",
   "段落": [
    {
     "译": [],
     "注": [
      "顾帝：“顾”疑为“顺”之误，指元顺帝妥懽帖睦尔，在位1333—1370。",
      "祓：春秋祭礼，除不祥，于水边举行。",
      "迎祥亭：元宫苑内亭名。",
      "漾碧池：元宫苑内池名。",
      "蜀锦：蜀地所产锦。",
      "狻猊：传说中的猛兽。",
      "球筑：球与筑，击球、击筑，游戏之具。",
      "夭桃：艳丽桃花，语本《诗经》“桃之夭夭”。",
      "蹇桃夫人：宠称。"
     ]
    },
    {
     "译": [],
     "注": [
      "丽嫔：宫嫔位号。",
      "等于驰电：像闪电一样快，言人生短促。",
      "昆仑巾：头巾名。",
      "飞琼流翠之袍：华丽长袍。",
      "帝子云霓之服：仙人服饰。",
      "绣丝绞布之裘：华美衣装。",
      "春阳一线巾：头巾名。",
      "东海长生公：传说仙人。",
      "金仙羽客：神仙道士。",
      "内竖：宦官。",
      "壶岛：壶中、岛屿，仙境。",
      "太素仙妃：宠称。",
      "万岁山：元大都琼华岛，在北海。",
      "天台、赤城：浙江名山，传为仙境。",
      "紫霓城：筑垣之名。"
     ]
    },
    {
     "译": [],
     "注": [
      "官妓：官府所属乐伎。",
      "才人：宫中女官。",
      "翻冠飞履之舞：高难度舞蹈。",
      "琐里：古国名，在南亚。",
      "撒哈刺：毛织物，出西域。",
      "至元间：元顺帝有后至元（1335—1340）。",
      "于阗国：古西域国，在今新疆和田。",
      "婆娑之队：舞蹈队伍。"
     ]
    },
    {
     "译": [],
     "注": [
      "瑶环：美玉环。",
      "琼珰：玉制耳饰。",
      "徜徉：悠闲。"
     ]
    },
    {
     "译": [],
     "注": [
      "蟾光：月光。",
      "娥影：月中嫦娥之影。"
     ]
    },
    {
     "译": [],
     "注": [
      "万古：永恒。"
     ]
    },
    {
     "译": [],
     "注": [
      "天香亭：元宫苑亭台。",
      "昂鸾缩鹤之舞：舞名。",
      "《霓裳羽衣》：见前，唐代名舞。"
     ]
    },
    {
     "译": [],
     "注": [
      "玉泉山：北京西郊名山，有玉泉。",
      "吕公岩：玉泉山岩名。",
      "西湖：京城西瓮山泊，今颐和园昆明湖前身。",
      "荷蒲菱芡：荷花、蒲草、菱角、芡实。",
      "伽南：伽南香，沉香之一种。",
      "鹢：水鸟，画于船头。",
      "《采菱曲》：民间采菱之曲。",
      "《水面剪青》：曲调名。"
     ]
    },
    {
     "译": [],
     "注": [
      "夷犹：从容。",
      "金风：秋风。"
     ]
    },
    {
     "译": [],
     "注": [
      "青角：菱角。",
      "归去来：用陶渊明《归去来兮辞》。"
     ]
    },
    {
     "译": [],
     "注": [
      "曛：落日余光。"
     ]
    }
   ]
  },
  {
   "题解": "河间王听歌，一曲赏一金牌。",
   "段落": [
    {
     "译": [],
     "注": [
      "河间王：待考。",
      "金牌：金制之牌，赏赐之物。"
     ]
    }
   ]
  },
  {
   "题解": "张宪以娼妓分任事务，号凤窠群女；后附王武子、杨国忠、孙晟、杜驯诸人以妓为器之事。",
   "段落": [
    {
     "译": [],
     "注": [
      "姑臧：今甘肃武威，唐凉州治。",
      "张宪：待考。",
      "拂壶：待考。",
      "傅芳妓：奏书者之号。",
      "龙津女：酌酒者之号。",
      "仙盘使：侍食者。",
      "墨蛾：代书者。",
      "龙姬：接香者。",
      "凤窠群女：总称。"
     ]
    },
    {
     "译": [],
     "注": [
      "王武子：王济，字武子，晋人，武帝女婿，豪侈。",
      "杨国忠：杨贵妃堂兄，唐玄宗宰相。"
     ]
    },
    {
     "译": [],
     "注": [
      "晋武帝：司马炎。",
      "王武子：王济。",
      "琉璃器：琉璃之器，晋时珍贵。",
      "绫罗袴褶：绫罗制的裤与短袄。"
     ]
    },
    {
     "译": [],
     "注": [
      "肉台盘：以人代台盘。",
      "肉屏风：以人为屏风。",
      "肉障肉阵：以人为屏障。"
     ]
    },
    {
     "译": [],
     "注": [
      "孙晟：五代南唐大臣，奢侈。",
      "杭州别驾杜驯：杜驯，唐杭州别驾，别驾为州刺史属官。",
      "肉台：以人做台。"
     ]
    }
   ]
  },
  {
   "题解": "岐王以妓怀暖手。",
   "段落": [
    {
     "译": [],
     "注": [
      "岐王：唐玄宗弟李范，封岐王。",
      "暖手：取暖之举。"
     ]
    }
   ]
  },
  {
   "题解": "封陟以婢执烛围坐。",
   "段落": [
    {
     "译": [],
     "注": [
      "封陟：待考。",
      "烛围：以人围烛。"
     ]
    }
   ]
  }
 ]
}