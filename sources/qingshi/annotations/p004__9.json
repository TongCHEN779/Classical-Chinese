{
 "start": 9,
 "items": [
  {
   "题解": "董国度陷金后，其妾与“兄”设计，将他护送南归，并以袍中藏金回报；后附严蕊、薛希涛等不屈之妓事。",
   "段落": [
    {
     "译": [],
     "注": [
      "董国度：字元卿，饶州人，事见宋人笔记。",
      "宣和六年：1124年，宣和为宋徽宗年号。",
      "胶水：宋莱州属县，在今山东平度一带。",
      "北兵动：指金兵南侵。",
      "中原陷：指靖康之变（1127）后金占中原。",
      "逆旅主人：旅店主人。",
      "磨驴：推磨用驴。",
      "斛：量器，宋时一斛约五斗。",
      "嬖爱：宠爱。",
      "南官：此指宋朝官员，金人占领区称宋官为南官。",
      "虬髯：卷曲的胡须。",
      "叙姻亲之礼：以兄妹姻亲之礼相见。"
     ]
    },
    {
     "译": [],
     "注": [
      "自陈：自首，指向金方自首身份。",
      "告身：官员的任命文书。",
      "衲袍：缝补的袍，此指加厚的衣袍。",
      "解维：解缆开船。",
      "旗亭：市楼，酒楼。",
      "太夫人：官员之母的尊称。",
      "箔金：金箔。"
     ]
    },
    {
     "译": [],
     "注": [
      "严蕊：见下文，天台营妓。",
      "薛希涛：见后文，杭州官妓。"
     ]
    },
    {
     "译": [],
     "注": [
      "天台：宋台州治，今浙江临海。",
      "营妓：隶属官府的乐伎。",
      "唐与正：唐仲友，字与正，婺州金华人，时知台州。",
      "《如梦令》：词牌名，为小令，五代以来多见。"
     ]
    },
    {
     "译": [],
     "注": [
      "梨花：此词咏红白桃花，故说似梨花杏花而非。",
      "武陵：用陶渊明《桃花源记》武陵渔人事，桃花之典。"
     ]
    },
    {
     "译": [],
     "注": [
      "双缣：两匹绢。",
      "朱晦庵：朱熹，号晦庵，时任浙东提举。",
      "行部：巡行所属部分。",
      "摭：搜集。",
      "滥：私通。",
      "阜陵：宋孝宗，葬永阜陵，故称。",
      "岳霖商卿：岳霖，字商卿，岳飞之子，时任浙东提点刑狱。",
      "宪：提点刑狱使，掌刑狱。",
      "《卜算子》：词牌名，双调，四十四字。"
     ]
    },
    {
     "译": [],
     "注": [
      "风尘：此指妓女生涯。",
      "东君：司春之神，此喻主宰命运者。"
     ]
    },
    {
     "译": [],
     "注": [
      "山花插满头：宋人以头戴花为风流，此喻自由归隐。"
     ]
    },
    {
     "译": [],
     "注": [
      "从良：妓女脱籍嫁人。",
      "宗室：皇族。",
      "小妇：妾。"
     ]
    },
    {
     "译": [],
     "注": [
      "以己姓为韵：用谢字为韵作词。",
      "《鹊桥仙》：词牌，咏七夕多用此调。"
     ]
    },
    {
     "译": [],
     "注": [
      "穿针：七夕乞巧习俗。",
      "合欢楼：楼名，与七夕牛女之事相联。",
      "玉盘：喻月。"
     ]
    },
    {
     "译": [],
     "注": [
      "蛛忙鹊懒：七夕，蜘蛛织巧，鹊鸟填桥。",
      "隔年期：牛郎织女一年一会。"
     ]
    },
    {
     "译": [],
     "注": [
      "缠头：赠妓的财物。",
      "文公：朱熹，谥文，称朱文公。"
     ]
    },
    {
     "译": [],
     "注": [
      "长卿氏：此评语署长卿氏，与前“长卿氏曰”同。",
      "圣贤大学：指《大学》，朱熹所作《大学章句》。",
      "石压笋料出：俗语，石压笋斜出，此喻逆境中更显才华。"
     ]
    },
    {
     "译": [],
     "注": [
      "祖无择：北宋大臣，熙宁时知杭州，被王安石所劾。",
      "官妓：官府所属乐妓。",
      "王安石：宋神宗时宰相，号荆公。",
      "榜笞：杖打。",
      "承伏：认罪。"
     ]
    },
    {
     "译": [],
     "注": [
      "干：疑指清白无实，后者“湿”则指有私，一说待考。",
      "荆公：王安石封荆国公。",
      "晦翁：朱熹。",
      "道学：指程朱理学。"
     ]
    }
   ]
  },
  {
   "题解": "陈亡之际，徐德言与乐昌公主以破镜为约，终得杨素成全，破镜重圆。",
   "段落": [
    {
     "译": [],
     "注": [
      "徐德言：陈太子舍人，其事见唐孟棨《本事诗》。",
      "后主叔宝：陈后主陈叔宝。",
      "乐昌公主：陈后主之妹，嫁徐德言。",
      "情绦：男女情缘。",
      "越公杨素：隋重臣，封越国公。",
      "苍头：奴仆。",
      "设食：备饭。"
     ]
    },
    {
     "译": [],
     "注": [
      "嫦娥：月中仙女，以月比镜。"
     ]
    },
    {
     "译": [],
     "注": [
      "怆然：悲伤。",
      "遗：赠。",
      "口占：随口吟出。"
     ]
    },
    {
     "译": [],
     "注": [
      "迁次：转换位次。",
      "新官对旧官：新旧之夫同席。"
     ]
    },
    {
     "译": [],
     "注": [
      "江南：陈故地。"
     ]
    },
    {
     "译": [],
     "注": [
      "红拂妓：见前《红拂妓》。",
      "大将军开门放妓：疑指杨素放妓事。",
      "石太尉：疑指石崇，因绿珠之事。"
     ]
    }
   ]
  },
  {
   "题解": "宁王李宪夺饼师之妻，见其泣，乃放归，王维赋诗纪事。",
   "段落": [
    {
     "译": [],
     "注": [
      "宁王宪：唐睿宗长子李宪（原名成器），封宁王。",
      "属目：注目。",
      "环岁：满一年。",
      "王右丞维：王维，官至尚书右丞。"
     ]
    },
    {
     "译": [],
     "注": [
      "不共楚王言：用息夫人事，《左传·庄公十四年》载息夫人入楚后不与楚王言。王维《息夫人》诗即此作。"
     ]
    },
    {
     "译": [],
     "注": []
    }
   ]
  },
  {
   "题解": "裴度化装访得被夺之妻，助新任湖州官员夫妇团圆，评语言权势造业。",
   "段落": [
    {
     "译": [],
     "注": [
      "元和：唐宪宗年号（806—820）。",
      "录事参军：州府属官，掌文书。",
      "告敕：任官文书。",
      "孑遗：剩余。",
      "在假：休假。",
      "裴晋公：裴度，封晋国公，后任中书令。",
      "上相：宰相。",
      "亲迎：婚礼中亲往迎娶。",
      "紫袴衫：紫色便服。",
      "亲校：亲信武官。",
      "赭衣吏：着赭色衣的官吏。",
      "令公：中书令的尊称。",
      "押牙：武官名，管仪仗侍卫。",
      "首过：自陈过错。",
      "官诰：任官文书。",
      "于飞：夫妻相随。语本《诗经》“凤皇于飞”。",
      "千贯：一千贯钱。",
      "《玉堂闲话》：五代王仁裕撰笔记。"
     ]
    },
    {
     "译": [],
     "注": [
      "造业：佛教语，指作恶业。",
      "要路者：居要位者。"
     ]
    }
   ]
  },
  {
   "题解": "江陵士子之姬被刺史所纳，士子寄诗，刺史令归还。",
   "段落": [
    {
     "译": [],
     "注": [
      "江陵：今湖北荆州。",
      "尺题：书信，此指求人荐举之书。",
      "交广：交州、广州，岭南。",
      "高丽坡：地名，此指刺史宅所在，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "阳台：用宋玉《高唐赋》巫山神女事。",
      "襄王：楚襄王。",
      "五度看花：指五年。"
     ]
    },
    {
     "译": [],
     "注": [
      "覆水：用姜太公妻事，覆水难收。"
     ]
    },
    {
     "译": [],
     "注": [
      "一百千：一百贯钱。",
      "《卢氏杂说》：唐卢言撰笔记。"
     ]
    }
   ]
  },
  {
   "题解": "以京师兵官得妻诗而还之，附崔郊、戎昱诗事，皆写权贵成人之美。",
   "段落": [
    {
     "译": [],
     "注": [
      "洪武：明太祖年号（1368—1398）。",
      "吴人姜子奇：姜子奇，吴地人，事见《西樵野记》。",
      "大军：明军。",
      "兵官：军官。",
      "京邸：京城宅第。"
     ]
    },
    {
     "译": [],
     "注": [
      "葵藿：葵花与豆叶，皆向日而倾，喻忠心。"
     ]
    },
    {
     "译": [],
     "注": [
      "杨花无力：杨花轻飘无力，喻身不由己。",
      "家山：故乡。"
     ]
    },
    {
     "译": [],
     "注": [
      "难把姓名通：无法相认。"
     ]
    },
    {
     "译": [],
     "注": [
      "《西樵野记》：明侯甸撰笔记。"
     ]
    },
    {
     "译": [],
     "注": [
      "武弁：武官。",
      "孔将军：待考。",
      "沙叱利：唐蕃将，夺韩翃之妾柳氏，见《柳氏传》。"
     ]
    },
    {
     "译": [],
     "注": [
      "于𬱖：即于頔，唐宪宗时襄阳节度使。",
      "韩滉：唐德宗时宰相，封晋国公。"
     ]
    },
    {
     "译": [],
     "注": [
      "崔郊：唐秀才，寓襄阳，事见《云溪友议》。",
      "汉上：汉水之滨，此指襄阳。",
      "阮咸之纵：阮咸与姑家鲜卑婢私通，见《晋书》。",
      "连帅：节度使。",
      "寒食：节日，清明前一日或二日。",
      "誓若山河：誓言如山河不变。"
     ]
    },
    {
     "译": [],
     "注": [
      "绿珠：晋石崇之妾，为权贵所逼坠楼死。",
      "侯门一入深如海：诗句千古传诵，萧郎指崔郊。",
      "萧郎：本指梁武帝萧衍，后泛指女子所爱之男子。"
     ]
    },
    {
     "译": [],
     "注": [
      "写诗于座：将诗写于席上。",
      "四百千：四十万钱，即买婢之价。",
      "帏幌奁匣：帐幔、梳妆匣等。",
      "零陵：今湖南永州。",
      "戎昱：唐诗人，曾为刺史。",
      "使君：刺史尊称。",
      "缣帛：丝织品。"
     ]
    },
    {
     "译": [],
     "注": [
      "宝钿：镶宝钗。",
      "襄王：楚襄王，此指节度使。",
      "阳台：巫山神女处。"
     ]
    },
    {
     "译": [],
     "注": [
      "浙西：韩滉为浙西观察使。",
      "乐将：掌乐之将。",
      "籍：乐籍。",
      "悚然：惊惧。",
      "笞之十：打十板。"
     ]
    },
    {
     "译": [],
     "注": [
      "柳条藤蔓：喻缠绵之情。"
     ]
    },
    {
     "译": [],
     "注": [
      "于、韩两公：于頔、韩滉。"
     ]
    },
    {
     "译": [],
     "注": [
      "唐玄宗：李隆基。",
      "僖宗：唐僖宗李儇。"
     ]
    },
    {
     "译": [],
     "注": [
      "开元：唐玄宗年号（713—741）。",
      "纩衣：丝绵衣。",
      "边军：边防军。"
     ]
    },
    {
     "译": [],
     "注": [
      "阿谁：谁，俗语。"
     ]
    },
    {
     "译": [],
     "注": [
      "后生缘：来世缘。"
     ]
    },
    {
     "译": [],
     "注": [
      "六宫：后宫。"
     ]
    },
    {
     "译": [],
     "注": [
      "神策军：唐禁军。",
      "金锁：金制小锁。"
     ]
    },
    {
     "译": [],
     "注": [
      "玉烛：烛的美称。"
     ]
    },
    {
     "译": [],
     "注": [
      "幸蜀：僖宗避黄巢入蜀。"
     ]
    },
    {
     "译": [],
     "注": [
      "王道本乎人情：语本儒家“王道不外乎人情”。"
     ]
    }
   ]
  },
  {
   "题解": "唐文宗宫妓沈翘翘因舞中引《文选》诗，得嫁秦诚，后作《忆秦郎》。",
   "段落": [
    {
     "译": [],
     "注": [
      "唐文宗：李昂。",
      "《河满子》：唐教坊曲，凄怨之调。",
      "浮云蔽白日：古诗《行行重行行》句，见《文选》古诗十九首，不是第一首，待考。",
      "吴元济：淮西节度使，元和十二年被擒。",
      "掖庭：宫中。",
      "乐籍：乐户名籍。",
      "方响：打击乐器，十六枚铁片悬架。",
      "梁州曲：唐教坊曲，凉州曲之讹，待考。",
      "金吾判官：金吾卫判官。"
     ]
    },
    {
     "译": [],
     "注": [
      "日本：此指使日本，待考。"
     ]
    }
   ]
  }
 ]
}