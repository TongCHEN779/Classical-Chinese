{
 "start": 5,
 "items": [
  {
   "题解": "明天顺间南阳卫千户之女王娇鸾与吴江周廷章墙头唱和成私约，周归乡后另娶，娇鸾自缢并将诗书寄公牍告发，周被巡按杖杀；本篇即《王娇鸾百年长恨》的缩写，是“情憾”一类的名篇。",
   "段落": [
    {
     "译": [],
     "注": [
      "天顺：明英宗年号（1457—1464）。",
      "临安卫：明代卫所名，具体所属待考。",
      "指挥：卫所武官。",
      "参：弹劾。",
      "降调：降职调任。",
      "南阳卫：明代河南南阳的卫所。",
      "千户：卫所武官，统千户所。",
      "文移：官府公文往来。",
      "钟爱：特别疼爱。"
     ]
    },
    {
     "译": [],
     "注": [
      "清明节：古代节日，有荡秋千之俗。",
      "罗帕：丝帕。",
      "逾垣：翻墙。",
      "本学司教：本地学宫的教官，指府县学教谕、训导一类。",
      "桃花笺：红色的诗笺。",
      "方胜：折成两菱相叠的信笺样式。",
      "缄：封好的信。"
     ]
    },
    {
     "译": [],
     "注": [
      "红丝：用月下老人红丝系足、郭元振牵红丝线得妻之典，喻姻缘。",
      "洞房：深邃的内室。"
     ]
    },
    {
     "译": [],
     "注": [
      "亦取笺答诗：也取笺纸写诗作答。"
     ]
    },
    {
     "译": [],
     "注": [
      "侯门将相家：谓出身官宦显贵之家。",
      "碧梧：梧桐，凤凰非梧桐不栖，自比有操守，只许佳偶。"
     ]
    },
    {
     "译": [],
     "注": [
      "奇凤：奇异的凤凰，指周生，以凤自比喻“梧”，下句以老鸦喻俗人。",
      "翠竹那容入老鸦：续上句，言不容俗人接近。",
      "孤零客：孤身羁旅之人。"
     ]
    },
    {
     "译": [],
     "注": [
      "赂：赠送财物。"
     ]
    },
    {
     "译": [],
     "注": [
      "端阳节：端午节。"
     ]
    },
    {
     "译": [],
     "注": [
      "蒲觞：菖蒲酒，端午饮之。",
      "彩线：端午时系臂的五彩丝线，喻结缘。",
      "锦葵：葵类花，向日而倾，喻向往之心。"
     ]
    },
    {
     "译": [],
     "注": [
      "曹姨：娇鸾姨母，姓曹，称“曹姨”。",
      "冰人：媒人。典出《晋书·索紞传》令狐策梦冰上与冰下人语。",
      "雅重：素来敬重。",
      "衙斋：官署中的书房。",
      "肄业：学习。",
      "饔飧：早饭与晚饭，泛指饮食。",
      "盟主：此指见证主持盟誓的人。",
      "幽期：私下的约会。",
      "绸缪：情意缠绵。"
     ]
    },
    {
     "译": [],
     "注": [
      "升任：此指教官升迁他任。",
      "引疾：称病辞官。",
      "归觐：回乡探望父母。",
      "定省：晨昏向父母请安。",
      "赆：临别赠送的路费。",
      "束装：整理行装。"
     ]
    },
    {
     "译": [],
     "注": [
      "毕姻：完婚。",
      "贪财慕色：贪图财物，爱慕美色。"
     ]
    },
    {
     "译": [],
     "注": [
      "生耗：周生的消息。",
      "便邮：顺便的邮递。",
      "的信：确切消息。",
      "卫卒：卫所的士兵。",
      "古风：古体诗。"
     ]
    },
    {
     "译": [],
     "注": [
      "邂逅：不期而遇。",
      "嘲风弄月：吟咏风月，指男女唱和调情。",
      "侯门曳断千：指荡秋千，“曳断千金索”承下段。"
     ]
    },
    {
     "译": [],
     "注": [
      "青丝结死生：以青丝结发，誓同生死。",
      "盟山誓海：对着山海发誓，言盟誓坚固。",
      "白云渺渺：用狄仁杰登太行望白云思亲之典，指周思亲。"
     ]
    },
    {
     "译": [],
     "注": [
      "桃脸：桃花般的脸。",
      "传书雁：用雁足传书之典。",
      "排鸾驭：谓乘鸾车远行，待考。",
      "征蛮：指其父因征广西苗蛮之事被参，见段0。"
     ]
    },
    {
     "译": [],
     "注": [
      "执手牵衣：握手拉衣，形容离别难舍。",
      "鸾凤友：夫妻。",
      "苏城：苏州城。",
      "攒眉：皱眉。",
      "脂粉慵调：懒于梳妆。"
     ]
    },
    {
     "译": [],
     "注": [
      "如帚：头发蓬乱如扫帚。",
      "梅花蝴蝶梦：用庄周梦蝶之典，言空梦一场。",
      "雪月风花：风花雪月。"
     ]
    },
    {
     "译": [],
     "注": [
      "魂颠倒：神魂不定。",
      "盟言：盟誓之言。",
      "九天玄女：传说中的女神，传授黄帝兵法，民间奉为盟誓的见证。"
     ]
    },
    {
     "译": [],
     "注": [
      "传遍：传到各处。",
      "归泉：归于黄泉。",
      "驰驿使：驰马驿递的使者。",
      "丹心：赤诚之心。",
      "三七：或指二十一岁，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "花貌：花一般的容貌。",
      "香闺：女子居室。"
     ]
    },
    {
     "译": [],
     "注": [
      "备述：详尽叙述。"
     ]
    },
    {
     "译": [],
     "注": [
      "延陵桥：桥名，在吴江，待考。",
      "薄幸：薄情负心。"
     ]
    },
    {
     "译": [],
     "注": [
      "绝命诗：临死前所作的诗。",
      "长恨歌：此指仿白居易《长恨歌》体的长诗。",
      "抱石投崖：抱石自沉或投崖，表示以死明志。",
      "公牍：公文。",
      "勾：勾捕。",
      "逃军：逃亡的军士。",
      "合同婚书：双方各执一份的婚约文书。",
      "自缢：上吊自杀。"
     ]
    },
    {
     "译": [],
     "注": [
      "吴江令：吴江县令。",
      "直指：直指使者，即巡按御史。",
      "樊公祉：樊祉，其人待考。",
      "司理：推官，掌刑狱。",
      "榜杀：杖杀。"
     ]
    },
    {
     "译": [],
     "注": [
      "人诛：人间的惩罚。",
      "鬼谴：鬼神的责罚。"
     ]
    }
   ]
  }
