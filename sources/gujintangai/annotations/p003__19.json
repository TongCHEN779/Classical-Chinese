{
 "start": 19,
 "items": [
  {
   "题解": "北齐文宣帝荒淫暴虐、东昏侯等的恶痴行径，一一荒唐。",
   "段落": [
    {
     "译": [],
     "注": [
      "齐文宣：北齐文宣帝高洋，晚年酗酒淫暴。",
      "沈湎：沉溺于酒。",
      "刘桃枝：高洋的亲信，常为其行刑。",
      "崔季舒：北齐大臣，时为高洋侍从。",
      "牟槊：长矛。",
      "裴谒之：北齐大臣，以直谏著称，《北齐书》有传。",
      "杨愔：北齐名臣，文宣帝近臣。"
     ]
    },
    {
     "译": [],
     "注": [
      "太后：娄太后。",
      "高归彦：北齐宗室，后因谋反被杀。",
      "疏：陈述自责的奏疏。"
     ]
    },
    {
     "译": [],
     "注": [
      "三台：邺城铜雀、金虎、冰井三台，文宣帝时重修。",
      "折旋中节：舞蹈转身合乎节拍。",
      "死囚以席为翅：以席作翅让死囚飞下，放飞者多死。"
     ]
    },
    {
     "译": [],
     "注": [
      "薛嫔：文宣帝宠妃薛氏，被其杀害。",
      "清河王岳：高岳，北齐宗室。",
      "柈：同“盘”。",
      "髀：大腿骨。",
      "佳人难再得：李延年歌辞“北方有佳人”之句。"
     ]
    },
    {
     "译": [],
     "注": [
      "幼主：北齐后主高纬，年幼即位。",
      "羌兵：黑衣装扮的假兵。",
      "内参：近侍。",
      "晋阳：今山西太原。",
      "华林园：北齐皇家园林，在邺城。",
      "乞食儿：乞丐。",
      "穷儿之市：仿穷人的集市。"
     ]
    },
    {
     "译": [],
     "注": [
      "随炀帝：隋炀帝杨广。",
      "景华宫：隋洛阳的宫苑。",
      "斛：古代容量单位，十斗。"
     ]
    },
    {
     "译": [],
     "注": [
      "明帝：南齐明帝萧鸾。",
      "东昏：东昏侯萧宝卷，南齐末帝。",
      "太极殿：南齐宫殿正殿。",
      "徐孝嗣：南齐大臣，后被东昏杀。",
      "大中大夫：官名。",
      "羊阐：南齐官员，待考。",
      "帻：包头巾。"
     ]
    },
    {
     "译": [],
     "注": [
      "尉司：巡街的官吏。",
      "徒跣：赤脚。",
      "剖腹视男女：东昏侯荒唐事，见《南齐书》。"
     ]
    },
    {
     "译": [],
     "注": [
      "阅武堂：南京的阅兵场所，南齐时建。",
      "至尊：对皇帝的称呼。",
      "潘妃：东昏侯宠妃潘玉儿。"
     ]
    },
    {
     "译": [],
     "注": [
      "唐太子承乾：唐太宗长子李承乾，后废为庶人。",
      "汉王云昌：疑即汉王元昌（唐高祖之子），原文作“云昌”。",
      "厮役：杂役。"
     ]
    }
   ]
  },
  {
   "题解": "唐敬宗造风流箭射宫嫔，宫中称“风流箭”，语涉淫荡而仅是游戏。",
   "段落": [
    {
     "译": [],
     "注": [
      "宝历：唐敬宗年号（825—827）。",
      "竹皮弓：用竹皮做成的玩具弓。",
      "龙麝：龙脑香与麝香。",
      "楚害：伤害。",
      "中的人人愿：被射中的人个个愿意。"
     ]
    }
   ]
  },
  {
   "题解": "鹅、螳螂、鳜鱼等是痴畜生，本节总结“痴”之无理。",
   "段落": [
    {
     "译": [],
     "注": [
      "鹅头：俗称痴人为“鹅头”，鹅见人伸颈而吓。",
      "螳螂怒臂，以当车辙：语出《庄子·人间世》，喻不自量力。",
      "鳜鱼：淡水鱼，背鳍有硬棘。",
      "鬛：同“鬣”，鳍。"
     ]
    },
    {
     "译": [],
     "注": [
      "乌鲗鱼：墨鱼。",
      "攒口：把足拢到口边。",
      "锦鸡：羽毛华美的雉科鸟，传说爱其毛羽，临水自照而溺。"
     ]
    },
    {
     "译": [],
     "注": [
      "半翅鸟：陕西所产鸟名，说法待考。",
      "痴半斤：俗称，因其呆痴。",
      "红裙袄：红色裙与短袄。"
     ]
    },
    {
     "译": [],
     "注": [
      "蚺蛇：热带大蛇，南方多有。",
      "寨兵：驻守山寨的兵。",
      "红娘子：蛇为红花所迷，兵呼“红娘子”诱之。",
      "俛：同“俯”。",
      "舁：抬。"
     ]
    }
   ]
  }
 ]
}