 "items": [
  {
   "题解": "吴珪携红玉返金陵，改名无娇，与女儿无艳同称姊妹；灵谷寺赏梅见到苏友白题诗，查访其才名、出身后托张媒婆说亲，友白偷看却误把无艳当无娇而推辞。吴翰林转托门生刘玉成。此回引出男主角苏友白，并埋下换人误会的伏笔。",
   "段落": [
    {
     "译": [],
     "注": []
    },
    {
     "译": [],
     "注": [
      "高才果得似黄金：谓高才若如黄金，不愁无人买。"
     ]
    },
    {
     "译": [],
     "注": [
      "雷焕：晋人，张华命他观天象，知丰城有剑气，掘得龙泉、太阿二剑，见《晋书·张华传》。此处喻宝剑（才人）被埋没。",
      "子期：钟子期，善听伯牙琴，知音之典，见《吕氏春秋·本味》。",
      "气味：志趣相投。"
     ]
    },
    {
     "译": [],
     "注": [
      "关雎：《诗经》首篇，咏君子求淑女，借指夫妻和谐之乐。",
      "伐木：《诗经·小雅·伐木》，写朋友燕饮，求其友声。"
     ]
    },
    {
     "译": [],
     "注": [
      "遇而不遇：遇到而不被赏识。"
     ]
    },
    {
     "译": [],
     "注": [
      "脱离虎口：摆脱险境。",
      "姑表姊妹：姑母之女与舅父之女互称姑表。红玉之母吴氏是吴珪之妹，红玉对无艳是姑母之女，故称姑表。",
      "无艳：吴珪之女。",
      "嫡亲：亲生。",
      "跟寻：追踪寻找。"
     ]
    },
    {
     "译": [],
     "注": [
      "残冬：腊月。",
      "绅宦：乡绅与官宦。",
      "灵谷寺：在南京钟山东南，明初建，近孝陵，周围多梅，为金陵赏梅胜地。",
      "绿萼：梅花品种，萼绿花白。",
      "冷香：梅花清冷的香气。"
     ]
    },
    {
     "译": [],
     "注": [
      "陶士敏：未详，疑为书中虚构的前人。",
      "单道：单说。"
     ]
    },
    {
     "译": [],
     "注": [
      "琼枝：玉树之枝，喻梅花。",
      "瑶台：神话中仙人居处。"
     ]
    },
    {
     "译": [],
     "注": [
      "雪满山中高士卧：以高士卧雪喻梅花清高。",
      "月明林下美人来：隋赵师雄在罗浮山遇淡妆素服美人，与之共饮，醒来在梅树下，见柳宗元《龙城录》。林下美人，指梅花神。"
     ]
    },
    {
     "译": [],
     "注": [
      "潇潇：此处形容竹的萧疏。",
      "漠漠：密布的样子。"
     ]
    },
    {
     "译": [],
     "注": [
      "何郎：南朝梁诗人何逊，曾在扬州作《咏早梅》诗，后人以“何郎”称咏梅者。",
      "东风愁寂：东风为梅所愁。"
     ]
    },
    {
     "译": [],
     "注": []
    },
    {
     "译": [],
     "注": [
      "霜华：霜花。",
      "绣帐：此处喻护梅的帐幕。"
     ]
    },
    {
     "译": [],
     "注": [
      "待月村：喻待月赏梅。"
     ]
    },
    {
     "译": [],
     "注": [
      "锁来肯信玉为魂：玉为魂，喻梅之精魂如玉。"
     ]
    },
    {
     "译": [],
     "注": [
      "罗浮客：见前，罗浮山梅花仙，赵师雄所遇。"
     ]
    },
    {
     "译": [],
     "注": [
      "酒酣换席：喝到半醉，换了座位。",
      "巨公：地位高的人。",
      "泛泛：平庸。",
      "粉壁：白墙。",
      "龙蛇飞舞：形容书法飞动。"
     ]
    },
    {
     "译": [],
     "注": [
      "离离：繁盛下垂的样子。",
      "古淡：古朴淡雅。"
     ]
    },
    {
     "译": [],
     "注": [
      "魂销：销魂，因感动而神魂摇荡。",
      "酒谢之：用酒酬谢。"
     ]
    },
    {
     "译": [],
     "注": [
      "雪压倒疑过梦处：句意待考。",
      "月昏摹拟嫁林时：句意待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "闺人品：像闺秀一样的品格。",
      "妾视桃花婢柳枝：把桃花当作妾，把柳枝当作婢，言梅胜过桃柳。"
     ]
    },
    {
     "译": [],
     "注": [
      "苏友白：书中男主角，字莲仙，下文有交代。"
     ]
    },
    {
     "译": [],
     "注": [
      "鲍关府庾参军：当作“庾开府、鲍参军”，杜甫《春日忆李白》“清新庾开府，俊逸鲍参军”，指庾信与鲍照，“关”疑当作“开”。",
      "庸腐：平庸迂腐。",
      "随喜：佛教语，见善事而随同欢喜，后指游寺观。",
      "观音院：寺中附设的院落。",
      "徘徊：来回走。",
      "列位老爷：对众官员的敬称。"
     ]
    },
    {
     "译": [],
     "注": [
      "怅然：失意的样子。",
      "日已平西：日已偏西。",
      "体：体面。"
     ]
    },
    {
     "译": [],
     "注": [
      "红毡毯子：红色毛毡。",
      "酒盒：盛酒食的食盒。",
      "酸的酸，腐的腐：形容读书人寒酸迂腐。",
      "片巾：一种无角的便帽。",
      "素服：白色或不着彩色的衣服。"
     ]
    },
    {
     "译": [],
     "注": [
      "冠玉：帽上的美玉，喻男子容貌俊美，语出《史记·陈丞相世家》“状如冠玉”。",
      "锦绣文心：文思华美。",
      "卫玠：晋人，美姿容，号“璧人”，见《世说新语·容止》。",
      "潘安：潘岳，字安仁，西晋文学家，貌美，《世说新语·容止》载“掷果盈车”。",
      "纨裤：同“纨绔”，指富家子弟。"
     ]
    },
    {
     "译": [],
     "注": [
      "内外兼美：容貌与才学兼备。",
      "能事家人：办事能干的家人。"
     ]
    },
    {
     "译": [],
     "注": []
    },
    {
     "译": [],
     "注": [
      "乌衣巷：在南京秦淮河南，东晋时王谢居此，唐刘禹锡《乌衣巷》诗使其出名。",
      "府学生员：府学的秀才。生员，即明清入学的秀才。",
      "祖籍：先世居住地。"
     ]
    },
    {
     "译": [],
     "注": [
      "唾手成矣：喻容易成功。",
      "赘：入赘，男子嫁到女家。",
      "山人词客：山人，隐居的文人；词客，诗人，常指游食的文人。",
      "全璧：完美。",
      "进学：考取生员入学。",
      "殁：死。",
      "丁了三年忧：遭父母丧，守制三年，称丁忧。",
      "服满：守丧期满。",
      "李学院：李学道，学院是提学官，书中虚构。",
      "岁考：学院按年对生员的考试，决定等第。",
      "案：发榜，榜单。",
      "宗师：对提学官的尊称。",
      "斋夫：学校中供役使的人。",
      "等数：名次等第。"
     ]
    },
    {
     "译": [],
     "注": [
