 "items": [
  {
   "题解": "蒋平赴柳青之约途中借宿豆腐房，夜入荒庙杀恶僧，救姚王氏姊弟并遇旧识龙涛，使龙涛、姚猛前往陈起望；次日抵柳家庄，柳青设下“开门揖盗”之局，与蒋平订下盗簪、还簪之赌。",
   "段落": [
    {
     "译": [],
     "注": [
      "屉板罗格：做豆腐的器具，屉板用来压榨，罗为筛滤的筛子，格待考。",
      "抖晾：抖开晾晒。",
      "小老儿：老人自称。",
      "老伴儿：老夫老妻互称。",
      "相知：知己朋友。",
      "壁灯：置于壁龛上的油灯。",
      "烘衣：烘烤衣服。",
      "动转：活动劳作。",
      "尊便：请自便，客气话。"
     ]
    },
    {
     "译": [],
     "注": [
      "打尖：旅途中吃点东西。",
      "撢：同“掸”，拂去灰尘。",
      "不作劲儿：不争气，指肚子饿得难受。",
      "剔：拨亮灯芯。",
      "兵刃交架：兵器相互格挡。",
      "荒僻：荒凉偏僻。",
      "夤夜：深夜。",
      "紧行：加快步伐。",
      "越墙：翻墙。"
     ]
    },
    {
     "译": [],
     "注": [
      "姚王氏：姚猛之妻，姓王。",
      "禅堂：僧人坐禅的堂屋，此处指庙中客堂。",
      "击户：敲门。",
      "一更：约晚七至九时。",
      "逼勒：强迫。",
      "算帐：了结账目，此处指报复。",
      "爷爷：对人的尊称。",
      "门闩：门后横插的木棍。",
      "四平：枪棒中一种平端的架势。",
      "胁下：腋下至肋骨处。",
      "痛彻心髓：疼痛极深。",
      "了帐：结束，此指死去。",
      "身入空门：出家做和尚。",
      "一念之差：一时的念头错误。"
     ]
    },
    {
     "译": [],
     "注": [
      "恩公：对救命恩人的称呼。",
      "龙涛：曾为捕快，与蒋平相识。",
      "花蝶：采花贼花冲的绰号，前文被龙涛等人所拿。",
      "缴了回批：交回官府的批文，指办完差使回衙缴令。",
      "捕快：旧时衙门中缉捕盗贼的差役。",
      "告退不当：辞去不干。",
      "辖制：管束。",
      "搠：刺，捅。",
      "再生之德：救命大恩。"
     ]
    },
    {
     "译": [],
     "注": [
      "诓：哄骗。",
      "姚猛：姚王氏之夫，后文随龙涛赴陈起望。",
      "益发：越发，更加。",
      "故人：死去的人，此指去世。",
      "敢是：莫非是，想必是。",
      "至契：交情极深。"
     ]
    },
    {
     "译": [],
     "注": [
