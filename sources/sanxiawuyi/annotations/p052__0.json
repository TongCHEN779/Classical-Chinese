 "items": [
  {
   "题解": "本回写武平安供认杀害外甥，三贼寄监；包世荣病中逃入学究方善家，方善被诬入狱后托宁婆为女儿玉芝议婚，世荣写密信由宁婆投递平县知县，是营救三公子与方善的转折。",
   "段落": [
    {
     "译": [],
     "注": [
      "山漥子：山洼，低凹处，漥同“洼”。",
      "性起：一时火起、发作。",
      "行劫：拦路抢劫。",
      "寄监：暂押在监狱，听候处理。"
     ]
    },
    {
     "译": [],
     "注": [
      "学究：乡村塾师。",
      "寒儒：贫寒的读书人。",
      "上房：正房；旧式院落中坐北朝南的主屋。",
      "厢房：正房两侧的房屋。",
      "调理：调养医治。"
     ]
    },
    {
     "译": [],
     "注": [
      "成色：金银的纯度。",
      "窝家：窝藏赃物的人，即窝主。",
      "讼案：官司。"
     ]
    },
    {
     "译": [],
     "注": [
      "街坊：邻居。",
      "宁妈妈：宁婆，热心的老妇人，在本回承担传信之责。",
      "衙役快头：衙门中的差役头目；快头即捕快班头。"
     ]
    },
    {
     "译": [],
     "注": [
      "过堂：被告或证人在公堂上受审。",
      "玉成：成全。",
      "瓜田李下：古乐府“瓜田不纳履，李下不正冠”，指易招嫌疑之处。",
      "怨女旷夫：指已到婚龄而无配偶的男女。",
      "翁婿：岳父与女婿。",
      "千里姻缘一线牵：俗语，言姻缘由缘分牵合，不论路远。"
     ]
    },
    {
     "译": [],
     "注": [
      "伏枕：伏卧枕上。",
      "方恩公：指方善，救三公子之恩人。",
      "名分攸关：与名分、礼法所系相关。"
     ]
    },
    {
     "译": [],
     "注": [
      "游疑：犹豫不决。",
      "女工针黹：女子的纺织刺绣缝补等手艺；黹音 zhǐ，指针线活。",
      "聘定：订婚的聘礼。",
      "如白染皂：白布染成黑色即不可更改，比喻言出必行。",
      "方夫子：对方善的敬称。",
      "知恩不报恩，枉为世上人：俗语。",
      "半子之劳：女婿能如半个儿子般尽力，常语。",
      "中门：官署正门之内的大门，非贵客不开，以示隆重。",
      "封套笺纸：信封与信纸。"
     ]
    },
    {
     "译": [],
     "注": [
      "冷酒：未温热的酒。",
      "羹汤：带汁的汤食。",
      "荤腥：肉食鱼腥。",
      "一挥而就：一气写成。"
     ]
    },
    {
     "译": [],
     "注": [
      "头巾：古时男子成年所戴的头巾，不戴头巾指妇女。",
      "舛错：差错。",
      "搭讪：为掩饰而随口找话、借故走开。",
      "奉相爷谕：奉包公之命。"
     ]
    },
    {
     "译": [],
     "注": [
      "绫罗缎匹：各种高档丝织品。",
      "拄腰子：贴身的内衣袋，待考。",
      "福了福：旧时妇女行礼，双手抱拳在身侧上下轻动，称“万福”。"
     ]
    },
    {
     "译": [],
     "注": [
      "班房：衙役值班的屋子。",
      "主儿：主顾，此指靠山或再嫁的对象，带调笑。",
      "老舅：对差役的敬称。",
      "面觌：当面相见；觌音 dí。",
      "乱儿：乱子，麻烦。",
      "拿手：把握，有凭据。"
     ]
    },
    {
     "译": [],
     "注": [
      "衙内：衙门里面，此指知县。",
      "书吏：衙门里掌文书的小吏。",
      "采头：彩头，好兆头与赏钱。"
     ]
    },
    {
     "译": [],
     "注": [
      "机变：灵活应变。",
      "花鞋：绣花鞋。",
      "公座：公堂上的座位。"
     ]
    },
    {
     "译": [],
     "注": [
      "贵县：对知县的尊称。",
      "专司：各自专管的事。"
     ]
    },
    {
     "译": [],
     "注": [
      "太爷：对知县的称呼。",
      "老婆儿：老妇人，口语。"
     ]
    },
    {
     "译": [],
     "注": [
      "下回分晓：章回小说回末套语。"
     ]
    }
   ]
  }
 ]
