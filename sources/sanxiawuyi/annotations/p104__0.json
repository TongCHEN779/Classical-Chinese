    },
    {
     "译": [],
     "注": [
      "生理：营生，谋生。",
      "渔猎：捕鱼打猎。",
      "评论市价：评定买卖的价钱。",
      "丁家兄弟：指丁兆兰、丁兆蕙兄弟，双侠，渔猎为生的豪杰。",
      "称羡：称赞羡慕。",
      "五鼓：五更，将天亮时。",
      "耽延：拖延。",
      "殷殷勤勤：殷勤周到。"
     ]
    },
    {
     "译": [],
     "注": [
      "信息：消息。",
      "毫无影响：毫无音信。",
      "犹疑：犹豫迟疑。"
     ]
    },
    {
     "译": [],
     "注": [
      "下回分解：章回小说回末套语。"
     ]
    }
