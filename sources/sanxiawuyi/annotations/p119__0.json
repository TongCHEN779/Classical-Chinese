 "items": [
  {
   "题解": "怀宝背钟麟投宿甘妈妈店，被艾虎与武伯南识破并在半路杀死，救回钟麟；钟雄酒醒发现已在陈起望，智化与众侠跪告实情、剖明大义，钟雄愧悔，诚心归顺，至此钟雄收伏。",
   "段落": [
    {
     "译": [],
     "注": [
      "甘妈妈：已故甘豹之妻，在神树岗开黑店。",
      "会意：领会暗示。",
      "柴扉：柴门。"
     ]
    },
    {
     "译": [],
     "注": [
      "娇生惯养：从小被宠爱，缺乏磨炼。",
      "荒郊旷野：荒僻的野外。",
      "吐大哇地：形容被缠得狼狈，北方口语，待考。",
      "嗔吓：生气吓唬。",
      "耽延：耽搁。"
     ]
    },
    {
     "译": [],
     "注": [
      "营生：行当，此含贬义，指坏勾当。",
      "揭去：偷走、拐走。",
      "安安顿顿：安分守己。",
      "犯疑：起疑心。"
     ]
    },
    {
     "译": [],
     "注": [
      "相公：对富家公子的称呼。",
      "张牙欠口：张口打哈欠。",
      "哈气：呵欠。",
      "铺垫：铺好被褥。",
      "骨软筋酥：疲乏无力。",
      "挺尸：骂人睡觉，戏谑语。",
      "倒扣：从外面把门锁上。"
     ]
    },
    {
     "译": [],
     "注": [
      "心如刀绞：心里像刀割一样疼。"
     ]
    },
    {
     "译": [],
     "注": [
      "那话儿：指事，意为正是所说之人。",
      "干兄弟：义兄弟，结拜兄弟。",
      "混帐行于：疑为“混帐行子”，指糊涂无赖的人；“于”疑为“子”之误；底本疑误。",
      "不干不净：指不正当男女关系。",
      "搭帮：结伙。",
      "贼船：喻坏人之伙。",
      "失于检点：疏忽，没有留心。",
      "躲一棒槌，挨一榔头：俗语，躲过一次又碰上另一次。",
      "把戏儿：花招。",
      "凑趣：说笑逗趣。",
      "杯著：杯箸，“著”同“箸”。"
     ]
    },
    {
     "译": [],
     "注": [
      "舛错：差错。",
      "无影响：没有消息。",
      "纳聘：男方送聘礼订婚。",
      "卢珍：卢方之侄，蒋平曾提出许婚。",
      "蒋四叔：蒋平。"
     ]
    },
    {
     "译": [],
     "注": [
      "邀截：中途拦截。",
      "沾污：弄脏，指在店中动手见血。",
      "杀人不眨眼：形容残忍。",
      "母老虎：凶悍的妇人。",
      "福了一福：妇女行万福礼。"
     ]
    },
    {
     "译": [],
     "注": [
      "赋人：疑为“贼人”之误；底本疑误。",
      "胆虚：做贼心虚。",
      "补报：日后补偿报答。",
      "要路：要道。",
      "抢锺麟：疑为“抢钟麟”，救下钟麟；“抢”意为夺回。"
     ]
    },
    {
     "译": [],
     "注": [
      "扬威：显示威风。",
      "咯噔：心里一惊的声音。",
      "冷战儿：打寒战。",
      "噗哧：拟声，摔倒声。",
      "了帐：死去。",
      "入鞘：把刀放回刀鞘。"
     ]
    },
    {
     "译": [],
     "注": [
      "五鼓鸡呜：“呜”疑为“鸣”之误，指五更天亮时。",
      "沙龙：卧虎沟庄主。",
      "展昭：南侠。",
      "丁兆蕙：茉花村“双侠”之一。",
      "卧榻：卧床。",
      "鸦雀无声：形容非常安静。",
      "口燥：口渴。",
      "蒙陇：恍惚迷糊，“朦胧”。",
      "一骨碌：迅速翻身起来。",
      "劣尼：疑为“劣兄”之误；底本疑误。",
      "草舍不堪驻足：自谦住处简陋。",
      "有屈大驾：委屈了您。",
      "渔家服色：渔民的衣服。"
     ]
    },
    {
     "译": [],
     "注": [
      "钦奉圣旨：恭敬遵奉皇命。",
      "谨遵相谕：恭敬遵照相爷（指包拯）的谕示。",
      "赵爵：襄阳王名字，小说亦作赵珏，待考。",
      "易如反掌：像翻手那样容易。",
      "玉石俱焚：好坏一起毁灭，语出《尚书·胤征》“火炎昆冈，玉石俱焚”。",
      "君父：国君与父亲，古代最重的伦理对象。",
      "人非圣贤，孰能无过：语本《左传·宣公二年》“人谁无过”，后成成语。",
      "匡扶社稷：扶持国家。",
      "屈膝：下跪。"
     ]
    },
    {
     "译": [],
     "注": [
      "英名贯耳：久闻英名。",
      "恃力欺人：仗着力量欺负人。",
      "义重如山：情义深重。",
      "藐视：轻视。",
      "洗心改悔：洗刷心中，改正过错。",
      "豪爽梗直：豪放爽快、正直。",
      "倾心向善：诚心归向善良。"
     ]
    },
