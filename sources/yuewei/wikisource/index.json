      "text": "序"
    },
    {
      "type": "h2",
      "text": "书一  滦阳消夏录"
    },
    {
      "type": "h2",
      "text": "书二  如是我闻"
    },
    {
      "type": "h2",
      "text": "书三  槐西杂志"
    },
    {
      "type": "h2",
      "text": "书四  姑妄听之"
    },
    {
      "type": "h2",
      "text": "书五  滦阳续录"
    },
