{
  "title": "肉蒲團/目錄",
  "url": "https://zh.wikisource.org/zh-hans/%E8%82%89%E8%92%B2%E5%9C%98/%E7%9B%AE%E9%8C%84",
  "resolved_url": "https://zh.wikisource.org/zh-hans/%E8%82%89%E8%92%B2%E5%9C%98/%E7%9B%AE%E9%8C%84",
  "revision": "2569057",
  "fetched_at": "2026-10-27T13:58:23.108942+00:00",
  "status": "source_cached_unreviewed",
  "extractor": "four-classics-v2",
  "display_title": "第一回",
  "blocks": [
    {
      "type": "p",
      "text": "肉蒲团一名觉后禅"
    },
    {
      "type": "p",
      "text": "目录"
    },
    {
      "type": "p",
      "text": "第一回"
    },
    {
      "type": "p",
      "text": "止淫风借淫事说法谈色事就色欲开端"
    },
    {
      "type": "p",
      "text": "第二回"
    },
    {
      "type": "p",
      "text": "老头陀空张皮布袋小居士受坐肉蒲团"
    },
    {
      "type": "p",
      "text": "第三回"
    },
    {
      "type": "p",
      "text": "道学翁错配风流婿端庄女移情轻薄郎"
    },
    {
      "type": "p",
      "text": "第四回"
    },
    {
      "type": "p",
      "text": "宿荒村客心悲寂寞消长夜贼口说风情"
    },
    {
      "type": "p",
      "text": "第五回"
    },
    {
      "type": "p",
      "text": "选丰姿严造花名册狗情面宽收雪鬓娘"
    },
    {
      "type": "p",
      "text": "第六回"
    },
    {
      "type": "p",
      "text": "稀短才漫夸长技现小物贻笑大方"
    },
    {
      "type": "p",
      "text": "第七回"
    },
    {
      "type": "p",
      "text": "怨生成抚阳痛哭思改正屈膝哀求"
    },
    {
      "type": "p",
      "text": "第八回"
    },
    {
      "type": "p",
      "text": "三月苦藏修良朋刮目一番乔卖弄美妇倾心"
    },
    {
      "type": "p",
      "text": "第九回"
    },
    {
      "type": "p",
      "text": "擅奇淫偏持大体分馀乐反占先筹"
    },
    {
      "type": "p",
      "text": "第十回"
    },
    {
      "type": "p",
      "text": "听先声而知劲敌留馀地以养真才"
    },
    {
      "type": "p",
      "text": "第十一回"
    },
    {
      "type": "p",
      "text": "穿窬豪杰浪挥金露水夫妻成结发"
    },
    {
      "type": "p",
      "text": "第十二回"
    },
    {
      "type": "p",
      "text": "补磕头方成好事因吃醋反结同心"
    },
    {
      "type": "p",
      "text": "第十三回"
    },
    {
      "type": "p",
      "text": "破釜焚舟除隐情卧薪尝胆复奸雠"
    },
    {
      "type": "p",
      "text": "第十四回"
    },
    {
      "type": "p",
      "text": "闭户说欢娱隔墙有耳禁人观沐浴此处无银"
    },
    {
      "type": "p",
      "text": "第十五回"
    },
    {
      "type": "p",
      "text": "同盟义议通宵乐姊妹平分一夜欢"
    },
    {
      "type": "p",
      "text": "第十六回"
    },
    {
      "type": "p",
      "text": "真好事半路遭魔活春宫连箱被劫"
    },
    {
      "type": "p",
      "text": "第十七回"
    },
    {
      "type": "p",
      "text": "得便宜因人瞒己遭涂毒为己骄人"
    },
    {
      "type": "p",
      "text": "第十八回"
    },
    {
      "type": "p",
      "text": "妻子落风尘明偿积欠  弟兄争窈窕暗索前逋"
    },
    {
      "type": "p",
      "text": "第十九回"
    },
    {
      "type": "p",
      "text": "孽贯已盈两处香闺齐出丑禅机将发诸般美色尽成空"
    },
    {
      "type": "p",
      "text": "第二十回"
    },
    {
      "type": "p",
      "text": "布袋皮宽色鬼奸雄齐摄入旃檀路阔冤家债主任相逢"
    }
  ],
  "text_sha256": "7d56c3c232f2e81cc14cceb7012fc86c6d0962c2637cef14e6464f738d5b8ae1"
}
