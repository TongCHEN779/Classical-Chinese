{
  "title": "前赤壁賦",
  "url": "https://zh.wikisource.org/zh-hans/%E5%89%8D%E8%B5%A4%E5%A3%81%E8%B3%A6",
  "resolved_url": "https://zh.wikisource.org/zh-hans/%E5%89%8D%E8%B5%A4%E5%A3%81%E8%B3%A6",
  "revision": "10247882",
  "fetched_at": "2026-10-29T18:08:14.731257+00:00",
