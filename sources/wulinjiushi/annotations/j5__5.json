 "items": [
  {
   "题解": "本节记孤山路及北山路沿湖一带的桥梁、园林、寺观与墓冢，由西陵桥、孤山起，经断桥、柳洲、昭庆寺，延至灵隐、石人岭，名目繁多，末尾以古柳林、钱塘县尉司收束。",
   "段落": [
    {
     "译": [
      "西陵桥（桥名）"
     ],
     "注": [
      "西陵桥：在孤山西侧，又作西泠桥"
     ]
    },
    {
     "译": [
      "又名“西林桥”，又名“西泠桥”，又名“西村”。"
     ],
     "注": []
    },
    {
     "译": [
      "孤山（山名）"
     ],
     "注": [
      "孤山：西湖中的小山，北宋林逋隐居于此"
     ]
    },
    {
     "译": [
      "旧时有柏堂、竹阁、四照阁、巢居阁、林处士的住所，现在都已不存在。"
     ],
     "注": [
      "林处士：林逋，北宋隐士，谥和靖"
     ]
    },
    {
     "译": [
      "四圣延祥观（道观名）"
     ],
     "注": [
      "四圣延祥观：南宋在孤山所建道观，祭祀天蓬、天猷、翊圣、真武四圣"
     ]
    },
    {
     "译": [
      "有韦太后（宋高宗生母）供奉的沉香四圣像、小蓬莱阁、瀛屿堂、金沙井、六一泉。",
      "其余见“御园”一类。"
     ],
     "注": [
      "韦太后：宋高宗生母韦氏",
      "六一泉：孤山下的泉，苏轼为纪念欧阳修（号六一居士）所名",
      "御园类：书中专记皇家园林的类目"
     ]
    },
    {
     "译": [
      "西太一宫（宫观名）"
     ],
     "注": [
      "西太一宫：南宋祭祀太一神的宫观，在西湖孤山"
     ]
    },
    {
     "译": [
      "旧时的四圣观园，理宗朝所建。",
      "现在的黄庭殿，就是过去的凉堂。",
      "两侧墙壁上萧照的画还留存着。",
      "亭馆的名称都见于“御园”一类。",
      "弁阳翁有诗说：“花蕊宫的大殿号称黄庭，高高耸立，在浮云之上。",
      "五福贵神留不住，水边的厅堂徒然映照着九枝灯。”",
      "有林和靖的墓、玛瑙坡、陈朝的柏树。"
     ],
     "注": [
      "黄庭殿：以道教经典《黄庭经》命名的殿",
      "萧照：南宋画家",
      "五福贵神：道教术数中的吉神，太一神所属",
      "九枝灯：有九根灯枝的灯，常用于祭祀",
      "和靖：林逋的谥号",
      "玛瑙坡：孤山的坡名"
     ]
    },
    {
