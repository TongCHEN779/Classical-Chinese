 "items": [
  {
   "题解": "本节开列乾道、淳熙年间（约1165—1189）教坊乐部各色名册，按杂剧、歌板、拍板及诸乐器分色，列出德寿宫、衙前、前教坊、前钧容直、和顾等各来源的艺人，并附杂剧三甲、筑球、杂班、小乐器、鼓板、马后乐及内中上教博士等名目，是研究南宋宫廷乐舞和戏剧人员的重要名单。",
   "段落": [
    {
     "译": [
      "杂剧色（演杂剧的班色）："
     ],
     "注": [
      "杂剧：宋代的戏剧形式，由副末、次净、引戏、戏头、装旦等角色合演。",
      "色：宋代教坊、御前的分工班组，如歌板色、琵琶色。"
     ]
    },
    {
     "译": [
      "德寿宫（太上皇宋高宗的住处，此处指在德寿宫当差的艺人）："
     ],
     "注": [
      "德寿宫：宋高宗退位后所居，在临安（今杭州）望仙桥一带；这里指隶属德寿宫的艺人。"
     ]
    },
    {
     "译": [
      "刘景长（使臣）；王喜（保义郎、头名都管使臣，又名公谨，号玩隐老人）"
     ],
     "注": [
      "使臣：宋代低级武职或差遣的泛称，教坊艺人多带此类官衔。",
      "保义郎：宋代武臣阶官，政和后用以代原“右班殿直”，为低级武阶。",
      "都管：教坊中管理一色人员的头目。"
     ]
    },
    {
     "译": [
      "茆山重（节牙头，○“节”字宋刻本作“茅”）；盖门贵；盖门庆（演末）"
     ],
     "注": [
      "茆山重：人名，茆同茅。",
      "节牙头：疑为杂剧中的角色或班头名；校语称宋刻本“节”作“茅”。",
      "末：杂剧角色“副末”，是插科打诨的主要角色之一。"
     ]
    },
    {
     "译": [
      "侯谅（侯大头，次末）；张顺；曹辛；宋兴（燕子头）"
     ],
     "注": [
      "次末：排在末色之后的演员。",
      "燕子头：艺人诨名或班头别称，意不详。"
     ]
    },
    {
     "译": [
      "李泉现（引戏，兼舞三台）"
     ],
     "注": [
      "引：引戏，杂剧中引导开场、指挥进退的角色。",
      "三台：唐宋舞曲名，原为酒令，后成舞蹈，此处指兼任三台舞者。"
     ]
    },
    {
     "译": [
      "衙前（在官衙应差的艺人）："
     ],
     "注": [
      "衙前：宋代教坊、府衙中的在籍乐人，称衙前乐人，与德寿宫、前教坊等并列为来源分类。"
     ]
    },
    {
     "译": [
      "龚士美（使臣、都管）；刘恩深（都管）；陈嘉祥（节级）"
     ],
     "注": [
      "节级：宋代对低级军吏、差役头目的称呼，此处为乐人中的小头目。"
     ]
    },
    {
     "译": [
      "吴兴祐（德寿宫的引戏，兼舞三台）；吴斌（宋刻本“斌”作“赋”）"
     ],
     "注": [
      "吴斌：宋刻作“赋”，字形与今不同，校语照录。"
     ]
    },
    {
     "译": [
      "金彦升（管干教头）；王青；孙子贵（引戏）"
     ],
     "注": [
      "管干教头：负责管理、教习乐人的头目；管干即主管、办理。"
     ]
    },
    {
