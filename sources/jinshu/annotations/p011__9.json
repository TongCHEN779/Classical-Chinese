{
 "start": 9,
 "items": [
  {
   "题解": "本节列举陈卓等诸家所说的州郡与二十八宿的对应，按九州分野逐郡记其入宿度数，是上节十二次分野的细目。",
   "段落": [
    {
     "译": [
      "陈卓、范蠡、鬼谷先生、张良、诸葛亮、谯周、京房、张衡都说："
     ],
     "注": [
      "陈卓：三国至西晋天文学家。",
      "范蠡：春秋末越国大夫，相传善天文。",
      "鬼谷先生：战国时纵横家，隐居鬼谷。",
      "谯周：蜀汉学者，通天文历算。",
      "京房：西汉易学家，长于灾异占候。",
      "张衡：东汉科学家，造浑天仪。"
     ]
    },
    {
     "译": [
      "角、亢、氐三宿，对应郑国，兖州："
     ],
     "注": [
      "兖州：古九州之一，在今山东西南、河南东部。"
     ]
    },
    {
     "译": [
      "东郡，进入角宿一度；",
      "东平、任城、山阳，进入角宿六度"
     ],
     "注": [
      "东郡：郡名，治今河南濮阳西南。"
     ]
    },
    {
     "译": [
      "泰山，进入角宿十二度；",
      "济北、陈留，进入亢宿五度"
     ],
     "注": []
    },
    {
     "译": [
      "济阴，进入氐宿二度；",
      "东平，进入氐宿七度"
     ],
     "注": [
      "东平：此处与上文东平重出，原文如此。"
     ]
    },
    {
     "译": [
      "房、心二宿，对应宋国，豫州："
     ],
     "注": [
      "豫州：古九州之一，在今河南一带。"
     ]
    },
    {
     "译": [
      "颍川，进入房宿一度；",
      "汝南，进入房宿二度"
     ],
     "注": []
    },
    {
     "译": [
      "沛郡，进入房宿四度；",
      "梁国，进入房宿五度"
     ],
     "注": []
    },
    {
     "译": [
      "淮阳，进入心宿一度；",
      "鲁国，进入心宿三度，"
     ],
     "注": [
      "鲁国：此处属豫州，与下文徐州分野鲁国不同，原文如此。"
     ]
    },
    {
     "译": [
      "楚国，进入房宿四度。"
     ],
     "注": [
      "楚国：汉诸侯国名，治彭城（今江苏徐州）。"
     ]
    },
    {
     "译": [
      "尾、箕二宿，对应燕国，幽州："
     ],
     "注": [
      "幽州：古九州之一，在今河北北部、辽宁一带。"
     ]
    },
    {
     "译": [
      "凉州，进入箕宿中十度，上谷，进入尾宿一度"
     ],
     "注": [
      "凉州：此处列于幽州分野之下，与通例不合，原文如此。",
      "上谷：郡名，治今河北怀来东南。"
     ]
    },
    {
     "译": [
      "渔阳，进入尾宿三度；",
      "右北平，进入尾宿七度"
     ],
     "注": [
      "渔阳：郡名，治今北京密云西南。",
      "右北平：郡名，治今河北、辽宁交界一带。"
     ]
    },
    {
     "译": [
      "西河、上郡、北地、辽西，向东进入尾宿十度；",
      "涿郡，进入尾宿十六度"
     ],
     "注": [
      "辽西：郡名，治今辽宁义县西。"
     ]
    },
    {
     "译": [
      "渤海，进入箕宿一度；",
      "乐浪，进入箕宿三度"
     ],
     "注": [
      "乐浪：郡名，汉武帝置，在今朝鲜半岛北部。"
     ]
    },
    {
     "译": [
      "玄菟，进入箕宿六度；",
      "广阳，进入箕宿九度。"
     ],
     "注": [
      "玄菟：郡名，汉武帝置，在今辽宁东部、朝鲜半岛北部。"
     ]
    },
    {
     "译": [
      "斗、牵牛、须女三宿，对应吴越，扬州："
     ],
     "注": [
      "扬州：古九州之一，在今江淮以南、东南沿海。"
     ]
    },
    {
     "译": [
      "九江，进入斗宿一度；",
      "庐江，进入斗宿六度。"
     ],
     "注": []
    },
    {
     "译": [
      "豫章，进入斗宿十度；",
      "丹阳，进入斗宿十六度。"
     ],
     "注": []
    },
    {
     "译": [
      "会稽，进入牛宿一度；",
      "临淮，进入牛宿四度。"
     ],
     "注": [
      "会稽：郡名，治今江苏苏州一带，后迁今浙江绍兴。"
     ]
    },
    {
     "译": [
      "广陵，进入牛宿八度；",
      "泗水，进入女宿一度。"
     ],
     "注": []
    },
    {
     "译": [
      "六安，进入女宿六度。"
     ],
     "注": []
    },
    {
     "译": [
      "虚、危二宿，对应齐国，青州："
     ],
     "注": [
      "青州：古九州之一，在今山东东部。"
     ]
    },
    {
     "译": [
      "齐国，进入虚宿六度；",
      "北海，进入虚宿九度。"
     ],
     "注": []
    },
    {
     "译": [
      "济南，进入危宿一度；",
      "乐安，进入危宿四度。"
     ],
     "注": []
    },
    {
     "译": [
      "东莱，进入危宿九度；",
      "平原，进入危宿十一度。"
     ],
     "注": []
    },
    {
     "译": [
      "菑川，进入危宿十四度。"
     ],
     "注": []
    },
    {
     "译": [
      "营室、东壁二宿，对应卫国，并州："
     ],
     "注": [
      "并州：古九州之一，在今山西一带。"
     ]
    },
    {
     "译": [
      "安定，进入营室一度；",
      "天水，进入营室八度。"
     ],
     "注": []
    },
    {
     "译": [
      "陇西，进入营室四度；",
      "酒泉，进入营室十一度。"
     ],
     "注": []
    },
    {
     "译": [
      "张掖，进入营室十二度；",
      "武都，进入东壁一度。"
     ],
     "注": []
    },
    {
     "译": [
      "金城，进入东壁四度；",
      "武威，进入东壁六度。"
     ],
     "注": []
    },
    {
     "译": [
      "敦煌，进入东壁八度。"
     ],
     "注": [
      "敦煌：郡名，在今甘肃西部。"
     ]
    },
    {
     "译": [
      "奎、娄、胃三宿，对应鲁国，徐州："
     ],
     "注": [
      "徐州：古九州之一，在今山东南部、江苏北部。"
     ]
    },
    {
     "译": [
      "东海，进入奎宿一度；",
      "琅邪，进入奎宿六度。"
     ],
     "注": []
    },
    {
     "译": [
      "高密，进入娄宿一度；",
      "城阳，进入娄宿九度。"
     ],
     "注": []
    },
    {
     "译": [
      "胶东，进入胃宿一度。"
     ],
     "注": []
    },
    {
     "译": [
      "昴、毕二宿，对应赵国、冀州："
     ],
     "注": [
      "冀州：古九州之一，在今河北、山西一带。原文“赵、冀州”顿号疑为逗号之误。"
     ]
    },
    {
     "译": [
      "魏郡，进入昴宿一度；",
      "钜鹿，进入昴宿三度。"
     ],
     "注": []
    },
    {
     "译": [
      "常山，进入昴宿五度；",
      "广平，进入昴宿七度。"
     ],
     "注": []
    },
    {
     "译": [
      "中山，进入昴宿一度；",
      "清河，进入昴宿九度。"
     ],
     "注": [
      "中山，入昴一度：与上文魏郡入昴一度度数相同，疑有误，原文如此。"
     ]
    },
    {
     "译": [
      "信都，进入毕宿三度；",
      "赵郡，进入毕宿八度。"
     ],
     "注": []
    },
    {
     "译": [
      "安平，进入毕宿四度；",
      "河间，进入毕宿十度。"
     ],
     "注": []
    },
    {
     "译": [
      "真定，进入毕宿十三度。"
     ],
     "注": []
    },
    {
     "译": [
      "觜、参二宿，对应魏国，益州："
     ],
     "注": [
      "益州：汉置十三刺史部之一，在今四川一带。"
     ]
    },
    {
     "译": [
      "广汉，进入觜宿一度；",
      "越巂，进入觜宿三度。"
     ],
     "注": [
      "越巂：郡名，在今四川西南。"
     ]
    },
    {
     "译": [
      "蜀郡，进入参宿一度；",
      "犍为，进入参宿三度。"
     ],
     "注": [
      "人参三度：“人”疑当作“入”。",
      "犍为：郡名，在今四川宜宾一带。"
     ]
    },
    {
     "译": [
      "牂柯，进入参宿五度；",
      "巴郡，进入参宿八度。"
     ],
     "注": [
      "牂柯：郡名，即牂牁，在今贵州一带。"
     ]
    },
    {
     "译": [
      "汉中，进入参宿九度；",
      "益州，进入参宿七度。"
     ],
     "注": []
    },
    {
     "译": [
      "东井、舆鬼二宿，对应秦国，雍州："
     ],
     "注": [
      "雍州：古九州之一，在今陕西、甘肃一带。"
     ]
    },
    {
     "译": [
      "云中，进入东井一度；",
      "定襄，进入东井八度。"
     ],
     "注": [
      "雲中：郡名，在今内蒙古托克托一带。"
     ]
    },
    {
     "译": [
      "雁门，进入东井十六度；",
      "代郡，进入东井二十八度。"
     ],
     "注": []
    },
    {
     "译": [
      "太原，进入东井二十九度；",
      "上党，进入舆鬼二度。"
     ],
     "注": []
    },
    {
     "译": [
      "柳、七星、张三宿，对应周，三辅："
     ],
     "注": [
      "三辅：汉代京畿地区京兆尹、左冯翊、右扶风的合称。此处与前文“三河”不同，原文如此。"
     ]
    },
    {
     "译": [
      "弘农，进入柳宿一度；",
      "河南，进入七星宿三度。"
     ],
     "注": []
    },
    {
     "译": [
      "河东，进入张宿一度；",
      "河内，进入张宿九度。"
     ],
     "注": []
    },
    {
     "译": [
      "翼、轸二宿，对应楚国。",
      "荆州："
     ],
     "注": [
      "荆州：古九州之一，在今湖北、湖南一带。"
     ]
    },
    {
     "译": [
      "南阳，进入翼宿六度；",
      "南郡，进入翼宿十度。"
     ],
     "注": []
    },
    {
     "译": [
      "江夏，进入翼宿十二度；",
      "零陵，进入轸宿十一度。"
     ],
     "注": []
    },
    {
     "译": [
      "桂阳，进入轸宿六度；",
      "武陵，进入轸宿十度。"
     ],
     "注": []
    },
    {
     "译": [
      "长沙，进入轸宿十六度。"
     ],
     "注": []
    }
   ]
  }
 ]
}