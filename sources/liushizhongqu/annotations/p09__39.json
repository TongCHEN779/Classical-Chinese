{
 "start": 39,
 "items": [
  {
   "题解": "本出写十八年后赵朔、灵辄扮道人在阴陵遇屠程（赵武）打猎，被其放过；程婴见面说明真相，三人入阴陵见公主，各述别后情由，约定当夜到程婴家相见。生、末、丑、旦轮唱，是全家重聚的关键，推动复仇。",
   "段落": [
    {
     "译": [],
     "注": [
      "窣地锦裆：曲牌名，用作引子。",
      "丑：脚色名，此扮灵辄。",
      "兀的：这，指示词，元明曲语。",
      "俏没：同“悄没”，没有。"
     ]
    },
    {
     "译": [],
     "注": [
      "前腔：同上曲曲调，另填新词。",
      "凤旄：以凤羽饰旗杆之旗，指军仪旌旗。",
      "襄王古墓坟：指晋襄公之墓，剧中阴陵为其陵寝。",
      "权时：暂时。"
     ]
    },
    {
     "译": [],
     "注": [
      "双劝酒：曲牌名。",
      "小生：脚色名，此扮屠程，即赵孤儿。",
      "鹘：猛禽，俗称鹘鹰，旧时猎手用以捕兔。",
      "音耗：音信、消息。"
     ]
    },
    {
     "译": [],
     "注": [
      "小校：低级军官。",
      "二犬二鹘：两条猎犬、两只鹘鹰。"
     ]
    },
    {
     "译": [],
     "注": [
      "双㶉𪄠：曲牌名，字形特异，写法待考。",
      "焦燥：同“焦躁”。",
      "触犯：冒犯。"
     ]
    },
    {
     "译": [],
     "注": [
      "皇天可表：上天可以作证。",
      "委的：确实。",
      "掤扒吊拷：旧时严刑，常作“掤扒吊拷”。",
      "擒住住牢扯住牢：形容被紧紧拿住。",
      "劝好：劝解说和。"
     ]
    },
    {
     "译": [],
     "注": [
      "自不整衣毛：待考，疑为谚语，意谓自己不整仪容。",
      "嚎：叫，此疑指夜间鸣叫。",
      "孩儿：此处屠程自称。",
      "拱听：恭敬地听。",
      "一齐分付与东风：化用成语“付与东风”，随风而逝。",
      "情到不堪回首处：感慨之语，类似诗句，出处待考。",
      "吃了亏：此处指遭到呵斥受惊。"
     ]
    },
    {
     "译": [],
     "注": [
      "川拨棹：曲牌名，南曲。",
      "故阻佯羞：故意避开、假装羞愧。",
      "不侧声：不吭声。",
      "恁：你。"
     ]
    },
    {
     "译": [],
     "注": [
      "哭相思：曲牌名。",
      "桑间相会：指赵朔与灵辄当年在翳桑相会，事见《左传·宣公二年》。",
      "〔合〕：合唱。"
     ]
    },
    {
     "译": [],
     "注": [
      "灵辄哥：对灵辄的称呼。",
      "欺心：昧良心。",
      "恩主：对有恩于己的主人的称呼。",
      "忘恩负义贼：骂人语。",
      "乌珠：眼珠。",
      "倾杯哑妇：待考。",
      "休鞭为主耕牛：待考，意谓不要责怪辛劳的下人。",
      "分剖：分辩，剖白。",
      "恩东：即东主，对主人的称呼。",
      "遭戮：被杀。",
      "两泪盈眸：两眼含泪。"
     ]
    },
    {
     "译": [],
     "注": [
      "忆多娇：曲牌名，南曲。",
      "电掣：如电光闪过，喻迅速。",
      "永诀：永别。",
      "盈盈：充满。"
     ]
    },
    {
     "译": [],
     "注": [
      "前腔：同上曲曲调。",
      "泪撇：撇泪，拭泪。",
      "禁阙：宫禁。",
      "韩厥：晋国将领，此剧中为屠岸贾手下，自刎放孤。"
     ]
    },
    {
     "译": [],
     "注": [
      "春来：公主的侍女之名。",
      "先君坟墓：指晋襄公陵，称“阴陵”。",
      "〔内应介末〕：“内应”为幕后应声；“末”为程婴。",
      "屠爷传示：屠岸贾的传令。",
      "乡亲：同乡之人。"
     ]
    },
    {
     "译": [],
     "注": [
      "青玉案：曲牌名。",
      "旦：脚色名，此扮公主。",
      "儿夫：丈夫。",
      "鹊声噪：喜鹊鸣叫，古人以为将有喜讯。",
      "啰唣：吵闹，惊扰。"
     ]
    },
    {
     "译": [],
     "注": [
      "晋襄公：晋文公之子，晋灵公之父，名欢。",
      "晋灵公之嫡女：此剧称公主为灵公之女，史实上庄姬为晋成公之女，系戏剧改编。",
      "当今晋侯之妹：指晋景公之妹。",
      "擅击宫门：擅自击打宫门。",
      "周坚：《八义记》中替赵朔受死的家臣。",
      "草泽医人：民间医生。",
      "居方：赵朔字居方，此处用作名字称呼。",
      "调弄：戏弄。"
     ]
    },
    {
     "译": [],
     "注": [
      "临江仙：曲牌名。",
      "分飞：分别。",
      "〔合〕：合唱。"
     ]
    },
    {
     "译": [],
     "注": [
      "翳桑：晋地名，赵盾曾于此饭灵辄，见《左传·宣公二年》。",
      "殡葬：停柩安葬。",
      "生受：辛苦，劳烦。",
      "消停：安静，稍歇。",
      "咨启：陈述，禀告。",
      "神獒：屠岸贾所养的恶犬，传说能识奸忠，事见《左传·宣公二年》晋灵公使獒扑赵盾。",
      "因依：缘由。",
      "魄散魂飞：形容极度惊慌。",
      "偶辏：同“偶凑”，碰巧。",
      "打围：打猎。",
      "寄在太平庄上：指把惊哥送到公孙杵臼庄上。",
      "傍人：旁人。"
     ]
    },
    {
     "译": [],
     "注": [
      "大环着：曲牌名，南曲。",
      "结草衔环：典出《左传·宣公十五年》魏颗结草，及《续齐谐记》杨宝救黄雀，雀衔白环报恩，喻感恩图报。",
      "元因：原因。",
      "前定：命中前定。"
     ]
    },
    {
     "译": [],
     "注": [
      "暗藏孤儿出离宫门：程婴扮医人带孤儿出宫之事。",
      "奸雄：指屠岸贾。"
     ]
    },
    {
     "译": [],
     "注": [
      "越恁好：曲牌名，南曲。",
      "老景：晚景。",
      "鸳枕：鸳鸯枕，指夫妇团聚。"
     ]
    },
    {
     "译": [],
     "注": [
      "晚些：稍后。",
      "厮见：相见。",
      "恁：你。"
     ]
    },
    {
     "译": [],
     "注": [
      "尾声：套曲收尾曲。",
      "忠信：忠实诚信。"
     ]
    },
    {
     "译": [],
     "注": [
      "潭潭：深邃貌。",
      "手卷：横幅长卷，指画卷，下一出程婴以画向孤儿讲述。",
      "蓦地：忽然，悄悄地。",
      "小恩主：对孤儿的敬称。"
     ]
    },
    {
     "译": [],
     "注": [
      "菱花：镜子，铜镜背面多作菱花形，此用“破镜重圆”典。",
      "一轮明月再团圆：呼应第三十二出的“中秋月”。"
     ]
    }
   ]
  }
 ]
}