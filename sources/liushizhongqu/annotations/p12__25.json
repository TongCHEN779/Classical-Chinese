{
 "start": 25,
 "items": [
  {
   "题解": "第二十六出“皇华悲遇”：王夫人与蒋瑞莲在孟津驿借宿，夜中思亲悲泣，惊动投宿的王尚书与瑞兰，一家母女夫妻意外团聚；瑞兰因世隆之事心有隐痛，是全剧一个团聚的小结。",
   "段落": [
    {
     "译": [],
     "注": [
      "上马踢：曲牌名，南曲。",
      "老旦：传奇脚色名，扮老年妇女，此处扮王夫人。",
      "车驾迁都汴：车驾指皇帝；汴即汴梁，金宣宗于1214年迁都于此（称南京）。",
      "祸不单行：俗语，灾祸接连而来。",
      "中路儿不见：半路上同女儿失散。"
     ]
    },
    {
     "译": [],
     "注": [
      "月儿高：曲牌名，南曲。",
      "小旦：传奇脚色名，扮年轻女子，此处扮蒋世隆之妹瑞莲。",
      "人离乡贱：俗语“人离乡贱，物离乡贵”。",
      "迍邅：困顿艰难。",
      "狼狈：窘迫难堪。"
     ]
    },
    {
     "译": [],
     "注": [
      "銮江令：曲牌名，宫调待考。",
      "合：合唱。",
      "五甲复十里：疑当作“五里复十里”，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "狼草生：曲牌名，待考。",
      "四合：四面合拢。",
      "彤云：浓厚的红云，多指下雪前的阴云。",
      "去心如箭：形容急于赶路。"
     ]
    },
    {
     "译": [],
     "注": [
      "馆驿：官办的驿站。",
      "权宿：暂宿。"
     ]
    },
    {
     "译": [],
     "注": [
      "末上：末扮驿丞出场。",
      "孟津驿：黄河南岸的驿站，剧中虚设地点。",
      "周全：关照，成全。"
     ]
    },
    {
     "译": [],
     "注": [
      "传舍：旧时供行旅住宿的驿舍。",
      "英雄：对对方的客气称呼。"
     ]
    },
    {
     "译": [],
     "注": [
      "罗带儿：曲牌名，南曲。",
      "侵边犯阙：侵犯边境，进逼京城。",
      "中都：金朝的首都，在今北京。",
      "惨可可：凄惨的样子。",
      "生受：受苦，辛苦。",
      "子母每：母女们；“每”同“们”。",
      "天翻地覆：喻变故巨大。"
     ]
    },
    {
     "译": [],
     "注": [
      "邮亭：驿站亭舍。",
      "南京：指金迁都后的汴梁（南京）。",
      "远涉涉：形容路远，字或有误，待考。",
      "导少留停：“导”疑当作“道”，句意待考。",
      "皇华驻节：皇华指奉命出使的官员，语出《诗经·小雅·皇皇者华》；驻节指官员暂驻。"
     ]
    },
    {
     "译": [],
     "注": [
      "恓惶：凄惶可怜。",
      "与人方便，自己方便：俗语。",
      "已下人家：下等人家。",
      "不当稳便：不妥当，不便利。",
      "静悄悄地留一夜来早散：悄悄收留一夜，明早即散。"
     ]
    },
    {
     "译": [],
     "注": [
      "（未）：“未”疑当作“末”，照录。",
      "荐和席：荐是草垫，席是竹席或草席。",
      "冻款款地弯跧水：疑有误，待考。",
      "坐地科：科是戏曲动作提示；指坐在地上。"
     ]
    },
    {
     "译": [],
     "注": [
      "灞陵桥：曲牌名；灞陵桥在长安，为唐人送别之处。",
      "碾车儿：指跟随的行李车。",
      "带水：指黄河，即一衣带水。",
      "孟津驿：黄河南岸的驿站，剧中虚设。"
     ]
    },
    {
     "译": [],
     "注": [
      "簪簪：疑有误，待考。",
      "叠得：疑当作“迭得”，赶得及的意思。",
      "彤云密：阴云浓密。"
     ]
    },
    {
     "译": [],
     "注": [
      "著边际：有着落。",
      "鸳鸯分开：喻夫妻被拆散。"
     ]
    },
    {
     "译": [],
     "注": [
      "驿丞：掌管驿站的小官。",
      "鞍马辛苦：旅途劳累。",
      "毋许：不许。"
     ]
    },
    {
     "译": [],
     "注": [
      "新水令：曲牌名，南曲。",
      "逆旅：旅店。",
      "千早：句意待考，疑有误。",
      "萦牵：牵挂缠绕。"
     ]
    },
    {
     "译": [],
     "注": [
      "关山：关隘山川，指路途遥远。",
      "兵火：战火。",
      "凤拆凰：喻夫妻被拆散。",
      "猿闻也断肠：用《世说新语·黜免》猿子断肠之事，喻悲伤至极。"
     ]
    },
    {
     "译": [],
     "注": [
      "销金帐：曲牌名，南曲。",
      "羊羔美酒，美酒销金帐里：用宋党进“销金帐下，浅斟低唱，饮羊羔儿酒”之事，形容富贵享乐。",
      "街头上睡：指露宿回廊。"
     ]
    },
    {
     "译": [],
     "注": [
      "谯楼：城门上的望楼，用来击鼓报更。",
      "寒角：寒夜的号角。",
      "孤凤只：孤单的凤凰，喻失偶。",
      "磨折：折磨，磨难。",
      "存济：生存。"
     ]
    },
    {
     "译": [],
     "注": [
      "冬冬：鼓声。",
      "则叶敲窗纸：只有落叶敲打窗纸。",
      "岑寂：寂静冷清。",
      "依倚：依靠。"
     ]
    },
    {
     "译": [],
     "注": [
      "夜阑：夜深。",
      "萦闷紧：被烦闷紧紧缠绕。"
     ]
    },
    {
     "译": [],
     "注": [
      "三更漏转：漏即漏刻，三更漏转指时间到了三更。",
      "嘹呖：声音清亮，指雁声。",
      "灯火煤：灯芯燃尽的灰烬。",
      "沈疾：重病。",
      "冷落空房，药食准调理：空房冷落，药和饮食谁来调理。"
     ]
    },
    {
     "译": [],
     "注": [
      "檐铃：檐下的铃铎。",
      "飒然：突然。"
     ]
    },
    {
     "译": [],
     "注": [
      "疏钟：稀疏的钟声。",
      "茍活：苟且偷生。"
     ]
    },
    {
     "译": [],
     "注": [
      "铺陈：床铺被褥。",
      "皇华驻节的所在：指官员所住的驿馆。",
      "达时务：懂事，识时务。",
      "回话：向上司回复禀告。",
      "尚书老爷：指王尚书。"
     ]
    },
    {
     "译": [],
     "注": [
      "思园春：曲牌名，宫调待考。",
      "尊颜：对对方容貌的敬称。",
      "厮认：相认；此处指王夫人在途中同瑞莲互认为母女。",
      "强来亲：勉强来攀亲。"
     ]
    },
    {
     "译": [],
     "注": [
      "粉孩儿：曲牌名，南曲。",
      "国难识大臣：疑当作“国乱识忠臣”，照录。",
      "龙斗鱼损：喻权贵相争，百姓遭殃，类似“龙争虎斗，鱼虾遭殃”。"
     ]
    },
    {
     "译": [],
     "注": [
      "福马郎：曲牌名，南曲。",
      "林榔：指林中，“榔”字疑有误，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "红芍药：曲牌名，南曲。",
      "扰攘：纷乱。",
      "关津：关口渡口。",
      "役梦劳魂：魂牵梦绕。",
      "危闲：疑当作“危险”，待考。",
      "厮认：相认。"
     ]
    },
    {
     "译": [],
     "注": [
      "红衫儿：曲牌名，宫调待考。",
      "招商店：指前出蒋世隆与王瑞兰曾住的客店。",
      "蓦忽地：忽然。",
      "家尊：对人称自己的父亲。",
      "眼具体盻盻：疑有误，待考。"
     ]
    },
    {
     "译": [],
     "注": [
      "会河阳：曲牌名，南曲。",
      "争差：争执差错。",
      "旺息怒嗔：“旺”疑当作“且”或“莫”，句意为息怒。",
      "陈：陈述。"
     ]
    },
    {
     "译": [],
     "注": [
      "缕缕金：曲牌名，南曲。",
      "芳樽：美酒。",
      "团网：疑当作“团圆”，照录。",
      "南京：指汴梁（金南京）。",
      "佳宾：贵客，指女婿等。"
     ]
    },
    {
     "译": [],
     "注": [
      "催趱：催促赶办。"
     ]
    },
    {
     "译": [],
     "注": [
      "越恁好：曲牌名，南曲。",
      "办集：筹备聚集。",
      "指日：不久之后。"
     ]
    },
    {
     "译": [],
     "注": [
      "心儿里痛切切如刀刎：心里痛得像用刀割。",
      "眼儿里泪滴滴如珠揾：眼里泪珠连连，揾是擦拭。"
     ]
    },
    {
     "译": [],
     "注": [
      "红绣鞋：曲牌名，南曲。",
      "画船：装饰华美的船。",
      "汴梁城：金迁都后的南京。"
     ]
    },
    {
     "译": [],
     "注": [
      "尾声：套曲的最末一支。",
      "自忖：自己思量。"
     ]
    },
    {
     "译": [],
     "注": [
      "三旦：指旦、老旦、小旦三位女角。",
      "今宵胜把银缸照，犹恐相逢是梦中：晏几道《鹧鸪天》“今宵剩把银釭照，犹恐相逢是梦中”的化用，写久别重逢的惊疑。"
     ]
    }
   ]
  },
  {
   "题解": "第二十七出“逆旅萧条”：蒋世隆与妻被拆散后，独自在旅店养病，回想夫妻离散，悲痛欲绝；本出以他一人的独唱，写由喜转悲的低谷，承前出而启下出。",
   "段落": [
    {
     "译": [],
     "注": [
      "步蟾宫：曲牌名，南曲。",
      "龙潭虎穴：喻险恶之地。",
      "羁旅：寄居在外。",
      "凄楚：凄凉悲苦。"
     ]
    },
    {
     "译": [],
     "注": [
      "眼儿媚：词牌名，此处作引子。",
      "雁行中断：雁行指兄弟，此指兄妹失散。",
      "鸾俦生拆：鸾俦是夫妻，被硬生生拆散。",
      "缗：成串的铜钱。",
      "福无双至，祸不单行：俗语，参《说苑·权谋》“福不重至，祸必重来”。",
      "争奈：怎奈。"
     ]
    },
    {
     "译": [],
     "注": [
      "五样锦：曲牌名，宫调待考。",
      "五百年眷属：民间说夫妻姻缘是五百年前注定的。",
      "否极生泰：《周易》否卦、泰卦相反相成，指坏运到尽转为好运。",
      "并根连枝树：喻夫妻同根同枝。",
      "一回价：一回；“价”是语助词。",
      "将息：调养。",
      "暮雨朝云：用宋玉《高唐赋》巫山神女“旦为朝云，暮为行雨”事，指男女欢会。",
      "春蚕到老丝方尽，蜡烛成灰泪始干：唐李商隐《无题》句。"
     ]
    }
   ]
  }
 ]
}