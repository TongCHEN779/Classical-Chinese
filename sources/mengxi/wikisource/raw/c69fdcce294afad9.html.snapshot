					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="zh-Hans" dir="ltr"><style data-mw-deduplicate="TemplateStyles:r2372785">@media all and (max-width:720px){body.skin-minerva .mw-parser-output table.header{display:table!important}}</style>
<table class="ws-header" cellpadding="0" cellspacing="0" style="width:100%; margin-bottom:0px; border:1px solid var(--border-color-content-added,#93A6C0); background-color: var(--background-color-neutral-subtle,#F9F9F9); color: inherit;text-align:center;">
<tbody><tr>
<td width="25%" align="left"><span style="display:inline-block; inline-size:1em;"></span><a href="/wiki/%E5%A4%A2%E6%BA%AA%E7%AD%86%E8%AB%87/%E5%8D%B717" title="梦溪笔谈/卷17">卷十七</a> <span style="color:#999"> ◄ </span>
</td>
<td width="50%" align="center"><b><a href="/wiki/%E5%A4%A2%E6%BA%AA%E7%AD%86%E8%AB%87" title="梦溪笔谈">梦溪笔谈</a></b><br />卷十八 技艺
</td>
<td width="25%" align="right"><span style="color:#999"> ► </span> <a href="/wiki/%E5%A4%A2%E6%BA%AA%E7%AD%86%E8%AB%87/%E5%8D%B719" title="梦溪笔谈/卷19">卷十九</a><span style="display:inline-block; inline-size:1em;"></span>
</td></tr></tbody></table>
<table style="width:100%; background:var(--background-color-progressive-subtle,#F8FCFF); color: inherit;font-size:small; border-bottom:1px solid var(--border-color-content-added,#93A6C0)" class="ws-header">

<tbody><tr>
<td><span style="color: #464646;"><ul id="plainSister" style="display:inline-block; font-size:93%; line-height:normal; list-style-type:none; list-style-image:none; list-style-position:outside; border:1px solid var(--border-color-base,#AAA); float:right; clear:right; margin:0.5ex 0.5ex 0.5ex 0.5ex; padding:0.0ex 0.0ex 0.0ex 0.0ex; background-color:var(--background-color-base,#FFFFFF);color: inherit;"><li class="noprint sisitem"><span class="sisicon" style="padding-right:1ex;"><span typeof="mw:File/Frameless"><a href="/wiki/Special:SiteMatrix" title="Special:SiteMatrix"><img alt="姊妹计划" src="//thumb.wikimedia.org/wikipedia/commons/thumb/8/81/Wikimedia-logo.svg/20px-Wikimedia-logo.svg.png?utm_source=zh.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" width="18" height="18" class="mw-file-element" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/8/81/Wikimedia-logo.svg/40px-Wikimedia-logo.svg.png?utm_source=zh.wikisource.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="1024" data-file-height="1024" /></a></span></span><a href="/wiki/Special:SiteMatrix" title="Special:SiteMatrix">姊妹计划</a>: <a href="https://www.wikidata.org/wiki/Q85364064" class="extiw" title="d:Q85364064">数据项</a></li></ul></span>
<table style="font-size:0.9em; text-align:left; background:var(--background-color-neutral-subtle,#F9F9F9); float:right;color: inherit;">
