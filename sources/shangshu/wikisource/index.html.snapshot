<div class="mw-heading mw-heading2"><h2 id="商書"><span id=".E5.95.86.E6.9B.B8"></span>商书</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=%E5%B0%9A%E6%9B%B8&amp;action=edit&amp;section=3" title="编辑章节：商书"><span>编辑</span></a><span class="mw-editsection-bracket">]</span></span></div>
